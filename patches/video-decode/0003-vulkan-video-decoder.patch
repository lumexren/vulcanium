+// Synchronizes VideoFrame backing cleanup and pooled slot recycling with both
+// GPU scheduler SyncTokens and actual hardware GPU fence completion across
+// GaneshVulkan, GraphiteDawnVulkan, and ANGLE Vulkan WebGL/Canvas contexts.
+class GpuSlotSync : public base::RefCountedDeleteOnSequence<GpuSlotSync> {
+ public:
+  static scoped_refptr<GpuSlotSync> Create(
+      scoped_refptr<base::SingleThreadTaskRunner> gpu_task_runner,
+      VulkanVideoDecoder::GetCommandBufferStubCB get_stub_cb) {
+    if (!gpu_task_runner || !get_stub_cb) {
+      return nullptr;
+    }
+    auto sync = base::MakeRefCounted<GpuSlotSync>(std::move(gpu_task_runner),
+                                                  std::move(get_stub_cb));
+    sync->gpu_task_runner_->PostTask(
+        FROM_HERE, base::BindOnce(&GpuSlotSync::EnsureInitializedOnGpuThread,
+                                  base::RetainedRef(sync)));
+    return sync;
+  }
+
+  GpuSlotSync(scoped_refptr<base::SingleThreadTaskRunner> gpu_task_runner,
+              VulkanVideoDecoder::GetCommandBufferStubCB get_stub_cb)
+      : base::RefCountedDeleteOnSequence<GpuSlotSync>(gpu_task_runner),
+        gpu_task_runner_(std::move(gpu_task_runner)),
+        get_stub_cb_(std::move(get_stub_cb)) {}
+
+  void RunAfterGpuWork(std::vector<gpu::SyncToken> sync_tokens,
+                       base::OnceClosure done_cb) {
+    if (!done_cb) {
+      return;
+    }
+    if (!gpu_task_runner_) {
+      std::move(done_cb).Run();
+      return;
+    }
+    gpu_task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&GpuSlotSync::RunAfterGpuWorkOnGpuThread,
+                       scoped_refptr<GpuSlotSync>(this), std::move(sync_tokens),
+                       std::move(done_cb)));
+  }
+
+ private:
+  friend class base::DeleteHelper<GpuSlotSync>;
+  friend class base::RefCountedDeleteOnSequence<GpuSlotSync>;
+
+  struct AnglePendingFence {
+    VkFence fence = VK_NULL_HANDLE;
+    base::OnceClosure done_cb;
+  };
+
+  ~GpuSlotSync() {
+    fence_poll_timer_.Stop();
+    for (auto& entry : pending_angle_fences_) {
+      DestroyAngleVkFence(angle_vk_device_, pfn_angle_destroy_fence_,
+                          entry.fence);
+    }
+    pending_angle_fences_.clear();
+  }
+
+  void EnsureInitializedOnGpuThread() {
+    if (initialized_) {
+      return;
+    }
+    initialized_ = true;
+    gpu::CommandBufferStub* stub =
+        get_stub_cb_ ? get_stub_cb_.Run() : nullptr;
+    get_stub_cb_.Reset();
+    if (!stub || !stub->channel()) {
+      return;
+    }
+    cb_helper_ = CommandBufferHelper::Create(stub);
+    if (auto* mgr = stub->channel()->gpu_channel_manager()) {
+      gpu::ContextResult result = gpu::ContextResult::kTransientFailure;
+      auto shared_context = mgr->GetSharedContextState(&result);
+      if (result == gpu::ContextResult::kSuccess && shared_context) {
+        context_state_ = shared_context->GetWeakPtr();
+      }
+    }
+    const bool using_shared_skia_vk =
+        context_state_ && context_state_->GrContextIsVulkan() &&
+        context_state_->vk_context_provider() != nullptr;
+    if (!using_shared_skia_vk) {
+      angle_vk_ready_ = ResolveAngleVkFenceProcs(
+          &angle_vk_device_, &angle_vk_queue_, &angle_display_,
+          &pfn_angle_create_fence_, &pfn_angle_queue_submit_,
+          &pfn_angle_get_fence_status_, &pfn_angle_destroy_fence_);
+    }
+    static bool logged_sync = false;
+    if (!logged_sync) {
+      logged_sync = true;
+      VLOG(1) << "VulkanVideoDecoder: GPU fence slot sync active (vk="
+              << using_shared_skia_vk
+              << ", graphite="
+              << (context_state_ && context_state_->IsGraphiteDawn())
+              << ", angle_vk=" << angle_vk_ready_ << ")";
+    }
+  }
+
+  void RunAfterGpuWorkOnGpuThread(std::vector<gpu::SyncToken> sync_tokens,
+                                  base::OnceClosure done_cb) {
+    scoped_refptr<GpuSlotSync> keep_alive(this);
+    EnsureInitializedOnGpuThread();
+    std::vector<gpu::SyncToken> valid_tokens;
+    valid_tokens.reserve(sync_tokens.size());
+    for (const auto& token : sync_tokens) {
+      if (token.HasData()) {
+        valid_tokens.push_back(token);
+      }
+    }
+    if (!valid_tokens.empty() && cb_helper_ &&
+        cb_helper_->GetSharedImageStub()) {
+      struct FallbackToFence {
+        FallbackToFence(scoped_refptr<GpuSlotSync> sync_in,
+                        base::OnceClosure cb_in)
+            : sync(std::move(sync_in)), cb(std::move(cb_in)) {}
+        ~FallbackToFence() {
+          if (!cb) {
+            return;
+          }
+          if (sync && sync->gpu_task_runner_) {
+            sync->gpu_task_runner_->PostTask(
+                FROM_HERE,
+                base::BindOnce(&GpuSlotSync::WaitForHardwareFenceOnGpuThread,
+                               sync, std::move(cb)));
+            return;
+          }
+          std::move(cb).Run();
+        }
+        scoped_refptr<GpuSlotSync> sync;
+        base::OnceClosure cb;
+      };
+      auto fallback = std::make_unique<FallbackToFence>(
+          scoped_refptr<GpuSlotSync>(this), std::move(done_cb));
+      cb_helper_->WaitForSyncTokens(
+          std::move(valid_tokens),
+          base::BindOnce(
+              [](scoped_refptr<GpuSlotSync> sync,
+                 std::unique_ptr<FallbackToFence> fb) {
+                base::OnceClosure cb =
+                    fb ? std::move(fb->cb) : base::OnceClosure();
+                if (cb) {
+                  sync->WaitForHardwareFenceOnGpuThread(std::move(cb));
+                }
+              },
+              scoped_refptr<GpuSlotSync>(this), std::move(fallback)));
+      return;
+    }
+    WaitForHardwareFenceOnGpuThread(std::move(done_cb));
+  }
+
+  void WaitForAngleFenceOnGpuThread(base::OnceClosure done_cb) {
+    scoped_refptr<GpuSlotSync> keep_alive(this);
+    if (!done_cb) {
+      return;
+    }
+    if (angle_vk_ready_ && (!context_state_ || !context_state_->context_lost())) {
+      VkFence fence = SubmitAngleVkFence(
+          angle_vk_device_, angle_vk_queue_, angle_display_,
+          pfn_angle_create_fence_, pfn_angle_queue_submit_,
+          pfn_angle_destroy_fence_);
+      if (fence != VK_NULL_HANDLE) {
+        pending_angle_fences_.push_back(
+            AnglePendingFence{fence, std::move(done_cb)});
+        ScheduleFencePollOnGpuThread();
+        return;
+      }
+    }
+    std::move(done_cb).Run();
+  }
+
+  void WaitForHardwareFenceOnGpuThread(base::OnceClosure done_cb) {
+    scoped_refptr<GpuSlotSync> keep_alive(this);
+    if (!done_cb) {
+      return;
+    }
+    if (context_state_ && !context_state_->context_lost() &&
+        context_state_->GrContextIsVulkan() &&
+        context_state_->vk_context_provider()) {
+      auto* vk_queue = context_state_->vk_context_provider()->GetDeviceQueue();
+      auto* fence_helper = vk_queue ? vk_queue->GetFenceHelper() : nullptr;
+      if (!fence_helper) {
+        std::move(done_cb).Run();
+        return;
+      }
+      if (auto* gr = context_state_->gr_context(); gr && !gr->abandoned()) {
+        gr->flushAndSubmit(GrSyncCpu::kNo);
+      }
+      fence_helper->EnqueueCleanupTaskForSubmittedWork(base::BindOnce(
+          [](base::OnceClosure cb, gpu::VulkanDeviceQueue*, bool) {
+            if (cb) {
+              std::move(cb).Run();
+            }
+          },
+          std::move(done_cb)));
+      auto handle = fence_helper->GenerateCleanupFence();
+      if (handle.is_valid()) {
+        pending_vk_fences_.push_back(handle);
+        ScheduleFencePollOnGpuThread();
+      }
+      return;
+    }
+
+    if (context_state_ && !context_state_->context_lost() &&
+        context_state_->IsGraphiteDawn()) {
+      auto* gsc = context_state_->graphite_shared_context();
+      if (gsc && !gsc->IsContextLost() && !gsc->isDeviceLost()) {
+        context_state_->FlushGraphiteRecorder();
+        pending_graphite_fences_.fetch_add(1, std::memory_order_acq_rel);
+        auto* cb_ptr = new base::OnceClosure(base::BindOnce(
+            [](scoped_refptr<GpuSlotSync> sync, base::OnceClosure cb) {
+              sync->pending_graphite_fences_.fetch_sub(
+                  1, std::memory_order_acq_rel);
+              if (sync->gpu_task_runner_ &&
+                  !sync->gpu_task_runner_->BelongsToCurrentThread()) {
+                sync->gpu_task_runner_->PostTask(
+                    FROM_HERE,
+                    base::BindOnce(&GpuSlotSync::WaitForAngleFenceOnGpuThread,
+                                   sync, std::move(cb)));
+                return;
+              }
+              sync->WaitForAngleFenceOnGpuThread(std::move(cb));
+            },
+            scoped_refptr<GpuSlotSync>(this), std::move(done_cb)));
+        skgpu::graphite::SubmitInfo info;
+        info.fSync = skgpu::graphite::SyncToCpu::kNo;
+        info.fFinishedContext = cb_ptr;
+        info.fFinishedProc = [](void* ctx, skgpu::CallbackResult) {
+          auto cb = base::WrapUnique(static_cast<base::OnceClosure*>(ctx));
+          if (*cb) {
+            std::move(*cb).Run();
+          }
+        };
+        gsc->submit(info);
+        context_state_->ScheduleSkiaCleanup();
+        ScheduleFencePollOnGpuThread();
+        return;
+      }
+    }
+
+    WaitForAngleFenceOnGpuThread(std::move(done_cb));
+  }
+
+  void ScheduleFencePollOnGpuThread() {
+    if (fence_poll_timer_.IsRunning()) {
+      return;
+    }
+    if (!pending_vk_fences_.empty() || !pending_angle_fences_.empty() ||
+        pending_graphite_fences_.load(std::memory_order_acquire) > 0) {
+      fence_poll_timer_.Start(
+          FROM_HERE, base::Milliseconds(2),
+          base::BindRepeating(&GpuSlotSync::PollPendingFencesOnGpuThread,
+                              base::Unretained(this)));
+    }
+  }
+
+  void PollPendingFencesOnGpuThread() {
+    scoped_refptr<GpuSlotSync> keep_alive(this);
+    const bool context_lost = context_state_ && context_state_->context_lost();
+
+    if (!context_state_ || context_lost) {
+      pending_vk_fences_.clear();
+      pending_graphite_fences_.store(0, std::memory_order_release);
+    } else {
+      if (!pending_vk_fences_.empty()) {
+        auto* vk_provider = context_state_->vk_context_provider();
+        auto* vk_queue =
+            vk_provider ? vk_provider->GetDeviceQueue() : nullptr;
+        auto* fence_helper = vk_queue ? vk_queue->GetFenceHelper() : nullptr;
+        if (!fence_helper) {
+          pending_vk_fences_.clear();
+        } else {
+          fence_helper->ProcessCleanupTasks();
+          while (!pending_vk_fences_.empty() &&
+                 fence_helper->HasPassed(pending_vk_fences_.front())) {
+            pending_vk_fences_.pop_front();
+          }
+        }
+      }
+
+      if (pending_graphite_fences_.load(std::memory_order_acquire) > 0) {
+        auto* gsc = context_state_->graphite_shared_context();
+        if (gsc && !gsc->IsContextLost() && !gsc->isDeviceLost()) {
+          gsc->checkAsyncWorkCompletion();
+        } else {
+          pending_graphite_fences_.store(0, std::memory_order_release);
+        }
+      }
+    }
+
+    std::vector<base::OnceClosure> completed_angle_cbs;
+    if (context_lost) {
+      while (!pending_angle_fences_.empty()) {
+        DestroyAngleVkFence(angle_vk_device_, pfn_angle_destroy_fence_,
+                            pending_angle_fences_.front().fence);
+        if (pending_angle_fences_.front().done_cb) {
+          completed_angle_cbs.push_back(
+              std::move(pending_angle_fences_.front().done_cb));
+        }
+        pending_angle_fences_.pop_front();
+      }
+    } else {
+      while (!pending_angle_fences_.empty()) {
+        VkResult st = GetAngleVkFenceStatus(angle_vk_device_,
+                                            pfn_angle_get_fence_status_,
+                                            pending_angle_fences_.front().fence);
+        if (st == VK_NOT_READY) {
+          break;
+        }
+        DestroyAngleVkFence(angle_vk_device_, pfn_angle_destroy_fence_,
+                            pending_angle_fences_.front().fence);
+        if (pending_angle_fences_.front().done_cb) {
+          completed_angle_cbs.push_back(
+              std::move(pending_angle_fences_.front().done_cb));
+        }
+        pending_angle_fences_.pop_front();
+        if (st != VK_SUCCESS) {
+          while (!pending_angle_fences_.empty()) {
+            DestroyAngleVkFence(angle_vk_device_, pfn_angle_destroy_fence_,
+                                pending_angle_fences_.front().fence);
+            if (pending_angle_fences_.front().done_cb) {
+              completed_angle_cbs.push_back(
+                  std::move(pending_angle_fences_.front().done_cb));
+            }
+            pending_angle_fences_.pop_front();
+          }
+          break;
+        }
+      }
+    }
+
+    if (pending_vk_fences_.empty() && pending_angle_fences_.empty() &&
+        pending_graphite_fences_.load(std::memory_order_acquire) <= 0) {
+      fence_poll_timer_.Stop();
+    }
+
+    for (auto& cb : completed_angle_cbs) {
+      std::move(cb).Run();
+    }
+  }
+
+  scoped_refptr<base::SingleThreadTaskRunner> gpu_task_runner_;
+  VulkanVideoDecoder::GetCommandBufferStubCB get_stub_cb_;
+  bool initialized_ = false;
+  scoped_refptr<CommandBufferHelper> cb_helper_;
+  base::WeakPtr<gpu::SharedContextState> context_state_;
+  bool angle_vk_ready_ = false;
+  VkDevice angle_vk_device_ = VK_NULL_HANDLE;
+  VkQueue angle_vk_queue_ = VK_NULL_HANDLE;
+  void* angle_display_ = nullptr;
+  PFN_vkCreateFence pfn_angle_create_fence_ = nullptr;
+  PFN_vkQueueSubmit pfn_angle_queue_submit_ = nullptr;
+  PFN_vkGetFenceStatus pfn_angle_get_fence_status_ = nullptr;
+  PFN_vkDestroyFence pfn_angle_destroy_fence_ = nullptr;
+  base::circular_deque<gpu::VulkanFenceHelper::FenceHandle> pending_vk_fences_;
+  base::circular_deque<AnglePendingFence> pending_angle_fences_;
+  std::atomic<int> pending_graphite_fences_{0};
+  base::RepeatingTimer fence_poll_timer_;
+};
