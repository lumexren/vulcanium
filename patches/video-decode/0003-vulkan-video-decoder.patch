+constexpr size_t kDecodeCopyRingSize = 3;
+
+struct DecodeCopyCmd {
+  VkCommandPool cmd_pool = VK_NULL_HANDLE;
+  VkCommandBuffer cmd_buf = VK_NULL_HANDLE;
+  VkFence fence = VK_NULL_HANDLE;
+  bool in_flight = false;
+};
+
+struct PendingGpuEmit {
+  size_t cmd_idx = 0;
+  scoped_refptr<FrameResource> resource;
+  bool is_pooled = false;
+};
+
+struct VulkanCopyState {
+  std::array<DecodeCopyCmd, kDecodeCopyRingSize> cmds;
+  size_t next_cmd = 0;
+  base::circular_deque<PendingGpuEmit> pending_emits;
+  gfx::Size pool_size;
+  VideoPixelFormat pool_format = PIXEL_FORMAT_UNKNOWN;
+  std::vector<OutputSlot> slots;
+  std::map<base::UnguessableToken, scoped_refptr<VideoFrameResource>>
+      origin_frames_by_token;
+};
