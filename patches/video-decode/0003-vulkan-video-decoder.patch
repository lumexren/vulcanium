+// static
+SupportedVideoDecoderConfigs VulkanVideoDecoder::GetSupportedConfigs() {
+  const auto& caps = VulkanVideoDevice::GetInstance()->GetCapabilities();
+  SupportedVideoDecoderConfigs configs;
+  if (caps.decode_h264.supported) {
+    configs.emplace_back(H264PROFILE_MIN, H264PROFILE_MAX,
+                         caps.decode_h264.min_size, caps.decode_h264.max_size,
+                         /*allow_encrypted=*/false,
+                         /*require_encrypted=*/false);
+  }
+  if (caps.decode_hevc.supported) {
+    configs.emplace_back(HEVCPROFILE_MAIN, HEVCPROFILE_MAIN,
+                         caps.decode_hevc.min_size, caps.decode_hevc.max_size,
+                         /*allow_encrypted=*/false,
+                         /*require_encrypted=*/false);
+  }
+  if (caps.decode_hevc_10bit.supported) {
+    configs.emplace_back(HEVCPROFILE_MAIN10, HEVCPROFILE_MAIN10,
+                         caps.decode_hevc_10bit.min_size,
+                         caps.decode_hevc_10bit.max_size,
+                         /*allow_encrypted=*/false,
+                         /*require_encrypted=*/false);
+  }
+  if (caps.decode_vp9.supported) {
+    configs.emplace_back(VP9PROFILE_PROFILE0, VP9PROFILE_PROFILE0,
+                         caps.decode_vp9.min_size, caps.decode_vp9.max_size,
+                         /*allow_encrypted=*/false,
+                         /*require_encrypted=*/false);
+  }
+  if (caps.decode_vp9_10bit.supported) {
+    configs.emplace_back(VP9PROFILE_PROFILE2, VP9PROFILE_PROFILE2,
+                         caps.decode_vp9_10bit.min_size,
+                         caps.decode_vp9_10bit.max_size,
+                         /*allow_encrypted=*/false,
+                         /*require_encrypted=*/false);
+  }
+  if (caps.decode_av1.supported || caps.decode_av1_10bit.supported) {
+    const auto& cap =
+        caps.decode_av1.supported ? caps.decode_av1 : caps.decode_av1_10bit;
+    configs.emplace_back(AV1PROFILE_PROFILE_MAIN, AV1PROFILE_PROFILE_MAIN,
+                         cap.min_size, cap.max_size,
+                         /*allow_encrypted=*/false,
+                         /*require_encrypted=*/false);
+  }
+  return configs;
+}
+
+// static
+bool VulkanVideoDecoder::IsSupported(const VideoDecoderConfig& config) {
+  if (config.is_encrypted()) {
+    return false;
+  }
+  const auto& caps = VulkanVideoDevice::GetInstance()->GetCapabilities();
+  const CodecCapability* cap = nullptr;
+  switch (config.codec()) {
+    case VideoCodec::kH264:
+      cap = &caps.decode_h264;
+      break;
+    case VideoCodec::kHEVC:
+      if (config.profile() == HEVCPROFILE_MAIN10) {
+        cap = &caps.decode_hevc_10bit;
+      } else if (config.profile() == HEVCPROFILE_MAIN ||
+                 config.profile() == HEVCPROFILE_MAIN_STILL_PICTURE) {
+        cap = &caps.decode_hevc;
+      } else {
+        return false;
+      }
+      break;
+    case VideoCodec::kVP9:
+      if (config.profile() == VP9PROFILE_PROFILE2) {
+        cap = &caps.decode_vp9_10bit;
+      } else if (config.profile() == VP9PROFILE_PROFILE0) {
+        cap = &caps.decode_vp9;
+      } else {
+        return false;
+      }
+      break;
+    case VideoCodec::kAV1:
+      if (config.profile() != AV1PROFILE_PROFILE_MAIN) {
+        return false;
+      }
+      cap = caps.decode_av1.supported ? &caps.decode_av1
+                                      : &caps.decode_av1_10bit;
+      break;
+    default:
+      return false;
+  }
+  if (!cap->supported) {
+    return false;
+  }
+  const gfx::Size& coded_size = config.coded_size();
+  if (!coded_size.IsEmpty() &&
+      (coded_size.width() < cap->min_size.width() ||
+       coded_size.height() < cap->min_size.height() ||
+       coded_size.width() > cap->max_size.width() ||
+       coded_size.height() > cap->max_size.height())) {
+    return false;
+  }
+  return true;
+}
+
+VulkanVideoDecoder::VulkanVideoDecoder(
+    std::unique_ptr<MediaLog> media_log,
+    std::unique_ptr<FrameResourceConverter> frame_converter)
+    : media_log_(std::move(media_log)),
+      frame_converter_(std::move(frame_converter)) {}
+
+VulkanVideoDecoder::~VulkanVideoDecoder() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  weak_factory_.InvalidateWeakPtrs();
+  if (frame_converter_) {
+    frame_converter_->AbortPendingFrames();
+    frame_converter_.reset();
+  }
+  ReleaseResources(/*release_slot=*/true);
+}
+
+VideoDecoderType VulkanVideoDecoder::GetDecoderType() const {
+  return VideoDecoderType::kFFmpeg;
+}
+
+bool VulkanVideoDecoder::FramesHoldExternalResources() const {
+  return true;
+}
+
+void VulkanVideoDecoder::Initialize(const VideoDecoderConfig& config,
+                                    bool low_delay,
+                                    CdmContext* cdm_context,
+                                    InitCB init_cb,
+                                    const OutputCB& output_cb,
+                                    const WaitingCB& waiting_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  InitCB bound_init_cb = base::BindPostTaskToCurrentDefault(std::move(init_cb));
+
+  if (!IsSupported(config)) {
+    ReleaseResources(/*release_slot=*/true);
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kUnsupportedConfig);
+    return;
+  }
+
+  if (initialized_ && codec_context_ && config_.codec() == config.codec() &&
+      config_.profile() == config.profile() &&
+      config_.coded_size() == config.coded_size() &&
+      config_.extra_data() == config.extra_data()) {
+    DiscardPendingEmits();
+    avcodec_flush_buffers(codec_context_.get());
+    config_ = config;
+    output_cb_ = output_cb;
+    eos_reached_ = false;
+    if (media_log_) {
+      media_log_->SetProperty<MediaLogProperty::kVideoDecoderName>(
+          GetDecoderType());
+      media_log_->SetProperty<MediaLogProperty::kIsPlatformVideoDecoder>(true);
+    }
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kOk);
+    return;
+  }
+
+  if (!ConfigureVulkanDecoder(config)) {
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kUnsupportedConfig);
+    return;
+  }
+
+  config_ = config;
+  output_cb_ = output_cb;
+  if (frame_converter_ && !converter_initialized_) {
+    frame_converter_->Initialize(
+        base::SequencedTaskRunner::GetCurrentDefault(),
+        base::BindRepeating(&VulkanVideoDecoder::OnFrameConverted,
+                            weak_factory_.GetWeakPtr()));
+    frame_converter_->set_get_original_frame_cb(base::BindRepeating(
+        &VulkanVideoDecoder::GetOriginalFrame, base::Unretained(this)));
+    converter_initialized_ = true;
+  }
+  initialized_ = true;
+  eos_reached_ = false;
+  if (media_log_) {
+    media_log_->SetProperty<MediaLogProperty::kVideoDecoderName>(
+        GetDecoderType());
+    media_log_->SetProperty<MediaLogProperty::kIsPlatformVideoDecoder>(true);
+    MEDIA_LOG(INFO, media_log_)
+        << "Initialized VulkanVideoDecoder for "
+        << GetCodecName(config.codec()) << " ("
+        << config.coded_size().ToString() << ")";
+  }
+  std::move(bound_init_cb).Run(DecoderStatus::Codes::kOk);
+}
+
+bool VulkanVideoDecoder::ConfigureVulkanDecoder(
+    const VideoDecoderConfig& config) {
+  ReleaseResources(/*release_slot=*/false);
+  drm_prime_map_supported_ = true;
+
+  if (!has_decoder_slot_) {
+    if (!TryAcquireDecoderSlot()) {
+      VLOG(1) << "VulkanVideoDecoder: max concurrent decoders ("
+              << kMaxConcurrentDecoders << ") reached; rejecting config";
+      return false;
+    }
+    has_decoder_slot_ = true;
+  }
+
+  hw_device_ctx_ = VulkanVideoDevice::GetInstance()->AcquireDevice();
+  if (!hw_device_ctx_) {
+    ReleaseResources(/*release_slot=*/true);
+    return false;
+  }
+
+  codec_context_.reset(avcodec_alloc_context3(nullptr));
+  if (!codec_context_) {
+    ReleaseResources(/*release_slot=*/true);
+    return false;
+  }
+
+  VideoDecoderConfigToAVCodecContext(config, codec_context_.get());
+  av_freep(&codec_context_->codec_whitelist);
+  codec_context_->codec_whitelist = av_strdup("h264,hevc,vp9,av1");
+  codec_context_->hw_device_ctx = av_buffer_ref(hw_device_ctx_);
+  codec_context_->get_format = GetVulkanHwFormat;
+  codec_context_->pkt_timebase = AVRational{1, 1000000};
+
+  const AVCodec* codec = avcodec_find_decoder(codec_context_->codec_id);
+  if (!codec) {
+    LOG(ERROR) << "VulkanVideoDecoder: avcodec_find_decoder failed for codec "
+               << GetCodecName(config.codec());
+    ReleaseResources(/*release_slot=*/true);
+    return false;
+  }
+  int err = avcodec_open2(codec_context_.get(), codec, nullptr);
+  if (err < 0) {
+    LOG(ERROR) << "VulkanVideoDecoder: avcodec_open2 failed for codec "
+               << GetCodecName(config.codec()) << ": " << AVErrorToString(err);
+    ReleaseResources(/*release_slot=*/true);
+    return false;
+  }
+  VLOG(1) << "VulkanVideoDecoder: initialized " << codec->name << " for "
+          << GetCodecName(config.codec());
+
+  return true;
+}
+
+void VulkanVideoDecoder::ReleaseResources(bool release_slot) {
+  if (zero_wait_emits_ > 0 || waited_emits_ > 0) {
+    VLOG(1) << "VulkanVideoDecoder copy stats: zero_wait=" << zero_wait_emits_
+            << " waited=" << waited_emits_;
+    zero_wait_emits_ = 0;
+    waited_emits_ = 0;
+  }
+  DiscardPendingEmits();
+  codec_context_.reset();
+  av_packet_free(&reusable_packet_);
+  av_frame_free(&reusable_hw_frame_);
+  if (copy_state_) {
+    if (hw_device_ctx_) {
+      auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(hw_device_ctx_->data);
+      auto* vk_dev =
+          dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx)
+                  : nullptr;
+      const auto* copy_info = VulkanVideoDevice::GetInstance()->GetCopyInfo();
+      if (vk_dev && copy_info && copy_info->procs_ready) {
+        for (auto& cmd : copy_state_->cmds) {
+          DestroyCopyCmdResources(vk_dev, copy_info->procs, cmd.cmd_pool,
+                                  cmd.fence);
+          cmd.cmd_pool = VK_NULL_HANDLE;
+          cmd.cmd_buf = VK_NULL_HANDLE;
+          cmd.fence = VK_NULL_HANDLE;
+        }
+      }
+    }
+    copy_state_.reset();
+  }
+  if (hw_device_ctx_) {
+    av_buffer_unref(&hw_device_ctx_);
+    hw_device_ctx_ = nullptr;
+  }
+  initialized_ = false;
+  if (release_slot && has_decoder_slot_) {
+    g_active_decoders.fetch_sub(1, std::memory_order_acq_rel);
+    has_decoder_slot_ = false;
+  }
+}
+
+bool VulkanVideoDecoder::DrainDecodedFrames() {
+  if (!reusable_hw_frame_) {
+    reusable_hw_frame_ = av_frame_alloc();
+    if (!reusable_hw_frame_) {
+      return false;
+    }
+  } else {
+    av_frame_unref(reusable_hw_frame_);
+  }
+
+  while (true) {
+    int ret = avcodec_receive_frame(codec_context_.get(), reusable_hw_frame_);
+    if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) {
+      return true;
+    }
+    if (ret < 0) {
+      av_frame_unref(reusable_hw_frame_);
+      return false;
+    }
+    const bool emitted = EmitFrame(reusable_hw_frame_);
+    av_frame_unref(reusable_hw_frame_);
+    if (!emitted) {
+      return false;
+    }
+  }
+}
+
+void VulkanVideoDecoder::Decode(scoped_refptr<DecoderBuffer> buffer,
+                                DecodeCB decode_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DecodeCB bound_cb = base::BindPostTaskToCurrentDefault(std::move(decode_cb));
+
+  if (!initialized_ || !codec_context_) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+    return;
+  }
+  if (eos_reached_) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kOk);
+    return;
+  }
+
+  if (!reusable_packet_) {
+    reusable_packet_ = av_packet_alloc();
+    if (!reusable_packet_) {
+      std::move(bound_cb).Run(DecoderStatus::Codes::kOutOfMemory);
+      return;
+    }
+  } else {
+    av_packet_unref(reusable_packet_);
+  }
+
+  if (buffer->end_of_stream()) {
+    reusable_packet_->data = nullptr;
+    reusable_packet_->size = 0;
+  } else {
+    auto span = base::span(*buffer);
+    reusable_packet_->data = const_cast<uint8_t*>(span.data());
+    reusable_packet_->size = base::checked_cast<int>(span.size());
+    reusable_packet_->pts =
+        ConvertToTimeBase(codec_context_->pkt_timebase, buffer->timestamp());
+  }
+
+  constexpr int kMaxSendRetries = 8;
+  int ret = AVERROR(EAGAIN);
+  for (int attempt = 0; attempt < kMaxSendRetries; ++attempt) {
+    ret = avcodec_send_packet(codec_context_.get(), reusable_packet_);
+    if (ret != AVERROR(EAGAIN)) {
+      break;
+    }
+    if (!DrainDecodedFrames()) {
+      av_packet_unref(reusable_packet_);
+      std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+      return;
+    }
+  }
+  av_packet_unref(reusable_packet_);
+  if (ret < 0 && ret != AVERROR_EOF) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+    return;
+  }
+
+  if (!DrainDecodedFrames()) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+    return;
+  }
+
+  if (buffer->end_of_stream()) {
+    DrainPendingEmits(/*wait_all=*/true);
+    eos_reached_ = true;
+  }
+  std::move(bound_cb).Run(DecoderStatus::Codes::kOk);
+}
+
+bool VulkanVideoDecoder::StepFrontPendingEmit(bool wait_if_busy) {
+  if (!copy_state_ || copy_state_->pending_emits.empty()) {
+    return false;
+  }
+  const auto* copy_info = VulkanVideoDevice::GetInstance()->GetCopyInfo();
+  AVVulkanDeviceContext* vk_dev = nullptr;
+  if (hw_device_ctx_) {
+    auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(hw_device_ctx_->data);
+    vk_dev =
+        dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+  }
+  if (!vk_dev || !vk_dev->act_dev || !copy_info || !copy_info->procs_ready) {
+    copy_state_->pending_emits.clear();
+    return false;
+  }
+
+  PendingGpuEmit& front = copy_state_->pending_emits.front();
+  DecodeCopyCmd& cmd = copy_state_->cmds[front.cmd_idx];
+  VkResult st = GetFenceStatus(vk_dev, copy_info->procs, cmd.fence);
+  if (st == VK_NOT_READY) {
+    if (!wait_if_busy) {
+      return false;
+    }
+    WaitForFence(vk_dev, copy_info->procs, cmd.fence, 1000000000ULL);
+    ++waited_emits_;
+  } else {
+    ++zero_wait_emits_;
+  }
+
+  scoped_refptr<FrameResource> res = std::move(front.resource);
+  const bool is_pooled = front.is_pooled;
+  copy_state_->pending_emits.pop_front();
+  cmd.in_flight = false;
+
+  if (frame_converter_ && res) {
+    auto weak_self = weak_factory_.GetWeakPtr();
+    if (!is_pooled) {
+      current_unpooled_origin_ = res.get();
+    }
+    frame_converter_->ConvertFrame(std::move(res));
+    if (!weak_self) {
+      return false;
+    }
+    if (!is_pooled) {
+      current_unpooled_origin_ = nullptr;
+    }
+  }
+  return true;
+}
+
+void VulkanVideoDecoder::DrainPendingEmits(bool wait_all) {
+  while (StepFrontPendingEmit(wait_all)) {
+  }
+  if (copy_state_ && copy_state_->pending_emits.empty()) {
+    pending_emit_timer_.Stop();
+  }
+}
+
+void VulkanVideoDecoder::PollPendingEmits() {
+  DrainPendingEmits(/*wait_all=*/false);
+  if (copy_state_ && !copy_state_->pending_emits.empty()) {
+    pending_emit_timer_.Start(FROM_HERE, base::Milliseconds(1), this,
+                              &VulkanVideoDecoder::PollPendingEmits);
+  }
+}
+
+void VulkanVideoDecoder::DiscardPendingEmits() {
+  pending_emit_timer_.Stop();
+  if (!copy_state_) {
+    return;
+  }
+  const auto* copy_info = VulkanVideoDevice::GetInstance()->GetCopyInfo();
+  AVVulkanDeviceContext* vk_dev = nullptr;
+  if (hw_device_ctx_) {
+    auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(hw_device_ctx_->data);
+    vk_dev =
+        dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+  }
+  const bool can_vk =
+      vk_dev && vk_dev->act_dev && copy_info && copy_info->procs_ready;
+  for (auto& cmd : copy_state_->cmds) {
+    if (cmd.in_flight) {
+      if (can_vk) {
+        WaitForFence(vk_dev, copy_info->procs, cmd.fence, 1000000000ULL);
+      }
+      cmd.in_flight = false;
+    }
+  }
+  copy_state_->pending_emits.clear();
+}
+
+bool VulkanVideoDecoder::EmitGpuCopyFrameAsync(
+    AVFrame* hw_frame,
+    VideoPixelFormat pixel_format,
+    const gfx::Rect& visible_rect,
+    const gfx::Size& natural_size,
+    const gfx::ColorSpace& color_space,
+    base::TimeDelta pts) {
+  if (!hw_frame || !hw_frame->hw_frames_ctx || !hw_device_ctx_ ||
+      !frame_converter_) {
+    return false;
+  }
+  const auto* copy_info = VulkanVideoDevice::GetInstance()->GetCopyInfo();
+  if (!copy_info || !copy_info->procs_ready) {
+    return false;
+  }
+  auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(hw_device_ctx_->data);
+  auto* vk_dev =
+      dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+  if (!vk_dev || !vk_dev->act_dev) {
+    return false;
+  }
+
+  const int w = hw_frame->width;
+  const int h = hw_frame->height;
+  const gfx::Size coded_size(w, h);
+  if (w <= 0 || h <= 0) {
+    return false;
+  }
+
+  if (!copy_state_) {
+    copy_state_ = std::make_unique<VulkanCopyState>();
+  }
+
+  DrainPendingEmits(/*wait_all=*/false);
+
+  if (copy_state_->pool_size != coded_size ||
+      copy_state_->pool_format != pixel_format) {
+    DrainPendingEmits(/*wait_all=*/true);
+    copy_state_->slots.clear();
+    copy_state_->origin_frames_by_token.clear();
+    copy_state_->pool_size = coded_size;
+    copy_state_->pool_format = pixel_format;
+  }
+
+  const size_t cmd_idx = copy_state_->next_cmd;
+  while (copy_state_->cmds[cmd_idx].in_flight &&
+         StepFrontPendingEmit(/*wait_if_busy=*/true)) {
+  }
+  if (!copy_state_ || copy_state_->cmds[cmd_idx].in_flight) {
+    return false;
+  }
+
+  DecodeCopyCmd& cmd = copy_state_->cmds[cmd_idx];
+  if (cmd.cmd_pool == VK_NULL_HANDLE) {
+    if (!CreateCopyCmdResources(vk_dev, *copy_info, &cmd.cmd_pool, &cmd.cmd_buf,
+                                &cmd.fence)) {
+      return false;
+    }
+  }
+
+  OutputSlot* chosen = nullptr;
+  for (auto& slot : copy_state_->slots) {
+    if (!slot.in_use) {
+      chosen = &slot;
+      break;
+    }
+  }
+
+  if (!chosen && copy_state_->slots.size() < kMaxOutputPoolSize) {
+    auto new_slot = CreateDmabufSlot(
+        hw_device_ctx_, vk_dev, *copy_info, w, h, pixel_format, visible_rect,
+        natural_size, color_space, config_.hdr_metadata(), pts);
+    if (!new_slot) {
+      return false;
+    }
+    copy_state_->origin_frames_by_token.emplace(new_slot->token,
+                                                new_slot->origin_frame);
+    copy_state_->slots.push_back(std::move(*new_slot));
+    chosen = &copy_state_->slots.back();
+  }
+
+  scoped_refptr<FrameResource> resource;
+  bool is_pooled = false;
+  if (chosen) {
+    if (!SubmitCopyVkFrameToVkImage(vk_dev, *copy_info, cmd.cmd_pool,
+                                    cmd.cmd_buf, cmd.fence, hw_frame,
+                                    chosen->img)) {
+      return false;
+    }
+    auto wrapped =
+        chosen->origin_frame->CreateWrappingFrame(visible_rect, natural_size);
+    if (!wrapped) {
+      return false;
+    }
+    wrapped->set_timestamp(pts);
+    wrapped->set_color_space(color_space);
+    wrapped->set_hdr_metadata(config_.hdr_metadata());
+    wrapped->metadata().power_efficient = true;
+    chosen->in_use = true;
+    wrapped->AddDestructionObserver(base::BindPostTaskToCurrentDefault(
+        base::BindOnce(&VulkanVideoDecoder::ReleaseOutputSlot,
+                       weak_factory_.GetWeakPtr(), chosen->token)));
+    resource = std::move(wrapped);
+    is_pooled = true;
+  } else {
+    // All pooled slots are currently held downstream; emit a one-shot unpooled
+    // buffer whose GPU backing is freed as soon as the frame is released.
+    auto temp_slot = CreateDmabufSlot(
+        hw_device_ctx_, vk_dev, *copy_info, w, h, pixel_format, visible_rect,
+        natural_size, color_space, config_.hdr_metadata(), pts);
+    if (!temp_slot) {
+      return false;
+    }
+    if (!SubmitCopyVkFrameToVkImage(vk_dev, *copy_info, cmd.cmd_pool,
+                                    cmd.cmd_buf, cmd.fence, hw_frame,
+                                    temp_slot->img)) {
+      return false;
+    }
+    resource = temp_slot->origin_frame;
+    is_pooled = false;
+  }
+
+  cmd.in_flight = true;
+  copy_state_->next_cmd = (cmd_idx + 1) % kDecodeCopyRingSize;
+  copy_state_->pending_emits.push_back(
+      PendingGpuEmit{cmd_idx, std::move(resource), is_pooled});
+  if (!logged_async_copy_) {
+    logged_async_copy_ = true;
+    VLOG(1) << "VulkanVideoDecoder: async pipelined GPU copy active (ring=3)";
+  }
+
+  DrainPendingEmits(/*wait_all=*/false);
+  if (copy_state_ && !copy_state_->pending_emits.empty() &&
+      !pending_emit_timer_.IsRunning()) {
+    pending_emit_timer_.Start(FROM_HERE, base::Milliseconds(1), this,
+                              &VulkanVideoDecoder::PollPendingEmits);
+  }
+  return true;
+}
+
+void VulkanVideoDecoder::ReleaseOutputSlot(base::UnguessableToken token) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!copy_state_) {
+    return;
+  }
+  for (auto& slot : copy_state_->slots) {
+    if (slot.token == token) {
+      slot.in_use = false;
+      return;
+    }
+  }
+}
+
+FrameResource* VulkanVideoDecoder::GetOriginalFrame(
+    const base::UnguessableToken& tracking_token) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (copy_state_) {
+    auto it = copy_state_->origin_frames_by_token.find(tracking_token);
+    if (it != copy_state_->origin_frames_by_token.end()) {
+      return it->second.get();
+    }
+  }
+  return current_unpooled_origin_;
+}
+
+bool VulkanVideoDecoder::EmitFrame(AVFrame* hw_frame) {
+  const gfx::Size coded_size(hw_frame->width, hw_frame->height);
+  gfx::Rect visible_rect(coded_size);
+  if (hw_frame->crop_left || hw_frame->crop_top || hw_frame->crop_right ||
+      hw_frame->crop_bottom) {
+    const size_t x = std::min(hw_frame->crop_left,
+                              static_cast<size_t>(coded_size.width()));
+    const size_t y = std::min(hw_frame->crop_top,
+                              static_cast<size_t>(coded_size.height()));
+    const size_t max_w = static_cast<size_t>(coded_size.width()) - x;
+    const size_t max_h = static_cast<size_t>(coded_size.height()) - y;
+    const size_t crop_r = std::min(hw_frame->crop_right, max_w);
+    const size_t crop_b = std::min(hw_frame->crop_bottom, max_h);
+    gfx::Rect cropped(static_cast<int>(x), static_cast<int>(y),
+                      static_cast<int>(max_w - crop_r),
+                      static_cast<int>(max_h - crop_b));
+    if (!cropped.IsEmpty()) {
+      visible_rect = cropped;
+    }
+  } else if (!config_.visible_rect().IsEmpty()) {
+    gfx::Rect intersected =
+        gfx::IntersectRects(config_.visible_rect(), gfx::Rect(coded_size));
+    if (!intersected.IsEmpty()) {
+      visible_rect = intersected;
+    }
+  }
+  const gfx::Size natural_size =
+      config_.aspect_ratio().GetNaturalSize(visible_rect);
+  const gfx::ColorSpace color_space = ResolveFrameColorSpace(hw_frame, config_);
+
+  AVPixelFormat sw_fmt = static_cast<AVPixelFormat>(hw_frame->format);
+  if (hw_frame->format == AV_PIX_FMT_VULKAN && hw_frame->hw_frames_ctx) {
+    auto* fctx =
+        reinterpret_cast<AVHWFramesContext*>(hw_frame->hw_frames_ctx->data);
+    if (fctx) {
+      sw_fmt = fctx->sw_format;
+    }
+  }
+  const bool is_p010 = (sw_fmt == AV_PIX_FMT_P010);
+  const VideoPixelFormat pixel_format =
+      is_p010 ? PIXEL_FORMAT_P010LE : PIXEL_FORMAT_NV12;
+
+  const auto pts =
+      ConvertFromTimeBase(codec_context_->pkt_timebase, hw_frame->pts);
+
+  // Zero-copy path: map AV_PIX_FMT_VULKAN -> AV_PIX_FMT_DRM_PRIME and wrap
+  // exported DMA-BUF file descriptors directly into a VideoFrame.
+  if (hw_frame->format == AV_PIX_FMT_VULKAN && drm_prime_map_supported_) {
+    AVFrame* drm_frame = av_frame_alloc();
+    if (drm_frame) {
+      drm_frame->format = AV_PIX_FMT_DRM_PRIME;
+      if (av_hwframe_map(drm_frame, hw_frame, AV_HWFRAME_MAP_READ) == 0) {
+        const auto* desc =
+            reinterpret_cast<const AVDRMFrameDescriptor*>(drm_frame->data[0]);
+        if (desc && desc->nb_layers > 0 && desc->layers[0].nb_planes > 0) {
+          const AVDRMLayerDescriptor& layer = desc->layers[0];
+          std::vector<ColorPlaneLayout> planes;
+          std::vector<base::ScopedFD> dmabuf_fds;
+          bool fds_ok = true;
+          uint64_t modifier = desc->objects[0].format_modifier;
+
+          for (int i = 0; i < layer.nb_planes; ++i) {
+            int obj_idx = layer.planes[i].object_index;
+            if (obj_idx < 0 || obj_idx >= desc->nb_objects) {
+              fds_ok = false;
+              break;
+            }
+            base::ScopedFD dup_fd(HANDLE_EINTR(dup(desc->objects[obj_idx].fd)));
+            if (!dup_fd.is_valid()) {
+              fds_ok = false;
+              break;
+            }
+            planes.emplace_back(layer.planes[i].pitch, layer.planes[i].offset,
+                                desc->objects[obj_idx].size);
+            dmabuf_fds.push_back(std::move(dup_fd));
+          }
+
+          if (fds_ok) {
+            auto layout = VideoFrameLayout::CreateWithPlanes(
+                pixel_format, coded_size, std::move(planes),
+                VideoFrameLayout::kBufferAddressAlignment, modifier);
+            if (layout) {
+              auto video_frame = VideoFrame::WrapExternalDmabufs(
+                  *layout, visible_rect, natural_size, std::move(dmabuf_fds),
+                  pts);
+              if (video_frame && frame_converter_) {
+                video_frame->metadata().power_efficient = true;
+                video_frame->metadata().tracking_token =
+                    base::UnguessableToken::Create();
+                video_frame->set_color_space(color_space);
+                video_frame->set_hdr_metadata(config_.hdr_metadata());
+                video_frame->AddDestructionObserver(base::BindOnce(
+                    [](AVFrame* frame) { av_frame_free(&frame); }, drm_frame));
+                drm_frame = nullptr;
+                auto resource =
+                    VideoFrameResource::Create(std::move(video_frame));
+                if (resource) {
+                  DrainPendingEmits(/*wait_all=*/true);
+                  auto weak_self = weak_factory_.GetWeakPtr();
+                  current_unpooled_origin_ = resource.get();
+                  frame_converter_->ConvertFrame(std::move(resource));
+                  if (weak_self) {
+                    current_unpooled_origin_ = nullptr;
+                  }
+                  return true;
+                }
+              }
+            }
+          }
+        }
+      } else {
+        drm_prime_map_supported_ = false;
+      }
+      av_frame_free(&drm_frame);
+    }
+  }
+
+  if (hw_frame->format == AV_PIX_FMT_VULKAN && frame_converter_) {
+    if (EmitGpuCopyFrameAsync(hw_frame, pixel_format, visible_rect,
+                              natural_size, color_space, pts)) {
+      return true;
+    }
+    static bool logged_fb = false;
+    if (!logged_fb) {
+      logged_fb = true;
+      LOG(WARNING)
+          << "VulkanVideoDecoder: falling back to av_hwframe_transfer_data";
+    }
+  }
+
+  // Fallback path: transfer Vulkan surface to host NV12/P010LE VideoFrame.
+  AVFrame* sw_frame = av_frame_alloc();
+  if (!sw_frame) {
+    return false;
+  }
+
+  int ret = (hw_frame->format == AV_PIX_FMT_VULKAN)
+                ? av_hwframe_transfer_data(sw_frame, hw_frame, 0)
+                : av_frame_ref(sw_frame, hw_frame);
+  if (ret < 0) {
+    av_frame_free(&sw_frame);
+    return false;
+  }
+
+  const bool sw_is_p010 = (sw_frame->format == AV_PIX_FMT_P010);
+  const VideoPixelFormat sw_pixel_format =
+      sw_is_p010 ? PIXEL_FORMAT_P010LE : PIXEL_FORMAT_NV12;
+  auto video_frame = VideoFrame::CreateFrame(sw_pixel_format, coded_size,
+                                             visible_rect, natural_size, pts);
+  if (!video_frame) {
+    av_frame_free(&sw_frame);
+    return false;
+  }
+
+  // Copy Y and interleaved UV planes from transferred NV12/P010 frame.
+  const int bpp = sw_is_p010 ? 2 : 1;
+  for (int plane = 0; plane < 2; ++plane) {
+    const uint8_t* src = sw_frame->data[plane];
+    int src_stride = sw_frame->linesize[plane];
+    uint8_t* dst = video_frame->writable_data(plane);
+    int dst_stride = video_frame->stride(plane);
+    int rows = (plane == 0) ? coded_size.height() : (coded_size.height() + 1) / 2;
+    int expected_row_bytes =
+        (plane == 0 ? coded_size.width() : ((coded_size.width() + 1) & ~1)) * bpp;
+    int row_bytes = std::min({expected_row_bytes, src_stride, dst_stride});
+    for (int y = 0; y < rows; ++y) {
+      std::memcpy(dst + y * dst_stride, src + y * src_stride, row_bytes);
+    }
+  }
+
+  video_frame->set_color_space(color_space);
+  video_frame->set_hdr_metadata(config_.hdr_metadata());
+  video_frame->metadata().power_efficient = true;
+  av_frame_free(&sw_frame);
+  DrainPendingEmits(/*wait_all=*/true);
+  output_cb_.Run(std::move(video_frame));
+  return true;
+}
+
+void VulkanVideoDecoder::OnFrameConverted(scoped_refptr<VideoFrame> frame) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (frame && output_cb_) {
+    output_cb_.Run(std::move(frame));
+  }
+}
+
+void VulkanVideoDecoder::Reset(base::OnceClosure closure) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DiscardPendingEmits();
+  if (frame_converter_) {
+    frame_converter_->AbortPendingFrames();
+  }
+  if (codec_context_) {
+    avcodec_flush_buffers(codec_context_.get());
+  }
+  eos_reached_ = false;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                           std::move(closure));
+}
