+NO_SANITIZE("cfi") __attribute__((noinline))
+bool CreateCopyCmdResources(AVVulkanDeviceContext* vk_dev,
+                            const VkCopyInfo& info,
+                            VkCommandPool* pool_out,
+                            VkCommandBuffer* buf_out,
+                            VkFence* fence_out) {
+  if (!vk_dev || !vk_dev->act_dev || !info.procs_ready) {
+    return false;
+  }
+  const auto& p = info.procs;
+  VkCommandPoolCreateInfo cpci{
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT |
+               VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+      .queueFamilyIndex = info.copy_queue_family,
+  };
+  VkCommandPool pool = VK_NULL_HANDLE;
+  if (p.vkCreateCommandPool(vk_dev->act_dev, &cpci, nullptr, &pool) !=
+      VK_SUCCESS) {
+    return false;
+  }
+
+  VkCommandBufferAllocateInfo cbai{
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+  };
+  VkCommandBuffer cb = VK_NULL_HANDLE;
+  if (p.vkAllocateCommandBuffers(vk_dev->act_dev, &cbai, &cb) != VK_SUCCESS) {
+    p.vkDestroyCommandPool(vk_dev->act_dev, pool, nullptr);
+    return false;
+  }
+
+  VkFenceCreateInfo fci{.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkFence fence = VK_NULL_HANDLE;
+  if (p.vkCreateFence(vk_dev->act_dev, &fci, nullptr, &fence) != VK_SUCCESS) {
+    p.vkDestroyCommandPool(vk_dev->act_dev, pool, nullptr);
+    return false;
+  }
+
+  *pool_out = pool;
+  *buf_out = cb;
+  *fence_out = fence;
+  return true;
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+void DestroyCopyCmdResources(AVVulkanDeviceContext* vk_dev,
+                             const VkCopyProcs& procs,
+                             VkCommandPool pool,
+                             VkFence fence) {
+  if (!vk_dev || !vk_dev->act_dev) {
+    return;
+  }
+  if (fence != VK_NULL_HANDLE && procs.vkDestroyFence) {
+    procs.vkDestroyFence(vk_dev->act_dev, fence, nullptr);
+  }
+  if (pool != VK_NULL_HANDLE && procs.vkDestroyCommandPool) {
+    procs.vkDestroyCommandPool(vk_dev->act_dev, pool, nullptr);
+  }
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+VkResult GetFenceStatus(AVVulkanDeviceContext* vk_dev,
+                        const VkCopyProcs& procs,
+                        VkFence fence) {
+  if (!vk_dev || !vk_dev->act_dev || fence == VK_NULL_HANDLE ||
+      !procs.vkGetFenceStatus) {
+    return VK_ERROR_INITIALIZATION_FAILED;
+  }
+  return procs.vkGetFenceStatus(vk_dev->act_dev, fence);
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+VkResult WaitForFence(AVVulkanDeviceContext* vk_dev,
+                      const VkCopyProcs& procs,
+                      VkFence fence,
+                      uint64_t timeout_ns) {
+  if (!vk_dev || !vk_dev->act_dev || fence == VK_NULL_HANDLE ||
+      !procs.vkWaitForFences) {
+    return VK_ERROR_INITIALIZATION_FAILED;
+  }
+  return procs.vkWaitForFences(vk_dev->act_dev, 1, &fence, VK_TRUE,
+                               timeout_ns);
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+void CleanupVkImageMemory(AVVulkanDeviceContext* vk_dev,
+                          const VkCopyProcs& procs,
+                          VkImage img,
+                          VkDeviceMemory mem) {
+  if (!vk_dev || !vk_dev->act_dev) {
+    return;
+  }
+  if (img != VK_NULL_HANDLE && procs.vkDestroyImage) {
+    procs.vkDestroyImage(vk_dev->act_dev, img, nullptr);
+  }
+  if (mem != VK_NULL_HANDLE && procs.vkFreeMemory) {
+    procs.vkFreeMemory(vk_dev->act_dev, mem, nullptr);
+  }
+}
