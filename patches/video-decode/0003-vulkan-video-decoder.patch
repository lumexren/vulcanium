+NO_SANITIZE("cfi") __attribute__((noinline))
+void InitCopyInfo(AVVulkanDeviceContext* vk_dev, VkCopyInfo* info) {
+  if (!vk_dev || !vk_dev->act_dev || !vk_dev->phys_dev || !vk_dev->inst ||
+      !vk_dev->get_proc_addr) {
+    return;
+  }
+
+  auto vk_get_dev_proc = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+      vk_dev->get_proc_addr(vk_dev->inst, "vkGetDeviceProcAddr"));
+  if (!vk_get_dev_proc) {
+    return;
+  }
+
+#define LOAD_DEV_PROC(name)                               \
+  info->procs.name = reinterpret_cast<PFN_##name>(        \
+      vk_get_dev_proc(vk_dev->act_dev, #name))
+  LOAD_DEV_PROC(vkCreateImage);
+  LOAD_DEV_PROC(vkDestroyImage);
+  LOAD_DEV_PROC(vkGetImageMemoryRequirements);
+  LOAD_DEV_PROC(vkGetImageMemoryRequirements2);
+  LOAD_DEV_PROC(vkAllocateMemory);
+  LOAD_DEV_PROC(vkFreeMemory);
+  LOAD_DEV_PROC(vkBindImageMemory);
+  LOAD_DEV_PROC(vkBindImageMemory2);
+  LOAD_DEV_PROC(vkGetImageSubresourceLayout);
+  LOAD_DEV_PROC(vkGetMemoryFdKHR);
+  LOAD_DEV_PROC(vkGetMemoryFdPropertiesKHR);
+  LOAD_DEV_PROC(vkCreateCommandPool);
+  LOAD_DEV_PROC(vkDestroyCommandPool);
+  LOAD_DEV_PROC(vkResetCommandPool);
+  LOAD_DEV_PROC(vkAllocateCommandBuffers);
+  LOAD_DEV_PROC(vkBeginCommandBuffer);
+  LOAD_DEV_PROC(vkEndCommandBuffer);
+  LOAD_DEV_PROC(vkCmdPipelineBarrier);
+  LOAD_DEV_PROC(vkCmdCopyImage);
+  LOAD_DEV_PROC(vkCreateFence);
+  LOAD_DEV_PROC(vkDestroyFence);
+  LOAD_DEV_PROC(vkResetFences);
+  LOAD_DEV_PROC(vkGetFenceStatus);
+  LOAD_DEV_PROC(vkWaitForFences);
+  LOAD_DEV_PROC(vkQueueSubmit);
+  LOAD_DEV_PROC(vkGetDeviceQueue);
+  LOAD_DEV_PROC(vkGetImageDrmFormatModifierPropertiesEXT);
+#undef LOAD_DEV_PROC
+
+  if (!info->procs.vkGetImageMemoryRequirements2) {
+    info->procs.vkGetImageMemoryRequirements2 =
+        reinterpret_cast<PFN_vkGetImageMemoryRequirements2>(
+            vk_get_dev_proc(vk_dev->act_dev, "vkGetImageMemoryRequirements2KHR"));
+  }
+  if (!info->procs.vkBindImageMemory2) {
+    info->procs.vkBindImageMemory2 =
+        reinterpret_cast<PFN_vkBindImageMemory2>(
+            vk_get_dev_proc(vk_dev->act_dev, "vkBindImageMemory2KHR"));
+  }
+
+#define LOAD_INST_PROC(name)                              \
+  info->procs.name = reinterpret_cast<PFN_##name>(        \
+      vk_dev->get_proc_addr(vk_dev->inst, #name))
+  LOAD_INST_PROC(vkGetPhysicalDeviceMemoryProperties);
+  LOAD_INST_PROC(vkEnumerateDeviceExtensionProperties);
+  LOAD_INST_PROC(vkGetPhysicalDeviceVideoCapabilitiesKHR);
+  LOAD_INST_PROC(vkGetPhysicalDeviceFormatProperties2);
+  LOAD_INST_PROC(vkGetPhysicalDeviceImageFormatProperties2);
+#undef LOAD_INST_PROC
+
+  if (!info->procs.vkGetPhysicalDeviceFormatProperties2) {
+    info->procs.vkGetPhysicalDeviceFormatProperties2 =
+        reinterpret_cast<PFN_vkGetPhysicalDeviceFormatProperties2>(
+            vk_dev->get_proc_addr(vk_dev->inst,
+                                  "vkGetPhysicalDeviceFormatProperties2KHR"));
+  }
+  if (!info->procs.vkGetPhysicalDeviceImageFormatProperties2) {
+    info->procs.vkGetPhysicalDeviceImageFormatProperties2 =
+        reinterpret_cast<PFN_vkGetPhysicalDeviceImageFormatProperties2>(
+            vk_dev->get_proc_addr(
+                vk_dev->inst, "vkGetPhysicalDeviceImageFormatProperties2KHR"));
+  }
+
+  const auto& p = info->procs;
+  if (!p.vkCreateImage || !p.vkDestroyImage ||
+      !p.vkGetImageMemoryRequirements || !p.vkAllocateMemory ||
+      !p.vkFreeMemory || !p.vkBindImageMemory ||
+      !p.vkGetImageSubresourceLayout || !p.vkGetMemoryFdKHR ||
+      !p.vkCreateCommandPool || !p.vkDestroyCommandPool ||
+      !p.vkResetCommandPool || !p.vkAllocateCommandBuffers ||
+      !p.vkBeginCommandBuffer || !p.vkEndCommandBuffer ||
+      !p.vkCmdPipelineBarrier || !p.vkCmdCopyImage || !p.vkCreateFence ||
+      !p.vkDestroyFence || !p.vkResetFences || !p.vkGetFenceStatus ||
+      !p.vkWaitForFences || !p.vkQueueSubmit || !p.vkGetDeviceQueue ||
+      !p.vkGetPhysicalDeviceMemoryProperties) {
+    return;
+  }
+
+  p.vkGetPhysicalDeviceMemoryProperties(vk_dev->phys_dev, &info->mem_props);
+
+  uint32_t qf =
+      vk_dev->nb_qf > 0 ? static_cast<uint32_t>(vk_dev->qf[0].idx) : 0u;
+  bool dedicated_transfer = false;
+  for (int qi = 0; qi < vk_dev->nb_qf; ++qi) {
+    const VkQueueFlags flags = vk_dev->qf[qi].flags;
+    if ((flags & VK_QUEUE_TRANSFER_BIT) &&
+        !(flags & VK_QUEUE_GRAPHICS_BIT)) {
+      qf = static_cast<uint32_t>(vk_dev->qf[qi].idx);
+      dedicated_transfer = true;
+      break;
+    }
+  }
+  if (!dedicated_transfer) {
+    for (int qi = 0; qi < vk_dev->nb_qf; ++qi) {
+      const VkQueueFlags flags = vk_dev->qf[qi].flags;
+      if (flags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_TRANSFER_BIT)) {
+        qf = static_cast<uint32_t>(vk_dev->qf[qi].idx);
+        if (flags & VK_QUEUE_GRAPHICS_BIT) {
+          break;
+        }
+      }
+    }
+  }
+  info->copy_queue_family = qf;
+  info->copy_queue_is_dedicated_transfer = dedicated_transfer;
+
+  info->preferred_nv12_modifiers.clear();
+  if (p.vkGetPhysicalDeviceFormatProperties2 && vk_dev->phys_dev) {
+    VkDrmFormatModifierPropertiesListEXT mod_list{
+        .sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT,
+    };
+    VkFormatProperties2 fmt_props{
+        .sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2,
+        .pNext = &mod_list,
+    };
+    p.vkGetPhysicalDeviceFormatProperties2(
+        vk_dev->phys_dev, VK_FORMAT_G8_B8R8_2PLANE_420_UNORM, &fmt_props);
+    if (mod_list.drmFormatModifierCount > 0) {
+      std::vector<VkDrmFormatModifierPropertiesEXT> mod_props(
+          mod_list.drmFormatModifierCount);
+      mod_list.pDrmFormatModifierProperties = mod_props.data();
+      p.vkGetPhysicalDeviceFormatProperties2(
+          vk_dev->phys_dev, VK_FORMAT_G8_B8R8_2PLANE_420_UNORM, &fmt_props);
+
+      constexpr VkFormatFeatureFlags kRequiredFeatures =
+          VK_FORMAT_FEATURE_TRANSFER_DST_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+      bool linear_supported = false;
+      for (const auto& mp : mod_props) {
+        if (mp.drmFormatModifierPlaneCount != 2 ||
+            (mp.drmFormatModifierTilingFeatures & kRequiredFeatures) !=
+                kRequiredFeatures) {
+          continue;
+        }
+        bool exportable = true;
+        if (p.vkGetPhysicalDeviceImageFormatProperties2) {
+          VkPhysicalDeviceImageDrmFormatModifierInfoEXT mod_info{
+              .sType =
+                  VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_DRM_FORMAT_MODIFIER_INFO_EXT,
+              .drmFormatModifier = mp.drmFormatModifier,
+              .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+          };
+          VkPhysicalDeviceExternalImageFormatInfo ext_info{
+              .sType =
+                  VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO,
+              .pNext = &mod_info,
+              .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+          };
+          VkPhysicalDeviceImageFormatInfo2 img_info{
+              .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+              .pNext = &ext_info,
+              .format = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM,
+              .type = VK_IMAGE_TYPE_2D,
+              .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+              .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                       VK_IMAGE_USAGE_SAMPLED_BIT,
+          };
+          VkExternalImageFormatProperties ext_props{
+              .sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
+          };
+          VkImageFormatProperties2 img_props{
+              .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2,
+              .pNext = &ext_props,
+          };
+          VkResult res = p.vkGetPhysicalDeviceImageFormatProperties2(
+              vk_dev->phys_dev, &img_info, &img_props);
+          exportable =
+              (res == VK_SUCCESS) &&
+              ((ext_props.externalMemoryProperties.externalMemoryFeatures &
+                VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT) != 0);
+        }
+        if (!exportable) {
+          continue;
+        }
+        if (mp.drmFormatModifier == DRM_FORMAT_MOD_LINEAR) {
+          linear_supported = true;
+        } else {
+          info->preferred_nv12_modifiers.push_back(mp.drmFormatModifier);
+        }
+      }
+      if (linear_supported) {
+        info->preferred_nv12_modifiers.push_back(DRM_FORMAT_MOD_LINEAR);
+      }
+    }
+  }
+
+  VLOG(1) << "VulkanVideoDevice copy queue family=" << info->copy_queue_family
+          << " dedicated_transfer=" << info->copy_queue_is_dedicated_transfer
+          << " preferred_nv12_modifiers="
+          << info->preferred_nv12_modifiers.size()
+          << " first_mod=0x" << std::hex
+          << (info->preferred_nv12_modifiers.empty()
+                  ? 0ULL
+                  : info->preferred_nv12_modifiers.front())
+          << std::dec;
+  info->procs_ready = true;
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+CodecCapability QueryProfileCap(
+    AVVulkanDeviceContext* vk_dev,
+    const VkCopyProcs& procs,
+    VkVideoCodecOperationFlagBitsKHR op,
+    const void* profile_pnext,
+    void* caps_pnext,
+    VkVideoComponentBitDepthFlagBitsKHR bit_depth =
+        VK_VIDEO_COMPONENT_BIT_DEPTH_8_BIT_KHR) {
+  CodecCapability out;
+  if (!vk_dev || !vk_dev->phys_dev ||
+      !procs.vkGetPhysicalDeviceVideoCapabilitiesKHR) {
+    return out;
+  }
+
+  VkVideoProfileInfoKHR profile{
+      .sType = VK_STRUCTURE_TYPE_VIDEO_PROFILE_INFO_KHR,
+      .pNext = profile_pnext,
+      .videoCodecOperation = op,
+      .chromaSubsampling = VK_VIDEO_CHROMA_SUBSAMPLING_420_BIT_KHR,
+      .lumaBitDepth = bit_depth,
+      .chromaBitDepth = bit_depth,
+  };
+  VkVideoCapabilitiesKHR vk_caps{
+      .sType = VK_STRUCTURE_TYPE_VIDEO_CAPABILITIES_KHR,
+      .pNext = caps_pnext,
+  };
+  VkResult res = procs.vkGetPhysicalDeviceVideoCapabilitiesKHR(
+      vk_dev->phys_dev, &profile, &vk_caps);
+  if (res != VK_SUCCESS || vk_caps.maxCodedExtent.width == 0 ||
+      vk_caps.maxCodedExtent.height == 0) {
+    return out;
+  }
+
+  out.supported = true;
+  out.min_size = gfx::Size(
+      static_cast<int>(std::max(16u, vk_caps.minCodedExtent.width)),
+      static_cast<int>(std::max(16u, vk_caps.minCodedExtent.height)));
+  out.max_size = gfx::Size(static_cast<int>(vk_caps.maxCodedExtent.width),
+                           static_cast<int>(vk_caps.maxCodedExtent.height));
+  return out;
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+void ProbeVideoCapabilities(AVVulkanDeviceContext* vk_dev,
+                            const VkCopyProcs& procs,
+                            VulkanVideoCapabilities* caps) {
+  caps->probed = true;
+  if (!vk_dev || !vk_dev->phys_dev ||
+      !procs.vkEnumerateDeviceExtensionProperties ||
+      !procs.vkGetPhysicalDeviceVideoCapabilitiesKHR) {
+    return;
+  }
+
+  uint32_t ext_count = 0;
+  if (procs.vkEnumerateDeviceExtensionProperties(
+          vk_dev->phys_dev, nullptr, &ext_count, nullptr) != VK_SUCCESS ||
+      ext_count == 0) {
+    return;
+  }
+  std::vector<VkExtensionProperties> exts(ext_count);
+  if (procs.vkEnumerateDeviceExtensionProperties(
+          vk_dev->phys_dev, nullptr, &ext_count, exts.data()) != VK_SUCCESS) {
+    return;
+  }
+
+  const auto has_ext = [&](const char* name) {
+    const std::string_view target(name);
+    for (uint32_t i = 0; i < ext_count; ++i) {
+      if (std::string_view(exts[i].extensionName) == target) {
+        return true;
+      }
+    }
+    return false;
+  };
+
+  caps->has_decode_queue = has_ext(VK_KHR_VIDEO_DECODE_QUEUE_EXTENSION_NAME);
+  caps->has_encode_queue = has_ext(VK_KHR_VIDEO_ENCODE_QUEUE_EXTENSION_NAME);
+
+  if (caps->has_decode_queue) {
+    if (has_ext(VK_KHR_VIDEO_DECODE_H264_EXTENSION_NAME)) {
+      VkVideoDecodeH264ProfileInfoKHR p{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_PROFILE_INFO_KHR,
+          .stdProfileIdc = STD_VIDEO_H264_PROFILE_IDC_HIGH,
+          .pictureLayout = VK_VIDEO_DECODE_H264_PICTURE_LAYOUT_PROGRESSIVE_KHR,
+      };
+      VkVideoDecodeH264CapabilitiesKHR h264_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_CAPABILITIES_KHR,
+      };
+      VkVideoDecodeCapabilitiesKHR dec_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR,
+          .pNext = &h264_caps,
+      };
+      caps->decode_h264 = QueryProfileCap(
+          vk_dev, procs, VK_VIDEO_CODEC_OPERATION_DECODE_H264_BIT_KHR, &p,
+          &dec_caps);
+    }
+    if (has_ext(VK_KHR_VIDEO_DECODE_H265_EXTENSION_NAME)) {
+      VkVideoDecodeH265ProfileInfoKHR p{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_PROFILE_INFO_KHR,
+          .stdProfileIdc = STD_VIDEO_H265_PROFILE_IDC_MAIN,
+      };
+      VkVideoDecodeH265CapabilitiesKHR h265_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_CAPABILITIES_KHR,
+      };
+      VkVideoDecodeCapabilitiesKHR dec_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR,
+          .pNext = &h265_caps,
+      };
+      caps->decode_hevc = QueryProfileCap(
+          vk_dev, procs, VK_VIDEO_CODEC_OPERATION_DECODE_H265_BIT_KHR, &p,
+          &dec_caps);
+
+      VkVideoDecodeH265ProfileInfoKHR p10{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_PROFILE_INFO_KHR,
+          .stdProfileIdc = STD_VIDEO_H265_PROFILE_IDC_MAIN_10,
+      };
+      VkVideoDecodeH265CapabilitiesKHR h265_caps10{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_CAPABILITIES_KHR,
+      };
+      VkVideoDecodeCapabilitiesKHR dec_caps10{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR,
+          .pNext = &h265_caps10,
+      };
+      caps->decode_hevc_10bit = QueryProfileCap(
+          vk_dev, procs, VK_VIDEO_CODEC_OPERATION_DECODE_H265_BIT_KHR, &p10,
+          &dec_caps10, VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR);
+    }
+    if (has_ext(VK_KHR_VIDEO_DECODE_VP9_EXTENSION_NAME)) {
+      VkVideoDecodeVP9ProfileInfoKHR p{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_PROFILE_INFO_KHR,
+          .stdProfile = STD_VIDEO_VP9_PROFILE_0,
+      };
+      VkVideoDecodeVP9CapabilitiesKHR vp9_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_CAPABILITIES_KHR,
+      };
+      VkVideoDecodeCapabilitiesKHR dec_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR,
+          .pNext = &vp9_caps,
+      };
+      caps->decode_vp9 = QueryProfileCap(
+          vk_dev, procs, VK_VIDEO_CODEC_OPERATION_DECODE_VP9_BIT_KHR, &p,
+          &dec_caps);
+
+      VkVideoDecodeVP9ProfileInfoKHR p10{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_PROFILE_INFO_KHR,
+          .stdProfile = STD_VIDEO_VP9_PROFILE_2,
+      };
+      VkVideoDecodeVP9CapabilitiesKHR vp9_caps10{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_CAPABILITIES_KHR,
+      };
+      VkVideoDecodeCapabilitiesKHR dec_caps10{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR,
+          .pNext = &vp9_caps10,
+      };
+      caps->decode_vp9_10bit = QueryProfileCap(
+          vk_dev, procs, VK_VIDEO_CODEC_OPERATION_DECODE_VP9_BIT_KHR, &p10,
+          &dec_caps10, VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR);
+    }
+    if (has_ext(VK_KHR_VIDEO_DECODE_AV1_EXTENSION_NAME)) {
+      VkVideoDecodeAV1ProfileInfoKHR p{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_PROFILE_INFO_KHR,
+          .stdProfile = STD_VIDEO_AV1_PROFILE_MAIN,
+          .filmGrainSupport = VK_FALSE,
+      };
+      VkVideoDecodeAV1CapabilitiesKHR av1_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_CAPABILITIES_KHR,
+      };
+      VkVideoDecodeCapabilitiesKHR dec_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR,
+          .pNext = &av1_caps,
+      };
+      caps->decode_av1 = QueryProfileCap(
+          vk_dev, procs, VK_VIDEO_CODEC_OPERATION_DECODE_AV1_BIT_KHR, &p,
+          &dec_caps);
+
+      VkVideoDecodeAV1CapabilitiesKHR av1_caps10{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_CAPABILITIES_KHR,
+      };
+      VkVideoDecodeCapabilitiesKHR dec_caps10{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR,
+          .pNext = &av1_caps10,
+      };
+      caps->decode_av1_10bit = QueryProfileCap(
+          vk_dev, procs, VK_VIDEO_CODEC_OPERATION_DECODE_AV1_BIT_KHR, &p,
+          &dec_caps10, VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR);
+    }
+  }
+
+  if (caps->has_encode_queue) {
+    if (has_ext(VK_KHR_VIDEO_ENCODE_H264_EXTENSION_NAME)) {
+      VkVideoEncodeH264ProfileInfoKHR p{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_PROFILE_INFO_KHR,
+          .stdProfileIdc = STD_VIDEO_H264_PROFILE_IDC_HIGH,
+      };
+      VkVideoEncodeH264CapabilitiesKHR h264_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_CAPABILITIES_KHR,
+      };
+      VkVideoEncodeCapabilitiesKHR enc_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_CAPABILITIES_KHR,
+          .pNext = &h264_caps,
+      };
+      caps->encode_h264 = QueryProfileCap(
+          vk_dev, procs, VK_VIDEO_CODEC_OPERATION_ENCODE_H264_BIT_KHR, &p,
+          &enc_caps);
+    }
+    if (has_ext(VK_KHR_VIDEO_ENCODE_H265_EXTENSION_NAME)) {
+      VkVideoEncodeH265ProfileInfoKHR p{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_PROFILE_INFO_KHR,
+          .stdProfileIdc = STD_VIDEO_H265_PROFILE_IDC_MAIN,
+      };
+      VkVideoEncodeH265CapabilitiesKHR h265_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_CAPABILITIES_KHR,
+      };
+      VkVideoEncodeCapabilitiesKHR enc_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_CAPABILITIES_KHR,
+          .pNext = &h265_caps,
+      };
+      caps->encode_hevc = QueryProfileCap(
+          vk_dev, procs, VK_VIDEO_CODEC_OPERATION_ENCODE_H265_BIT_KHR, &p,
+          &enc_caps);
+    }
+    if (has_ext(VK_KHR_VIDEO_ENCODE_AV1_EXTENSION_NAME)) {
+      VkVideoEncodeAV1ProfileInfoKHR p{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_AV1_PROFILE_INFO_KHR,
+          .stdProfile = STD_VIDEO_AV1_PROFILE_MAIN,
+      };
+      VkVideoEncodeAV1CapabilitiesKHR av1_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_AV1_CAPABILITIES_KHR,
+      };
+      VkVideoEncodeCapabilitiesKHR enc_caps{
+          .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_CAPABILITIES_KHR,
+          .pNext = &av1_caps,
+      };
+      caps->encode_av1 = QueryProfileCap(
+          vk_dev, procs, VK_VIDEO_CODEC_OPERATION_ENCODE_AV1_BIT_KHR, &p,
+          &enc_caps);
+    }
+  }
+
+  VLOG(1) << "VulkanVideoDevice probed capabilities: decode(h264="
+          << caps->decode_h264.supported << " "
+          << caps->decode_h264.max_size.ToString()
+          << ", hevc=" << caps->decode_hevc.supported << " "
+          << caps->decode_hevc.max_size.ToString()
+          << ", hevc10=" << caps->decode_hevc_10bit.supported << " "
+          << caps->decode_hevc_10bit.max_size.ToString()
+          << ", vp9=" << caps->decode_vp9.supported << " "
+          << caps->decode_vp9.max_size.ToString()
+          << ", vp9_10=" << caps->decode_vp9_10bit.supported << " "
+          << caps->decode_vp9_10bit.max_size.ToString()
+          << ", av1=" << caps->decode_av1.supported << " "
+          << caps->decode_av1.max_size.ToString()
+          << ", av1_10=" << caps->decode_av1_10bit.supported << " "
+          << caps->decode_av1_10bit.max_size.ToString()
+          << ") encode(h264=" << caps->encode_h264.supported << " "
+          << caps->encode_h264.max_size.ToString()
+          << ", hevc=" << caps->encode_hevc.supported << " "
+          << caps->encode_hevc.max_size.ToString()
+          << ", av1=" << caps->encode_av1.supported << " "
+          << caps->encode_av1.max_size.ToString() << ")";
+}
