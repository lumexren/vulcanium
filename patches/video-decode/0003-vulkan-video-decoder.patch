+class SlotSyncState : public base::RefCountedThreadSafe<SlotSyncState> {
+ public:
+  SlotSyncState() = default;
+
+  void MarkConverted() {
+    base::AutoLock lock(lock_);
+    ever_converted_ = true;
+    current_emit_converted_ = true;
+  }
+
+  bool WasEverConverted() const {
+    base::AutoLock lock(lock_);
+    return ever_converted_;
+  }
+
+  bool WasCurrentEmitConverted() const {
+    base::AutoLock lock(lock_);
+    return current_emit_converted_;
+  }
+
+  void ResetForReuse() {
+    base::AutoLock lock(lock_);
+    release_sync_tokens_.clear();
+    current_emit_converted_ = false;
+  }
+
+  void SetReleaseSyncTokens(std::vector<gpu::SyncToken> tokens) {
+    base::AutoLock lock(lock_);
+    release_sync_tokens_ = std::move(tokens);
+  }
+
+  std::vector<gpu::SyncToken> GetReleaseSyncTokens() const {
+    base::AutoLock lock(lock_);
+    return release_sync_tokens_;
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<SlotSyncState>;
+  ~SlotSyncState() = default;
+
+  mutable base::Lock lock_;
+  std::vector<gpu::SyncToken> release_sync_tokens_ GUARDED_BY(lock_);
+  bool ever_converted_ GUARDED_BY(lock_) = false;
+  bool current_emit_converted_ GUARDED_BY(lock_) = false;
+};
