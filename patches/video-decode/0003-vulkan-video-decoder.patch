+// Holds a single GPU-process-wide FFmpeg AV_HWDEVICE_TYPE_VULKAN context,
+// resolved Vulkan function pointers, and cached hardware video capabilities so
+// decoders and encoders share one VkDevice and avoid repeated device creation.
+class MEDIA_GPU_EXPORT VulkanVideoDevice {
+ public:
+  static VulkanVideoDevice* GetInstance();
+
+  AVBufferRef* AcquireDevice();
+  const VkCopyInfo* GetCopyInfo() const { return &copy_info_; }
+  const VulkanVideoCapabilities& GetCapabilities();
+  VulkanVramBudget QueryVramBudget();
+  bool TryAcquireDecoderAdmission(uint64_t estimated_bytes,
+                                  int* active_decoders_out = nullptr,
+                                  VulkanVramBudget* budget_out = nullptr);
+  void NotifyDecoderVramAllocated(uint64_t newly_allocated_bytes);
+  void ReleaseDecoderAdmission(uint64_t reserved_bytes,
+                               uint64_t remaining_pending_bytes);
+
+ private:
+  friend class base::NoDestructor<VulkanVideoDevice>;
+  VulkanVideoDevice() = default;
+  ~VulkanVideoDevice() = delete;
+
+  bool EnsureInitializedLocked();
+
+  base::Lock lock_;
+  AVBufferRef* device_ctx_ = nullptr;
+  VkCopyInfo copy_info_;
+  bool copy_info_attempted_ = false;
+  VulkanVideoCapabilities caps_;
+
+  base::Lock admission_lock_;
+  int active_decoders_ = 0;
+  uint64_t total_estimated_vram_bytes_ = 0;
+  uint64_t pending_unallocated_vram_bytes_ = 0;
+};
