+// static
+VulkanVideoDevice* VulkanVideoDevice::GetInstance() {
+  static base::NoDestructor<VulkanVideoDevice> instance;
+  return instance.get();
+}
+
+bool VulkanVideoDevice::EnsureInitializedLocked() {
+  if (!device_ctx_) {
+    int err = av_hwdevice_ctx_create(&device_ctx_, AV_HWDEVICE_TYPE_VULKAN,
+                                     nullptr, nullptr, 0);
+    if (err < 0 || !device_ctx_) {
+      LOG(ERROR) << "VulkanVideoDevice: av_hwdevice_ctx_create failed: "
+                 << AVErrorToString(err);
+      caps_.probed = true;
+      return false;
+    }
+  }
+  if (!copy_info_attempted_) {
+    copy_info_attempted_ = true;
+    auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(device_ctx_->data);
+    auto* vk_dev =
+        dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+    InitCopyInfo(vk_dev, &copy_info_);
+    ProbeVideoCapabilities(vk_dev, copy_info_.procs, &caps_,
+                           &copy_info_.has_memory_budget);
+    VLOG(1) << "VulkanVideoDevice VRAM total="
+            << (copy_info_.total_device_local_vram_bytes / (1024 * 1024))
+            << " MiB has_memory_budget=" << copy_info_.has_memory_budget;
+  }
+  return true;
+}
+
+AVBufferRef* VulkanVideoDevice::AcquireDevice() {
+  base::AutoLock lock(lock_);
+  if (!EnsureInitializedLocked()) {
+    return nullptr;
+  }
+  return av_buffer_ref(device_ctx_);
+}
+
+const VulkanVideoCapabilities& VulkanVideoDevice::GetCapabilities() {
+  base::AutoLock lock(lock_);
+  EnsureInitializedLocked();
+  return caps_;
+}
+
+VulkanVramBudget VulkanVideoDevice::QueryVramBudget() {
+  AVVulkanDeviceContext* vk_dev = nullptr;
+  {
+    base::AutoLock lock(lock_);
+    if (!EnsureInitializedLocked() || !device_ctx_) {
+      return VulkanVramBudget{};
+    }
+    auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(device_ctx_->data);
+    vk_dev =
+        dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+  }
+  return QueryDeviceLocalVramBudget(vk_dev, copy_info_);
+}
+
+bool VulkanVideoDevice::TryAcquireDecoderAdmission(
+    uint64_t estimated_bytes,
+    int* active_decoders_out,
+    VulkanVramBudget* budget_out) {
+  AVVulkanDeviceContext* vk_dev = nullptr;
+  {
+    base::AutoLock lock(lock_);
+    if (!EnsureInitializedLocked() || !device_ctx_) {
+      return false;
+    }
+    auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(device_ctx_->data);
+    vk_dev =
+        dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+    if (!vk_dev) {
+      return false;
+    }
+  }
+
+  base::AutoLock admission_lock(admission_lock_);
+  const VulkanVramBudget budget = QueryDeviceLocalVramBudget(vk_dev, copy_info_);
+  if (budget_out) {
+    *budget_out = budget;
+  }
+  if (active_decoders_ >= GetMaxConcurrentDecodersCap()) {
+    if (active_decoders_out) {
+      *active_decoders_out = active_decoders_;
+    }
+    return false;
+  }
+
+  bool admitted = false;
+  if (budget.live_budget_supported && budget.budget_bytes > 0) {
+    constexpr uint64_t kMinHeadroomBytes = uint64_t{128} * 1024 * 1024;
+    constexpr uint64_t kMaxHeadroomBytes = uint64_t{512} * 1024 * 1024;
+    const uint64_t headroom =
+        budget.total_device_local_bytes > 0
+            ? std::clamp<uint64_t>(budget.total_device_local_bytes / 8,
+                                   kMinHeadroomBytes, kMaxHeadroomBytes)
+            : kMinHeadroomBytes;
+    const uint64_t effective_available =
+        budget.available_bytes > pending_unallocated_vram_bytes_
+            ? budget.available_bytes - pending_unallocated_vram_bytes_
+            : 0ULL;
+    admitted = (effective_available >= estimated_bytes + headroom);
+  } else if (budget.total_device_local_bytes > 0) {
+    const uint64_t max_static_vram =
+        (budget.total_device_local_bytes * 40ULL) / 100ULL;
+    admitted = (total_estimated_vram_bytes_ + estimated_bytes <= max_static_vram);
+  } else {
+    admitted = (active_decoders_ < 8);
+  }
+
+  if (!admitted) {
+    if (active_decoders_out) {
+      *active_decoders_out = active_decoders_;
+    }
+    return false;
+  }
+
+  ++active_decoders_;
+  total_estimated_vram_bytes_ += estimated_bytes;
+  pending_unallocated_vram_bytes_ += estimated_bytes;
+  if (active_decoders_out) {
+    *active_decoders_out = active_decoders_;
+  }
+  return true;
+}
+
+void VulkanVideoDevice::NotifyDecoderVramAllocated(
+    uint64_t newly_allocated_bytes) {
+  base::AutoLock admission_lock(admission_lock_);
+  if (pending_unallocated_vram_bytes_ > newly_allocated_bytes) {
+    pending_unallocated_vram_bytes_ -= newly_allocated_bytes;
+  } else {
+    pending_unallocated_vram_bytes_ = 0;
+  }
+}
+
+void VulkanVideoDevice::ReleaseDecoderAdmission(
+    uint64_t reserved_bytes,
+    uint64_t remaining_pending_bytes) {
+  base::AutoLock admission_lock(admission_lock_);
+  if (active_decoders_ > 0) {
+    --active_decoders_;
+  }
+  if (total_estimated_vram_bytes_ > reserved_bytes) {
+    total_estimated_vram_bytes_ -= reserved_bytes;
+  } else {
+    total_estimated_vram_bytes_ = 0;
+  }
+  if (pending_unallocated_vram_bytes_ > remaining_pending_bytes) {
+    pending_unallocated_vram_bytes_ -= remaining_pending_bytes;
+  } else {
+    pending_unallocated_vram_bytes_ = 0;
+  }
+}
