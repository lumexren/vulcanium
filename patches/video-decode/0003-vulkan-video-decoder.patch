+bool IsLikely10BitConfig(const VideoDecoderConfig& config) {
+  return config.profile() == HEVCPROFILE_MAIN10 ||
+         config.profile() == VP9PROFILE_PROFILE2 ||
+         (config.codec() == VideoCodec::kAV1 &&
+          config.color_space_info().IsHDR());
+}
+
+size_t MaxOutputPoolSizeForFrame(const gfx::Size& coded_size) {
+  const int64_t pixels =
+      int64_t{coded_size.width()} * int64_t{coded_size.height()};
+  if (pixels <= 1920LL * 1088LL) {
+    return 12;
+  }
+  if (pixels <= 2560LL * 1472LL) {
+    return 10;
+  }
+  if (pixels <= 4096LL * 2304LL) {
+    return 8;
+  }
+  return 6;
+}
+
+struct DecoderVramEstimate {
+  uint64_t frame_bytes = 0;
+  uint64_t dpb_bytes = 0;
+  uint64_t pool_bytes = 0;
+  uint64_t total_bytes() const { return dpb_bytes + pool_bytes; }
+};
+
+DecoderVramEstimate EstimateDecoderSessionVram(
+    const VideoDecoderConfig& config) {
+  gfx::Size size = config.coded_size();
+  if (size.IsEmpty()) {
+    size = config.visible_rect().size();
+  }
+  if (size.IsEmpty()) {
+    size = gfx::Size(1920, 1080);
+  }
+  const uint64_t aligned_w =
+      static_cast<uint64_t>((std::max(16, size.width()) + 63) & ~63);
+  const uint64_t aligned_h =
+      static_cast<uint64_t>((std::max(16, size.height()) + 63) & ~63);
+  const bool is_10bit = IsLikely10BitConfig(config);
+  const uint64_t frame_bytes =
+      is_10bit ? (aligned_w * aligned_h * 3ULL)
+               : ((aligned_w * aligned_h * 3ULL) / 2ULL);
+
+  uint64_t dpb_frames = 16;
+  switch (config.codec()) {
+    case VideoCodec::kH264:
+    case VideoCodec::kHEVC:
+      dpb_frames = 20;
+      break;
+    case VideoCodec::kVP9:
+    case VideoCodec::kAV1:
+      dpb_frames = 13;
+      break;
+    default:
+      dpb_frames = 16;
+      break;
+  }
+
+  constexpr uint64_t kSessionOverheadBytes = 16ULL * 1024ULL * 1024ULL;
+  DecoderVramEstimate est;
+  est.frame_bytes = frame_bytes;
+  est.dpb_bytes = dpb_frames * frame_bytes + kSessionOverheadBytes;
+  est.pool_bytes =
+      static_cast<uint64_t>(MaxOutputPoolSizeForFrame(size)) * frame_bytes;
+  return est;
+}
