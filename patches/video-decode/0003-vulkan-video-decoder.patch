+enum AVPixelFormat GetVulkanHwFormat(AVCodecContext* ctx,
+                                     const enum AVPixelFormat* pix_fmts) {
+  for (const enum AVPixelFormat* p = pix_fmts; *p != AV_PIX_FMT_NONE; ++p) {
+    if (*p == AV_PIX_FMT_VULKAN) {
+      return *p;
+    }
+  }
+  return AV_PIX_FMT_NONE;
+}
+
+}  // namespace
+
+// static
+SupportedVideoDecoderConfigs VulkanVideoDecoder::GetSupportedConfigs() {
+  return {
+      {H264PROFILE_MIN, H264PROFILE_MAX, gfx::Size(64, 64),
+       gfx::Size(4096, 4096), /*allow_encrypted=*/false,
+       /*require_encrypted=*/false},
+      {HEVCPROFILE_MIN, HEVCPROFILE_MAX, gfx::Size(64, 64),
+       gfx::Size(8192, 8192), /*allow_encrypted=*/false,
+       /*require_encrypted=*/false},
+      {VP9PROFILE_MIN, VP9PROFILE_MAX, gfx::Size(64, 64),
+       gfx::Size(8192, 8192), /*allow_encrypted=*/false,
+       /*require_encrypted=*/false},
+      {AV1PROFILE_MIN, AV1PROFILE_MAX, gfx::Size(64, 64),
+       gfx::Size(8192, 8192), /*allow_encrypted=*/false,
+       /*require_encrypted=*/false},
+  };
+}
+
+// static
+bool VulkanVideoDecoder::IsSupported(const VideoDecoderConfig& config) {
+  if (config.is_encrypted()) {
+    return false;
+  }
+  switch (config.codec()) {
+    case VideoCodec::kH264:
+    case VideoCodec::kHEVC:
+    case VideoCodec::kAV1:
+    case VideoCodec::kVP9:
+      return true;
+    default:
+      return false;
+  }
+}
+
+VulkanVideoDecoder::VulkanVideoDecoder(std::unique_ptr<MediaLog> media_log)
+    : media_log_(std::move(media_log)) {}
+
+VulkanVideoDecoder::~VulkanVideoDecoder() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ReleaseResources();
+}
+
+VideoDecoderType VulkanVideoDecoder::GetDecoderType() const {
+  return VideoDecoderType::kFFmpeg;
+}
+
+void VulkanVideoDecoder::Initialize(const VideoDecoderConfig& config,
+                                    bool low_delay,
+                                    CdmContext* cdm_context,
+                                    InitCB init_cb,
+                                    const OutputCB& output_cb,
+                                    const WaitingCB& waiting_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  InitCB bound_init_cb = base::BindPostTaskToCurrentDefault(std::move(init_cb));
+
+  if (!IsSupported(config) || !ConfigureVulkanDecoder(config)) {
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kUnsupportedConfig);
+    return;
+  }
+
+  config_ = config;
+  output_cb_ = output_cb;
+  initialized_ = true;
+  eos_reached_ = false;
+  std::move(bound_init_cb).Run(DecoderStatus::Codes::kOk);
+}
+
+bool VulkanVideoDecoder::ConfigureVulkanDecoder(
+    const VideoDecoderConfig& config) {
+  ReleaseResources();
+
+  int err = av_hwdevice_ctx_create(&hw_device_ctx_, AV_HWDEVICE_TYPE_VULKAN,
+                                   nullptr, nullptr, 0);
+  if (err < 0 || !hw_device_ctx_) {
+    LOG(ERROR) << "VulkanVideoDecoder: av_hwdevice_ctx_create failed: "
+               << AVErrorToString(err);
+    return false;
+  }
+
+  codec_context_.reset(avcodec_alloc_context3(nullptr));
+  if (!codec_context_) {
+    ReleaseResources();
+    return false;
+  }
+
+  VideoDecoderConfigToAVCodecContext(config, codec_context_.get());
+  av_freep(&codec_context_->codec_whitelist);
+  codec_context_->codec_whitelist = av_strdup("h264,hevc,vp9,av1");
+  codec_context_->hw_device_ctx = av_buffer_ref(hw_device_ctx_);
+  codec_context_->get_format = GetVulkanHwFormat;
+  codec_context_->pkt_timebase = AVRational{1, 1000000};
+
+  const AVCodec* codec = avcodec_find_decoder(codec_context_->codec_id);
+  if (!codec) {
+    LOG(ERROR) << "VulkanVideoDecoder: avcodec_find_decoder failed for codec "
+               << GetCodecName(config.codec());
+    ReleaseResources();
+    return false;
+  }
+  err = avcodec_open2(codec_context_.get(), codec, nullptr);
+  if (err < 0) {
+    LOG(ERROR) << "VulkanVideoDecoder: avcodec_open2 failed for codec "
+               << GetCodecName(config.codec()) << ": " << AVErrorToString(err);
+    ReleaseResources();
+    return false;
+  }
+  LOG(WARNING) << "VulkanVideoDecoder: initialized " << codec->name
+               << " for " << GetCodecName(config.codec());
+
+  return true;
+}
+
+void VulkanVideoDecoder::ReleaseResources() {
+  codec_context_.reset();
+  if (hw_device_ctx_) {
+    av_buffer_unref(&hw_device_ctx_);
+    hw_device_ctx_ = nullptr;
+  }
+  initialized_ = false;
+}
+
+void VulkanVideoDecoder::Decode(scoped_refptr<DecoderBuffer> buffer,
+                                DecodeCB decode_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DecodeCB bound_cb = base::BindPostTaskToCurrentDefault(std::move(decode_cb));
+
+  if (!initialized_ || !codec_context_) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+    return;
+  }
+  if (eos_reached_) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kOk);
+    return;
+  }
+
+  AVPacket* packet = av_packet_alloc();
+  if (!packet) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kOutOfMemory);
+    return;
+  }
+
+  if (buffer->end_of_stream()) {
+    packet->data = nullptr;
+    packet->size = 0;
+  } else {
+    auto span = base::span(*buffer);
+    packet->data = const_cast<uint8_t*>(span.data());
+    packet->size = base::checked_cast<int>(span.size());
+    packet->pts =
+        ConvertToTimeBase(codec_context_->pkt_timebase, buffer->timestamp());
+  }
+
+  int ret = avcodec_send_packet(codec_context_.get(), packet);
+  av_packet_free(&packet);
+  if (ret < 0 && ret != AVERROR_EOF) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+    return;
+  }
+
+  AVFrame* hw_frame = av_frame_alloc();
+  if (!hw_frame) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kOutOfMemory);
+    return;
+  }
+
+  while (true) {
+    ret = avcodec_receive_frame(codec_context_.get(), hw_frame);
+    if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) {
+      break;
+    }
+    if (ret < 0) {
+      av_frame_free(&hw_frame);
+      std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+      return;
+    }
+    if (!EmitFrame(hw_frame)) {
+      av_frame_unref(hw_frame);
+      av_frame_free(&hw_frame);
+      std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+      return;
+    }
+    av_frame_unref(hw_frame);
+  }
+
+  av_frame_free(&hw_frame);
+  if (buffer->end_of_stream()) {
+    eos_reached_ = true;
+  }
+  std::move(bound_cb).Run(DecoderStatus::Codes::kOk);
+}
+
+NO_SANITIZE("cfi-icall")
+scoped_refptr<VideoFrame> TryGpuCopyVkFrameToDmabuf(AVFrame* hw_frame,
+                                                    base::TimeDelta pts) {
+  if (!hw_frame || !hw_frame->hw_frames_ctx) {
+    return nullptr;
+  }
+  auto* frames_ctx =
+      reinterpret_cast<AVHWFramesContext*>(hw_frame->hw_frames_ctx->data);
+  if (!frames_ctx || !frames_ctx->device_ctx || !frames_ctx->device_ctx->hwctx) {
+    return nullptr;
+  }
+  auto* vk_dev =
+      static_cast<AVVulkanDeviceContext*>(frames_ctx->device_ctx->hwctx);
+  auto* src_vk = reinterpret_cast<AVVkFrame*>(hw_frame->data[0]);
+  if (!vk_dev->act_dev || !vk_dev->phys_dev || !vk_dev->get_proc_addr ||
+      !src_vk || src_vk->img[0] == VK_NULL_HANDLE) {
+    return nullptr;
+  }
+
+  auto vk_get_dev_proc = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+      vk_dev->get_proc_addr(vk_dev->inst, "vkGetDeviceProcAddr"));
+  if (!vk_get_dev_proc) {
+    return nullptr;
+  }
+  auto fn = [&](const char* name) {
+    return vk_get_dev_proc(vk_dev->act_dev, name);
+  };
+#define VK_FN(name) auto pfn_##name = reinterpret_cast<PFN_##name>(fn(#name))
+  VK_FN(vkCreateImage);
+  VK_FN(vkDestroyImage);
+  VK_FN(vkGetImageMemoryRequirements);
+  VK_FN(vkAllocateMemory);
+  VK_FN(vkFreeMemory);
+  VK_FN(vkBindImageMemory);
+  VK_FN(vkGetImageSubresourceLayout);
+  VK_FN(vkGetMemoryFdKHR);
+  VK_FN(vkCreateCommandPool);
+  VK_FN(vkDestroyCommandPool);
+  VK_FN(vkAllocateCommandBuffers);
+  VK_FN(vkBeginCommandBuffer);
+  VK_FN(vkEndCommandBuffer);
+  VK_FN(vkCmdPipelineBarrier);
+  VK_FN(vkCmdCopyImage);
+  VK_FN(vkCreateFence);
+  VK_FN(vkDestroyFence);
+  VK_FN(vkWaitForFences);
+  VK_FN(vkQueueSubmit);
+  VK_FN(vkGetDeviceQueue);
+#undef VK_FN
+  auto pfn_vkGetPhysicalDeviceMemoryProperties =
+      reinterpret_cast<PFN_vkGetPhysicalDeviceMemoryProperties>(
+          vk_dev->get_proc_addr(vk_dev->inst,
+                                "vkGetPhysicalDeviceMemoryProperties"));
+
+  if (!pfn_vkCreateImage || !pfn_vkGetMemoryFdKHR || !pfn_vkCmdCopyImage ||
+      !pfn_vkGetPhysicalDeviceMemoryProperties) {
+    return nullptr;
+  }
+
+  VkPhysicalDeviceMemoryProperties mem_props{};
+  pfn_vkGetPhysicalDeviceMemoryProperties(vk_dev->phys_dev, &mem_props);
+
+  const int w = hw_frame->width;
+  const int h = hw_frame->height;
+  const gfx::Size coded_size(w, h);
+  const gfx::Rect visible_rect(coded_size);
+
+  struct PlaneTarget {
+    VkImage img = VK_NULL_HANDLE;
+    VkDeviceMemory mem = VK_NULL_HANDLE;
+    base::ScopedFD fd;
+    uint32_t stride = 0;
+    uint64_t offset = 0;
+    uint64_t size = 0;
+  } targets[2];
+
+  auto cleanup = [&]() {
+    for (auto& t : targets) {
+      if (t.img != VK_NULL_HANDLE) pfn_vkDestroyImage(vk_dev->act_dev, t.img, nullptr);
+      if (t.mem != VK_NULL_HANDLE) pfn_vkFreeMemory(vk_dev->act_dev, t.mem, nullptr);
+    }
+  };
+
+  const VkFormat formats[2] = {VK_FORMAT_R8_UNORM, VK_FORMAT_R8G8_UNORM};
+  const uint32_t widths[2] = {static_cast<uint32_t>(w),
+                              static_cast<uint32_t>((w + 1) / 2)};
+  const uint32_t heights[2] = {static_cast<uint32_t>(h),
+                               static_cast<uint32_t>((h + 1) / 2)};
+  uint64_t linear_mod = DRM_FORMAT_MOD_LINEAR;
+
+  for (int i = 0; i < 2; ++i) {
+    VkImageDrmFormatModifierListCreateInfoEXT mod_list{
+        .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT,
+        .drmFormatModifierCount = 1,
+        .pDrmFormatModifiers = &linear_mod,
+    };
+    VkExternalMemoryImageCreateInfo ext_info{
+        .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+        .pNext = &mod_list,
+        .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+    };
+    VkImageCreateInfo img_ci{
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .pNext = &ext_info,
+        .imageType = VK_IMAGE_TYPE_2D,
+        .format = formats[i],
+        .extent = {widths[i], heights[i], 1},
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT,
+        .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+        .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    if (pfn_vkCreateImage(vk_dev->act_dev, &img_ci, nullptr, &targets[i].img) !=
+        VK_SUCCESS) {
+      cleanup();
+      return nullptr;
+    }
+    VkMemoryRequirements req{};
+    pfn_vkGetImageMemoryRequirements(vk_dev->act_dev, targets[i].img, &req);
+    uint32_t mem_idx = UINT32_MAX;
+    for (uint32_t m = 0; m < mem_props.memoryTypeCount; ++m) {
+      if ((req.memoryTypeBits & (1u << m)) &&
+          (mem_props.memoryTypes[m].propertyFlags &
+           VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+        mem_idx = m;
+        break;
+      }
+    }
+    if (mem_idx == UINT32_MAX) {
+      cleanup();
+      return nullptr;
+    }
+    VkExportMemoryAllocateInfo exp_ai{
+        .sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO,
+        .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+    };
+    VkMemoryDedicatedAllocateInfo ded_ai{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+        .pNext = &exp_ai,
+        .image = targets[i].img,
+    };
+    VkMemoryAllocateInfo mai{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .pNext = &ded_ai,
+        .allocationSize = req.size,
+        .memoryTypeIndex = mem_idx,
+    };
+    if (pfn_vkAllocateMemory(vk_dev->act_dev, &mai, nullptr, &targets[i].mem) !=
+            VK_SUCCESS ||
+        pfn_vkBindImageMemory(vk_dev->act_dev, targets[i].img, targets[i].mem,
+                              0) != VK_SUCCESS) {
+      cleanup();
+      return nullptr;
+    }
+    VkImageSubresource sub{.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT};
+    VkSubresourceLayout lay{};
+    pfn_vkGetImageSubresourceLayout(vk_dev->act_dev, targets[i].img, &sub,
+                                    &lay);
+    targets[i].stride = lay.rowPitch > 0 ? static_cast<uint32_t>(lay.rowPitch)
+                                         : widths[i] * (i == 0 ? 1u : 2u);
+    targets[i].offset = lay.offset;
+    targets[i].size = lay.size > 0 ? lay.size : req.size;
+    VkMemoryGetFdInfoKHR fd_info{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR,
+        .memory = targets[i].mem,
+        .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+    };
+    int raw_fd = -1;
+    if (pfn_vkGetMemoryFdKHR(vk_dev->act_dev, &fd_info, &raw_fd) !=
+            VK_SUCCESS ||
+        raw_fd < 0) {
+      cleanup();
+      return nullptr;
+    }
+    targets[i].fd.reset(raw_fd);
+  }
+
+  uint32_t qf = vk_dev->nb_qf > 0 ? static_cast<uint32_t>(vk_dev->qf[0].idx) : 0u;
+  VkCommandPoolCreateInfo cpci{
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT,
+      .queueFamilyIndex = qf,
+  };
+  VkCommandPool pool = VK_NULL_HANDLE;
+  if (pfn_vkCreateCommandPool(vk_dev->act_dev, &cpci, nullptr, &pool) !=
+      VK_SUCCESS) {
+    cleanup();
+    return nullptr;
+  }
+  VkCommandBufferAllocateInfo cbai{
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+  };
+  VkCommandBuffer cb = VK_NULL_HANDLE;
+  VkCommandBufferBeginInfo cbbi{
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+  };
+  if (pfn_vkAllocateCommandBuffers(vk_dev->act_dev, &cbai, &cb) != VK_SUCCESS ||
+      pfn_vkBeginCommandBuffer(cb, &cbbi) != VK_SUCCESS) {
+    pfn_vkDestroyCommandPool(vk_dev->act_dev, pool, nullptr);
+    cleanup();
+    return nullptr;
+  }
+
+  const bool two_imgs = (src_vk->img[1] != VK_NULL_HANDLE);
+  VkImageAspectFlags src_aspect =
+      two_imgs ? VK_IMAGE_ASPECT_COLOR_BIT
+               : (VK_IMAGE_ASPECT_PLANE_0_BIT | VK_IMAGE_ASPECT_PLANE_1_BIT);
+  VkImageMemoryBarrier pre[3]{
+      {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+       .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+       .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+       .oldLayout = src_vk->layout[0],
+       .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+       .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .image = src_vk->img[0],
+       .subresourceRange = {src_aspect, 0, 1, 0, 1}},
+      {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+       .srcAccessMask = 0,
+       .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+       .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+       .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+       .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .image = targets[0].img,
+       .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}},
+      {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+       .srcAccessMask = 0,
+       .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+       .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+       .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+       .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .image = targets[1].img,
+       .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}},
+  };
+  pfn_vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                           nullptr, 3, pre);
+
+  for (int i = 0; i < 2; ++i) {
+    VkImage src_img = two_imgs ? src_vk->img[i] : src_vk->img[0];
+    VkImageAspectFlags plane_aspect =
+        two_imgs ? VK_IMAGE_ASPECT_COLOR_BIT
+                 : (i == 0 ? VK_IMAGE_ASPECT_PLANE_0_BIT
+                           : VK_IMAGE_ASPECT_PLANE_1_BIT);
+    VkImageCopy region{
+        .srcSubresource = {plane_aspect, 0, 0, 1},
+        .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+        .extent = {widths[i], heights[i], 1},
+    };
+    pfn_vkCmdCopyImage(cb, src_img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                       targets[i].img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                       1, &region);
+  }
+
+  VkImageMemoryBarrier post[3]{
+      {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+       .srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+       .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT,
+       .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+       .newLayout = src_vk->layout[0],
+       .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .image = src_vk->img[0],
+       .subresourceRange = {src_aspect, 0, 1, 0, 1}},
+      {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+       .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+       .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT,
+       .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+       .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+       .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .image = targets[0].img,
+       .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}},
+      {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+       .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+       .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT,
+       .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+       .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+       .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .image = targets[1].img,
+       .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}},
+  };
+  pfn_vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, nullptr,
+                           0, nullptr, 3, post);
+  pfn_vkEndCommandBuffer(cb);
+
+  VkQueue queue = VK_NULL_HANDLE;
+  pfn_vkGetDeviceQueue(vk_dev->act_dev, qf, 0, &queue);
+  VkFenceCreateInfo fci{.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkFence fence = VK_NULL_HANDLE;
+  pfn_vkCreateFence(vk_dev->act_dev, &fci, nullptr, &fence);
+  VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+  VkTimelineSemaphoreSubmitInfo tl_info{
+      .sType = VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO,
+      .waitSemaphoreValueCount = 1,
+      .pWaitSemaphoreValues = &src_vk->sem_value[0],
+  };
+  VkSubmitInfo si{
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .pNext = src_vk->sem[0] != VK_NULL_HANDLE ? &tl_info : nullptr,
+      .waitSemaphoreCount = src_vk->sem[0] != VK_NULL_HANDLE ? 1u : 0u,
+      .pWaitSemaphores = src_vk->sem[0] != VK_NULL_HANDLE ? &src_vk->sem[0] : nullptr,
+      .pWaitDstStageMask = src_vk->sem[0] != VK_NULL_HANDLE ? &wait_stage : nullptr,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cb,
+  };
+  if (vk_dev->lock_queue) vk_dev->lock_queue(frames_ctx->device_ctx, qf, 0);
+  VkResult sr = pfn_vkQueueSubmit(queue, 1, &si, fence);
+  if (vk_dev->unlock_queue) vk_dev->unlock_queue(frames_ctx->device_ctx, qf, 0);
+  if (sr == VK_SUCCESS) {
+    pfn_vkWaitForFences(vk_dev->act_dev, 1, &fence, VK_TRUE, UINT64_MAX);
+  }
+  pfn_vkDestroyFence(vk_dev->act_dev, fence, nullptr);
+  pfn_vkDestroyCommandPool(vk_dev->act_dev, pool, nullptr);
+  cleanup();
+  if (sr != VK_SUCCESS) {
+    return nullptr;
+  }
+
+  std::vector<ColorPlaneLayout> planes;
+  std::vector<base::ScopedFD> fds;
+  for (int i = 0; i < 2; ++i) {
+    planes.emplace_back(targets[i].stride, targets[i].offset, targets[i].size);
+    fds.push_back(std::move(targets[i].fd));
+  }
+  auto layout = VideoFrameLayout::CreateWithPlanes(
+      PIXEL_FORMAT_NV12, coded_size, std::move(planes),
+      VideoFrameLayout::kBufferAddressAlignment, linear_mod);
+  if (!layout) {
+    return nullptr;
+  }
+  auto vf = VideoFrame::WrapExternalDmabufs(
+      *layout, visible_rect, coded_size, std::move(fds), pts);
+  if (vf) {
+    vf->metadata().power_efficient = true;
+  }
+  return vf;
+}
+
+bool VulkanVideoDecoder::EmitFrame(AVFrame* hw_frame) {
+  const gfx::Size coded_size(hw_frame->width, hw_frame->height);
+  const gfx::Rect visible_rect(coded_size);
+  const auto pts =
+      ConvertFromTimeBase(codec_context_->pkt_timebase, hw_frame->pts);
+
+  // Zero-copy path: map AV_PIX_FMT_VULKAN -> AV_PIX_FMT_DRM_PRIME and wrap
+  // exported DMA-BUF file descriptors directly into a VideoFrame.
+  if (hw_frame->format == AV_PIX_FMT_VULKAN) {
+    AVFrame* drm_frame = av_frame_alloc();
+    if (drm_frame) {
+      drm_frame->format = AV_PIX_FMT_DRM_PRIME;
+      if (av_hwframe_map(drm_frame, hw_frame, AV_HWFRAME_MAP_READ) == 0) {
+        const auto* desc =
+            reinterpret_cast<const AVDRMFrameDescriptor*>(drm_frame->data[0]);
+        if (desc && desc->nb_layers > 0 && desc->layers[0].nb_planes > 0) {
+          const AVDRMLayerDescriptor& layer = desc->layers[0];
+          std::vector<ColorPlaneLayout> planes;
+          std::vector<base::ScopedFD> dmabuf_fds;
+          bool fds_ok = true;
+          uint64_t modifier = desc->objects[0].format_modifier;
+
+          for (int i = 0; i < layer.nb_planes; ++i) {
+            int obj_idx = layer.planes[i].object_index;
+            if (obj_idx < 0 || obj_idx >= desc->nb_objects) {
+              fds_ok = false;
+              break;
+            }
+            base::ScopedFD dup_fd(HANDLE_EINTR(dup(desc->objects[obj_idx].fd)));
+            if (!dup_fd.is_valid()) {
+              fds_ok = false;
+              break;
+            }
+            planes.emplace_back(layer.planes[i].pitch, layer.planes[i].offset,
+                                desc->objects[obj_idx].size);
+            dmabuf_fds.push_back(std::move(dup_fd));
+          }
+
+          if (fds_ok) {
+            auto layout = VideoFrameLayout::CreateWithPlanes(
+                PIXEL_FORMAT_NV12, coded_size, std::move(planes),
+                VideoFrameLayout::kBufferAddressAlignment, modifier);
+            if (layout) {
+              auto video_frame = VideoFrame::WrapExternalDmabufs(
+                  *layout, visible_rect, coded_size, std::move(dmabuf_fds),
+                  pts);
+              if (video_frame) {
+                video_frame->metadata().power_efficient = true;
+                video_frame->AddDestructionObserver(base::BindOnce(
+                    [](AVFrame* frame) { av_frame_free(&frame); }, drm_frame));
+                output_cb_.Run(std::move(video_frame));
+                return true;
+              }
+            }
+          }
+        }
+      }
+      av_frame_free(&drm_frame);
+    }
+    if (auto gpu_vf = TryGpuCopyVkFrameToDmabuf(hw_frame, pts)) {
+      output_cb_.Run(std::move(gpu_vf));
+      return true;
+    }
+  }
+
+  // Fallback path: transfer Vulkan surface to host NV12 VideoFrame.
+  AVFrame* sw_frame = av_frame_alloc();
+  if (!sw_frame) {
+    return false;
+  }
+
+  int ret = (hw_frame->format == AV_PIX_FMT_VULKAN)
+                ? av_hwframe_transfer_data(sw_frame, hw_frame, 0)
+                : av_frame_ref(sw_frame, hw_frame);
+  if (ret < 0) {
+    av_frame_free(&sw_frame);
+    return false;
+  }
+
+  auto video_frame = VideoFrame::CreateFrame(PIXEL_FORMAT_NV12, coded_size,
+                                             visible_rect, coded_size, pts);
+  if (!video_frame) {
+    av_frame_free(&sw_frame);
+    return false;
+  }
+
+  // Copy Y and interleaved UV planes from transferred NV12 frame.
+  for (int plane = 0; plane < 2; ++plane) {
+    const uint8_t* src = sw_frame->data[plane];
+    int src_stride = sw_frame->linesize[plane];
+    uint8_t* dst = video_frame->writable_data(plane);
+    int dst_stride = video_frame->stride(plane);
+    int rows = (plane == 0) ? coded_size.height() : (coded_size.height() + 1) / 2;
+    int row_bytes = std::min(src_stride, dst_stride);
+    for (int y = 0; y < rows; ++y) {
+      std::memcpy(dst + y * dst_stride, src + y * src_stride, row_bytes);
+    }
+  }
+
+  video_frame->metadata().power_efficient = true;
+  av_frame_free(&sw_frame);
+  output_cb_.Run(std::move(video_frame));
+  return true;
+}
+
+void VulkanVideoDecoder::Reset(base::OnceClosure closure) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (codec_context_) {
+    avcodec_flush_buffers(codec_context_.get());
+  }
+  eos_reached_ = false;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                           std::move(closure));
+}
