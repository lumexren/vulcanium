+
+void VulkanVideoDecoder::Initialize(const VideoDecoderConfig& config,
+                                    bool low_delay,
+                                    CdmContext* cdm_context,
+                                    InitCB init_cb,
+                                    const OutputCB& output_cb,
+                                    const WaitingCB& waiting_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  InitCB bound_init_cb = base::BindPostTaskToCurrentDefault(std::move(init_cb));
+
+  if (!IsSupported(config)) {
+    ReleaseResources(/*release_slot=*/true);
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kUnsupportedConfig);
+    return;
+  }
+
+  if (initialized_ && codec_context_ && config_.codec() == config.codec() &&
+      config_.profile() == config.profile() &&
+      config_.coded_size() == config.coded_size() &&
+      config_.extra_data() == config.extra_data()) {
+    avcodec_flush_buffers(codec_context_.get());
+    config_ = config;
+    output_cb_ = output_cb;
+    eos_reached_ = false;
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kOk);
+    return;
+  }
+
+  if (!ConfigureVulkanDecoder(config)) {
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kUnsupportedConfig);
+    return;
+  }
+
+  config_ = config;
+  output_cb_ = output_cb;
+  if (frame_converter_ && !converter_initialized_) {
+    frame_converter_->Initialize(
+        base::SequencedTaskRunner::GetCurrentDefault(),
+        base::BindRepeating(&VulkanVideoDecoder::OnFrameConverted,
+                            weak_factory_.GetWeakPtr()));
+    frame_converter_->set_get_original_frame_cb(base::BindRepeating(
+        &VulkanVideoDecoder::GetOriginalFrame, base::Unretained(this)));
+    converter_initialized_ = true;
+  }
+  initialized_ = true;
+  eos_reached_ = false;
+  std::move(bound_init_cb).Run(DecoderStatus::Codes::kOk);
+}
+
+bool VulkanVideoDecoder::ConfigureVulkanDecoder(
+    const VideoDecoderConfig& config) {
+  ReleaseResources(/*release_slot=*/false);
+  drm_prime_map_supported_ = true;
+
+  if (!has_decoder_slot_) {
+    if (!TryAcquireDecoderSlot()) {
+      VLOG(1) << "VulkanVideoDecoder: max concurrent decoders ("
+              << kMaxConcurrentDecoders << ") reached; rejecting config";
+      return false;
+    }
+    has_decoder_slot_ = true;
+  }
+
+  hw_device_ctx_ = SharedVulkanDevice::GetInstance()->AcquireDevice();
+  if (!hw_device_ctx_) {
+    ReleaseResources(/*release_slot=*/true);
+    return false;
+  }
+
+  codec_context_.reset(avcodec_alloc_context3(nullptr));
+  if (!codec_context_) {
+    ReleaseResources(/*release_slot=*/true);
+    return false;
+  }
+
+  VideoDecoderConfigToAVCodecContext(config, codec_context_.get());
+  av_freep(&codec_context_->codec_whitelist);
+  codec_context_->codec_whitelist = av_strdup("h264,hevc,vp9,av1");
+  codec_context_->hw_device_ctx = av_buffer_ref(hw_device_ctx_);
+  codec_context_->get_format = GetVulkanHwFormat;
+  codec_context_->pkt_timebase = AVRational{1, 1000000};
+
+  const AVCodec* codec = avcodec_find_decoder(codec_context_->codec_id);
+  if (!codec) {
+    LOG(ERROR) << "VulkanVideoDecoder: avcodec_find_decoder failed for codec "
+               << GetCodecName(config.codec());
+    ReleaseResources(/*release_slot=*/true);
+    return false;
+  }
+  int err = avcodec_open2(codec_context_.get(), codec, nullptr);
+  if (err < 0) {
+    LOG(ERROR) << "VulkanVideoDecoder: avcodec_open2 failed for codec "
+               << GetCodecName(config.codec()) << ": " << AVErrorToString(err);
+    ReleaseResources(/*release_slot=*/true);
+    return false;
+  }
+  VLOG(1) << "VulkanVideoDecoder: initialized " << codec->name << " for "
+          << GetCodecName(config.codec());
+
+  return true;
+}
+
+void VulkanVideoDecoder::ReleaseResources(bool release_slot) {
+  codec_context_.reset();
+  if (copy_state_) {
+    if (hw_device_ctx_) {
+      auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(hw_device_ctx_->data);
+      auto* vk_dev =
+          dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx)
+                  : nullptr;
+      const auto* copy_info = SharedVulkanDevice::GetInstance()->GetCopyInfo();
+      if (vk_dev && copy_info && copy_info->procs_ready) {
+        DestroyCopyCmdResources(vk_dev, copy_info->procs,
+                                copy_state_->cmd_pool, copy_state_->fence);
+      }
+    }
+    copy_state_->cmd_pool = VK_NULL_HANDLE;
+    copy_state_->cmd_buf = VK_NULL_HANDLE;
+    copy_state_->fence = VK_NULL_HANDLE;
+    copy_state_.reset();
+  }
+  if (hw_device_ctx_) {
+    av_buffer_unref(&hw_device_ctx_);
+    hw_device_ctx_ = nullptr;
+  }
+  initialized_ = false;
+  if (release_slot && has_decoder_slot_) {
+    g_active_decoders.fetch_sub(1, std::memory_order_acq_rel);
+    has_decoder_slot_ = false;
+  }
+}
+
+void VulkanVideoDecoder::Decode(scoped_refptr<DecoderBuffer> buffer,
+                                DecodeCB decode_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DecodeCB bound_cb = base::BindPostTaskToCurrentDefault(std::move(decode_cb));
+
+  if (!initialized_ || !codec_context_) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+    return;
+  }
+  if (eos_reached_) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kOk);
+    return;
+  }
+
+  AVPacket* packet = av_packet_alloc();
+  if (!packet) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kOutOfMemory);
+    return;
+  }
+
+  if (buffer->end_of_stream()) {
+    packet->data = nullptr;
+    packet->size = 0;
+  } else {
+    auto span = base::span(*buffer);
+    packet->data = const_cast<uint8_t*>(span.data());
+    packet->size = base::checked_cast<int>(span.size());
+    packet->pts =
+        ConvertToTimeBase(codec_context_->pkt_timebase, buffer->timestamp());
+  }
+
+  int ret = avcodec_send_packet(codec_context_.get(), packet);
+  av_packet_free(&packet);
+  if (ret < 0 && ret != AVERROR_EOF) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+    return;
+  }
+
+  AVFrame* hw_frame = av_frame_alloc();
+  if (!hw_frame) {
+    std::move(bound_cb).Run(DecoderStatus::Codes::kOutOfMemory);
+    return;
+  }
+
+  while (true) {
+    ret = avcodec_receive_frame(codec_context_.get(), hw_frame);
+    if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) {
+      break;
+    }
+    if (ret < 0) {
+      av_frame_free(&hw_frame);
+      std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+      return;
+    }
+    if (!EmitFrame(hw_frame)) {
+      av_frame_unref(hw_frame);
+      av_frame_free(&hw_frame);
+      std::move(bound_cb).Run(DecoderStatus::Codes::kFailed);
+      return;
+    }
+    av_frame_unref(hw_frame);
+  }
+
+  av_frame_free(&hw_frame);
+  if (buffer->end_of_stream()) {
+    eos_reached_ = true;
+  }
+  std::move(bound_cb).Run(DecoderStatus::Codes::kOk);
+}
+
+scoped_refptr<FrameResource> VulkanVideoDecoder::EmitGpuCopyFrame(
+    AVFrame* hw_frame,
+    base::TimeDelta pts,
+    bool* is_pooled) {
+  *is_pooled = false;
+  if (!hw_frame || !hw_frame->hw_frames_ctx || !hw_device_ctx_) {
+    return nullptr;
+  }
+  const auto* copy_info = SharedVulkanDevice::GetInstance()->GetCopyInfo();
+  if (!copy_info || !copy_info->procs_ready) {
+    return nullptr;
+  }
+  auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(hw_device_ctx_->data);
+  auto* vk_dev =
+      dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+  if (!vk_dev || !vk_dev->act_dev) {
+    return nullptr;
+  }
+
+  const int w = hw_frame->width;
+  const int h = hw_frame->height;
+  const gfx::Size coded_size(w, h);
+  const gfx::Rect visible_rect(coded_size);
+  if (w <= 0 || h <= 0) {
+    return nullptr;
+  }
+
+  if (!copy_state_) {
+    copy_state_ = std::make_unique<VulkanCopyState>();
+  }
+  if (copy_state_->cmd_pool == VK_NULL_HANDLE) {
+    if (!CreateCopyCmdResources(vk_dev, *copy_info, &copy_state_->cmd_pool,
+                                &copy_state_->cmd_buf, &copy_state_->fence)) {
+      return nullptr;
+    }
+  }
+
+  if (copy_state_->pool_size != coded_size) {
+    copy_state_->slots.clear();
+    copy_state_->origin_frames_by_token.clear();
+    copy_state_->pool_size = coded_size;
+  }
+
+  OutputSlot* chosen = nullptr;
+  for (auto& slot : copy_state_->slots) {
+    if (!slot.in_use) {
+      chosen = &slot;
+      break;
+    }
+  }
+
+  if (!chosen && copy_state_->slots.size() < kMaxOutputPoolSize) {
+    auto new_slot = CreateDmabufSlot(hw_device_ctx_, vk_dev, *copy_info, w, h,
+                                     pts);
+    if (!new_slot) {
+      return nullptr;
+    }
+    copy_state_->origin_frames_by_token.emplace(new_slot->token,
+                                                new_slot->origin_frame);
+    copy_state_->slots.push_back(std::move(*new_slot));
+    chosen = &copy_state_->slots.back();
+  }
+
+  if (chosen) {
+    if (!CopyVkFrameToVkImage(vk_dev, *copy_info, copy_state_->cmd_pool,
+                              copy_state_->cmd_buf, copy_state_->fence,
+                              hw_frame, chosen->img)) {
+      return nullptr;
+    }
+    auto wrapped =
+        chosen->origin_frame->CreateWrappingFrame(visible_rect, coded_size);
+    if (!wrapped) {
+      return nullptr;
+    }
+    wrapped->set_timestamp(pts);
+    wrapped->metadata().power_efficient = true;
+    chosen->in_use = true;
+    wrapped->AddDestructionObserver(base::BindPostTaskToCurrentDefault(
+        base::BindOnce(&VulkanVideoDecoder::ReleaseOutputSlot,
+                       weak_factory_.GetWeakPtr(), chosen->token)));
+    *is_pooled = true;
+    return wrapped;
+  }
+
+  // All pooled slots are currently held downstream; emit a one-shot unpooled
+  // buffer whose GPU backing is freed as soon as the frame is released.
+  auto temp_slot =
+      CreateDmabufSlot(hw_device_ctx_, vk_dev, *copy_info, w, h, pts);
+  if (!temp_slot) {
+    return nullptr;
+  }
+  if (!CopyVkFrameToVkImage(vk_dev, *copy_info, copy_state_->cmd_pool,
+                            copy_state_->cmd_buf, copy_state_->fence, hw_frame,
+                            temp_slot->img)) {
+    return nullptr;
+  }
+  *is_pooled = false;
+  return temp_slot->origin_frame;
+}
+
+void VulkanVideoDecoder::ReleaseOutputSlot(base::UnguessableToken token) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!copy_state_) {
+    return;
+  }
+  for (auto& slot : copy_state_->slots) {
+    if (slot.token == token) {
+      slot.in_use = false;
+      return;
+    }
+  }
+}
+
+FrameResource* VulkanVideoDecoder::GetOriginalFrame(
+    const base::UnguessableToken& tracking_token) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (copy_state_) {
+    auto it = copy_state_->origin_frames_by_token.find(tracking_token);
+    if (it != copy_state_->origin_frames_by_token.end()) {
+      return it->second.get();
+    }
+  }
+  return current_unpooled_origin_;
+}
+
+bool VulkanVideoDecoder::EmitFrame(AVFrame* hw_frame) {
+  const gfx::Size coded_size(hw_frame->width, hw_frame->height);
+  const gfx::Rect visible_rect(coded_size);
+  const auto pts =
+      ConvertFromTimeBase(codec_context_->pkt_timebase, hw_frame->pts);
+
+  // Zero-copy path: map AV_PIX_FMT_VULKAN -> AV_PIX_FMT_DRM_PRIME and wrap
+  // exported DMA-BUF file descriptors directly into a VideoFrame.
+  if (hw_frame->format == AV_PIX_FMT_VULKAN && drm_prime_map_supported_) {
+    AVFrame* drm_frame = av_frame_alloc();
+    if (drm_frame) {
+      drm_frame->format = AV_PIX_FMT_DRM_PRIME;
+      if (av_hwframe_map(drm_frame, hw_frame, AV_HWFRAME_MAP_READ) == 0) {
+        const auto* desc =
+            reinterpret_cast<const AVDRMFrameDescriptor*>(drm_frame->data[0]);
+        if (desc && desc->nb_layers > 0 && desc->layers[0].nb_planes > 0) {
+          const AVDRMLayerDescriptor& layer = desc->layers[0];
+          std::vector<ColorPlaneLayout> planes;
+          std::vector<base::ScopedFD> dmabuf_fds;
+          bool fds_ok = true;
+          uint64_t modifier = desc->objects[0].format_modifier;
+
+          for (int i = 0; i < layer.nb_planes; ++i) {
+            int obj_idx = layer.planes[i].object_index;
+            if (obj_idx < 0 || obj_idx >= desc->nb_objects) {
+              fds_ok = false;
+              break;
+            }
+            base::ScopedFD dup_fd(HANDLE_EINTR(dup(desc->objects[obj_idx].fd)));
+            if (!dup_fd.is_valid()) {
+              fds_ok = false;
+              break;
+            }
+            planes.emplace_back(layer.planes[i].pitch, layer.planes[i].offset,
+                                desc->objects[obj_idx].size);
+            dmabuf_fds.push_back(std::move(dup_fd));
+          }
+
+          if (fds_ok) {
+            auto layout = VideoFrameLayout::CreateWithPlanes(
+                PIXEL_FORMAT_NV12, coded_size, std::move(planes),
+                VideoFrameLayout::kBufferAddressAlignment, modifier);
+            if (layout) {
+              auto video_frame = VideoFrame::WrapExternalDmabufs(
+                  *layout, visible_rect, coded_size, std::move(dmabuf_fds),
+                  pts);
+              if (video_frame && frame_converter_) {
+                video_frame->metadata().power_efficient = true;
+                video_frame->metadata().tracking_token =
+                    base::UnguessableToken::Create();
+                video_frame->AddDestructionObserver(base::BindOnce(
+                    [](AVFrame* frame) { av_frame_free(&frame); }, drm_frame));
+                drm_frame = nullptr;
+                auto resource =
+                    VideoFrameResource::Create(std::move(video_frame));
+                if (resource) {
+                  auto weak_self = weak_factory_.GetWeakPtr();
+                  current_unpooled_origin_ = resource.get();
+                  frame_converter_->ConvertFrame(std::move(resource));
+                  if (weak_self) {
+                    current_unpooled_origin_ = nullptr;
+                  }
+                  return true;
+                }
+              }
+            }
+          }
+        }
+      } else {
+        drm_prime_map_supported_ = false;
+      }
+      av_frame_free(&drm_frame);
+    }
+  }
+
+  if (hw_frame->format == AV_PIX_FMT_VULKAN && frame_converter_) {
+    bool is_pooled = false;
+    if (auto resource = EmitGpuCopyFrame(hw_frame, pts, &is_pooled)) {
+      auto weak_self = weak_factory_.GetWeakPtr();
+      if (!is_pooled) {
+        current_unpooled_origin_ = resource.get();
+      }
+      frame_converter_->ConvertFrame(std::move(resource));
+      if (!is_pooled && weak_self) {
+        current_unpooled_origin_ = nullptr;
+      }
+      return true;
+    }
+    static bool logged_fb = false;
+    if (!logged_fb) {
+      logged_fb = true;
+      LOG(WARNING)
+          << "VulkanVideoDecoder: falling back to av_hwframe_transfer_data";
+    }
+  }
+
+  // Fallback path: transfer Vulkan surface to host NV12 VideoFrame.
+  AVFrame* sw_frame = av_frame_alloc();
+  if (!sw_frame) {
+    return false;
+  }
+
+  int ret = (hw_frame->format == AV_PIX_FMT_VULKAN)
+                ? av_hwframe_transfer_data(sw_frame, hw_frame, 0)
+                : av_frame_ref(sw_frame, hw_frame);
+  if (ret < 0) {
+    av_frame_free(&sw_frame);
+    return false;
+  }
+
+  auto video_frame = VideoFrame::CreateFrame(PIXEL_FORMAT_NV12, coded_size,
+                                             visible_rect, coded_size, pts);
+  if (!video_frame) {
+    av_frame_free(&sw_frame);
+    return false;
+  }
+
+  // Copy Y and interleaved UV planes from transferred NV12 frame.
+  for (int plane = 0; plane < 2; ++plane) {
+    const uint8_t* src = sw_frame->data[plane];
+    int src_stride = sw_frame->linesize[plane];
+    uint8_t* dst = video_frame->writable_data(plane);
+    int dst_stride = video_frame->stride(plane);
+    int rows = (plane == 0) ? coded_size.height() : (coded_size.height() + 1) / 2;
+    int row_bytes = std::min(src_stride, dst_stride);
+    for (int y = 0; y < rows; ++y) {
+      std::memcpy(dst + y * dst_stride, src + y * src_stride, row_bytes);
+    }
+  }
+
+  video_frame->metadata().power_efficient = true;
+  av_frame_free(&sw_frame);
+  output_cb_.Run(std::move(video_frame));
+  return true;
+}
+
+void VulkanVideoDecoder::OnFrameConverted(scoped_refptr<VideoFrame> frame) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (frame && output_cb_) {
+    output_cb_.Run(std::move(frame));
+  }
+}
+
+void VulkanVideoDecoder::Reset(base::OnceClosure closure) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (frame_converter_) {
+    frame_converter_->AbortPendingFrames();
+  }
+  if (codec_context_) {
+    avcodec_flush_buffers(codec_context_.get());
+  }
+  eos_reached_ = false;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                           std::move(closure));
+}
