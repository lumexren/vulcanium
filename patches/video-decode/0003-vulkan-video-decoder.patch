+// static
+SupportedVideoDecoderConfigs VulkanVideoDecoder::GetSupportedConfigs() {
+  return {
+      {H264PROFILE_MIN, H264PROFILE_MAX, gfx::Size(64, 64),
+       gfx::Size(4096, 4096), /*allow_encrypted=*/false,
+       /*require_encrypted=*/false},
+      {HEVCPROFILE_MIN, HEVCPROFILE_MAX, gfx::Size(64, 64),
+       gfx::Size(8192, 8192), /*allow_encrypted=*/false,
+       /*require_encrypted=*/false},
+      {VP9PROFILE_MIN, VP9PROFILE_MAX, gfx::Size(64, 64),
+       gfx::Size(8192, 8192), /*allow_encrypted=*/false,
+       /*require_encrypted=*/false},
+      {AV1PROFILE_MIN, AV1PROFILE_MAX, gfx::Size(64, 64),
+       gfx::Size(8192, 8192), /*allow_encrypted=*/false,
+       /*require_encrypted=*/false},
+  };
+}
+
+// static
+bool VulkanVideoDecoder::IsSupported(const VideoDecoderConfig& config) {
+  if (config.is_encrypted()) {
+    return false;
+  }
+  switch (config.codec()) {
+    case VideoCodec::kH264:
+    case VideoCodec::kHEVC:
+    case VideoCodec::kAV1:
+    case VideoCodec::kVP9:
+      return true;
+    default:
+      return false;
+  }
+}
