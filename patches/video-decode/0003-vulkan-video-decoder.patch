+constexpr int kMaxConcurrentDecoders = 8;
+constexpr size_t kMaxOutputPoolSize = 12;
+
+std::atomic<int> g_active_decoders{0};
+
+bool TryAcquireDecoderSlot() {
+  int cur = g_active_decoders.load(std::memory_order_relaxed);
+  while (cur < kMaxConcurrentDecoders) {
+    if (g_active_decoders.compare_exchange_weak(
+            cur, cur + 1, std::memory_order_acq_rel,
+            std::memory_order_relaxed)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+struct VkCopyProcs {
+  PFN_vkCreateImage vkCreateImage = nullptr;
+  PFN_vkDestroyImage vkDestroyImage = nullptr;
+  PFN_vkGetImageMemoryRequirements vkGetImageMemoryRequirements = nullptr;
+  PFN_vkAllocateMemory vkAllocateMemory = nullptr;
+  PFN_vkFreeMemory vkFreeMemory = nullptr;
+  PFN_vkBindImageMemory vkBindImageMemory = nullptr;
+  PFN_vkGetImageSubresourceLayout vkGetImageSubresourceLayout = nullptr;
+  PFN_vkGetMemoryFdKHR vkGetMemoryFdKHR = nullptr;
+  PFN_vkCreateCommandPool vkCreateCommandPool = nullptr;
+  PFN_vkDestroyCommandPool vkDestroyCommandPool = nullptr;
+  PFN_vkResetCommandPool vkResetCommandPool = nullptr;
+  PFN_vkAllocateCommandBuffers vkAllocateCommandBuffers = nullptr;
+  PFN_vkBeginCommandBuffer vkBeginCommandBuffer = nullptr;
+  PFN_vkEndCommandBuffer vkEndCommandBuffer = nullptr;
+  PFN_vkCmdPipelineBarrier vkCmdPipelineBarrier = nullptr;
+  PFN_vkCmdCopyImage vkCmdCopyImage = nullptr;
+  PFN_vkCreateFence vkCreateFence = nullptr;
+  PFN_vkDestroyFence vkDestroyFence = nullptr;
+  PFN_vkResetFences vkResetFences = nullptr;
+  PFN_vkWaitForFences vkWaitForFences = nullptr;
+  PFN_vkQueueSubmit vkQueueSubmit = nullptr;
+  PFN_vkGetDeviceQueue vkGetDeviceQueue = nullptr;
+  PFN_vkGetPhysicalDeviceMemoryProperties
+      vkGetPhysicalDeviceMemoryProperties = nullptr;
+};
+
+struct VkCopyInfo {
+  VkCopyProcs procs;
+  VkPhysicalDeviceMemoryProperties mem_props{};
+  uint32_t copy_queue_family = 0;
+  bool procs_ready = false;
+};
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+void InitCopyInfo(AVVulkanDeviceContext* vk_dev, VkCopyInfo* info) {
+  if (!vk_dev || !vk_dev->act_dev || !vk_dev->phys_dev || !vk_dev->inst ||
+      !vk_dev->get_proc_addr) {
+    return;
+  }
+
+  auto vk_get_dev_proc = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+      vk_dev->get_proc_addr(vk_dev->inst, "vkGetDeviceProcAddr"));
+  if (!vk_get_dev_proc) {
+    return;
+  }
+
+#define LOAD_DEV_PROC(name) \
+  info->procs.name = reinterpret_cast<PFN_##name>( \
+      vk_get_dev_proc(vk_dev->act_dev, #name))
+  LOAD_DEV_PROC(vkCreateImage);
+  LOAD_DEV_PROC(vkDestroyImage);
+  LOAD_DEV_PROC(vkGetImageMemoryRequirements);
+  LOAD_DEV_PROC(vkAllocateMemory);
+  LOAD_DEV_PROC(vkFreeMemory);
+  LOAD_DEV_PROC(vkBindImageMemory);
+  LOAD_DEV_PROC(vkGetImageSubresourceLayout);
+  LOAD_DEV_PROC(vkGetMemoryFdKHR);
+  LOAD_DEV_PROC(vkCreateCommandPool);
+  LOAD_DEV_PROC(vkDestroyCommandPool);
+  LOAD_DEV_PROC(vkResetCommandPool);
+  LOAD_DEV_PROC(vkAllocateCommandBuffers);
+  LOAD_DEV_PROC(vkBeginCommandBuffer);
+  LOAD_DEV_PROC(vkEndCommandBuffer);
+  LOAD_DEV_PROC(vkCmdPipelineBarrier);
+  LOAD_DEV_PROC(vkCmdCopyImage);
+  LOAD_DEV_PROC(vkCreateFence);
+  LOAD_DEV_PROC(vkDestroyFence);
+  LOAD_DEV_PROC(vkResetFences);
+  LOAD_DEV_PROC(vkWaitForFences);
+  LOAD_DEV_PROC(vkQueueSubmit);
+  LOAD_DEV_PROC(vkGetDeviceQueue);
+#undef LOAD_DEV_PROC
+
+  info->procs.vkGetPhysicalDeviceMemoryProperties =
+      reinterpret_cast<PFN_vkGetPhysicalDeviceMemoryProperties>(
+          vk_dev->get_proc_addr(vk_dev->inst,
+                                "vkGetPhysicalDeviceMemoryProperties"));
+
+  const auto& p = info->procs;
+  if (!p.vkCreateImage || !p.vkDestroyImage ||
+      !p.vkGetImageMemoryRequirements || !p.vkAllocateMemory ||
+      !p.vkFreeMemory || !p.vkBindImageMemory ||
+      !p.vkGetImageSubresourceLayout || !p.vkGetMemoryFdKHR ||
+      !p.vkCreateCommandPool || !p.vkDestroyCommandPool ||
+      !p.vkResetCommandPool || !p.vkAllocateCommandBuffers ||
+      !p.vkBeginCommandBuffer || !p.vkEndCommandBuffer ||
+      !p.vkCmdPipelineBarrier || !p.vkCmdCopyImage || !p.vkCreateFence ||
+      !p.vkDestroyFence || !p.vkResetFences || !p.vkWaitForFences ||
+      !p.vkQueueSubmit || !p.vkGetDeviceQueue ||
+      !p.vkGetPhysicalDeviceMemoryProperties) {
+    return;
+  }
+
+  p.vkGetPhysicalDeviceMemoryProperties(vk_dev->phys_dev, &info->mem_props);
+
+  uint32_t qf =
+      vk_dev->nb_qf > 0 ? static_cast<uint32_t>(vk_dev->qf[0].idx) : 0u;
+  for (int qi = 0; qi < vk_dev->nb_qf; ++qi) {
+    if (vk_dev->qf[qi].flags &
+        (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_TRANSFER_BIT)) {
+      qf = static_cast<uint32_t>(vk_dev->qf[qi].idx);
+      if (vk_dev->qf[qi].flags & VK_QUEUE_GRAPHICS_BIT) {
+        break;
+      }
+    }
+  }
+  info->copy_queue_family = qf;
+  info->procs_ready = true;
+}
+
+// Holds a single GPU-process-wide FFmpeg AV_HWDEVICE_TYPE_VULKAN context and
+// pre-resolved Vulkan function pointers so decoder creation avoids repeated
+// vkCreateDevice calls during autoplay/preview scrolling.
+class SharedVulkanDevice {
+ public:
+  static SharedVulkanDevice* GetInstance() {
+    static base::NoDestructor<SharedVulkanDevice> instance;
+    return instance.get();
+  }
+
+  AVBufferRef* AcquireDevice() {
+    base::AutoLock lock(lock_);
+    if (!device_ctx_) {
+      int err = av_hwdevice_ctx_create(&device_ctx_, AV_HWDEVICE_TYPE_VULKAN,
+                                       nullptr, nullptr, 0);
+      if (err < 0 || !device_ctx_) {
+        LOG(ERROR) << "VulkanVideoDecoder: av_hwdevice_ctx_create failed: "
+                   << AVErrorToString(err);
+        return nullptr;
+      }
+    }
+    if (!copy_info_attempted_) {
+      copy_info_attempted_ = true;
+      auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(device_ctx_->data);
+      auto* vk_dev =
+          dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx)
+                  : nullptr;
+      InitCopyInfo(vk_dev, &copy_info_);
+    }
+    return av_buffer_ref(device_ctx_);
+  }
+
+  const VkCopyInfo* GetCopyInfo() const { return &copy_info_; }
+
+ private:
+  friend class base::NoDestructor<SharedVulkanDevice>;
+  SharedVulkanDevice() = default;
+  ~SharedVulkanDevice() = delete;
+
+  base::Lock lock_;
+  AVBufferRef* device_ctx_ = nullptr;
+  VkCopyInfo copy_info_;
+  bool copy_info_attempted_ = false;
+};
+
+struct OutputSlot {
+  VkImage img = VK_NULL_HANDLE;
+  VkDeviceMemory mem = VK_NULL_HANDLE;
+  base::UnguessableToken token;
+  scoped_refptr<VideoFrameResource> origin_frame;
+  bool in_use = false;
+};
+
+struct VkSlotAllocation {
+  AVBufferRef* dev_ctx_ref = nullptr;
+  VkImage img = VK_NULL_HANDLE;
+  VkDeviceMemory mem = VK_NULL_HANDLE;
+  PFN_vkDestroyImage pfn_destroy_image = nullptr;
+  PFN_vkFreeMemory pfn_free_memory = nullptr;
+};
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+void DestroyVkSlotAllocation(VkSlotAllocation alloc) {
+  if (alloc.dev_ctx_ref) {
+    auto* dev_ctx =
+        reinterpret_cast<AVHWDeviceContext*>(alloc.dev_ctx_ref->data);
+    auto* vk_dev =
+        dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+    if (vk_dev && vk_dev->act_dev) {
+      if (alloc.img != VK_NULL_HANDLE && alloc.pfn_destroy_image) {
+        alloc.pfn_destroy_image(vk_dev->act_dev, alloc.img, nullptr);
+      }
+      if (alloc.mem != VK_NULL_HANDLE && alloc.pfn_free_memory) {
+        alloc.pfn_free_memory(vk_dev->act_dev, alloc.mem, nullptr);
+      }
+    }
+    av_buffer_unref(&alloc.dev_ctx_ref);
+  }
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+void DestroyCopyCmdResources(AVVulkanDeviceContext* vk_dev,
+                             const VkCopyProcs& procs,
+                             VkCommandPool pool,
+                             VkFence fence) {
+  if (!vk_dev || !vk_dev->act_dev) {
+    return;
+  }
+  if (fence != VK_NULL_HANDLE && procs.vkDestroyFence) {
+    procs.vkDestroyFence(vk_dev->act_dev, fence, nullptr);
+  }
+  if (pool != VK_NULL_HANDLE && procs.vkDestroyCommandPool) {
+    procs.vkDestroyCommandPool(vk_dev->act_dev, pool, nullptr);
+  }
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+bool CreateCopyCmdResources(AVVulkanDeviceContext* vk_dev,
+                            const VkCopyInfo& info,
+                            VkCommandPool* pool_out,
+                            VkCommandBuffer* buf_out,
+                            VkFence* fence_out) {
+  const auto& p = info.procs;
+  VkCommandPoolCreateInfo cpci{
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT |
+               VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+      .queueFamilyIndex = info.copy_queue_family,
+  };
+  VkCommandPool pool = VK_NULL_HANDLE;
+  if (p.vkCreateCommandPool(vk_dev->act_dev, &cpci, nullptr, &pool) !=
+      VK_SUCCESS) {
+    return false;
+  }
+
+  VkCommandBufferAllocateInfo cbai{
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+  };
+  VkCommandBuffer cb = VK_NULL_HANDLE;
+  if (p.vkAllocateCommandBuffers(vk_dev->act_dev, &cbai, &cb) != VK_SUCCESS) {
+    p.vkDestroyCommandPool(vk_dev->act_dev, pool, nullptr);
+    return false;
+  }
+
+  VkFenceCreateInfo fci{.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkFence fence = VK_NULL_HANDLE;
+  if (p.vkCreateFence(vk_dev->act_dev, &fci, nullptr, &fence) != VK_SUCCESS) {
+    p.vkDestroyCommandPool(vk_dev->act_dev, pool, nullptr);
+    return false;
+  }
+
+  *pool_out = pool;
+  *buf_out = cb;
+  *fence_out = fence;
+  return true;
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+void CleanupVkImageMemory(AVVulkanDeviceContext* vk_dev,
+                          const VkCopyProcs& p,
+                          VkImage img,
+                          VkDeviceMemory mem) {
+  if (!vk_dev || !vk_dev->act_dev) {
+    return;
+  }
+  if (img != VK_NULL_HANDLE && p.vkDestroyImage) {
+    p.vkDestroyImage(vk_dev->act_dev, img, nullptr);
+  }
+  if (mem != VK_NULL_HANDLE && p.vkFreeMemory) {
+    p.vkFreeMemory(vk_dev->act_dev, mem, nullptr);
+  }
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+std::optional<OutputSlot> CreateDmabufSlot(AVBufferRef* dev_ctx_ref,
+                                           AVVulkanDeviceContext* vk_dev,
+                                           const VkCopyInfo& info,
+                                           int w,
+                                           int h,
+                                           base::TimeDelta pts) {
+  if (!dev_ctx_ref || !vk_dev || !vk_dev->act_dev || !info.procs_ready ||
+      w <= 0 || h <= 0) {
+    return std::nullopt;
+  }
+
+  const auto& p = info.procs;
+  const gfx::Size coded_size(w, h);
+  const gfx::Rect visible_rect(coded_size);
+
+  VkImage dst_img = VK_NULL_HANDLE;
+  VkDeviceMemory dst_mem = VK_NULL_HANDLE;
+
+  uint64_t linear_mod = DRM_FORMAT_MOD_LINEAR;
+  VkImageDrmFormatModifierListCreateInfoEXT mod_list{
+      .sType =
+          VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT,
+      .drmFormatModifierCount = 1,
+      .pDrmFormatModifiers = &linear_mod,
+  };
+  VkExternalMemoryImageCreateInfo ext_info{
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+      .pNext = &mod_list,
+      .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+  };
+  VkImageCreateInfo img_ci{
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .pNext = &ext_info,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM,
+      .extent = {static_cast<uint32_t>(w), static_cast<uint32_t>(h), 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+      .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+  };
+  VkResult ci_res = p.vkCreateImage(vk_dev->act_dev, &img_ci, nullptr, &dst_img);
+  if (ci_res != VK_SUCCESS) {
+    LOG(WARNING) << "VulkanVideoDecoder: vkCreateImage 2PLANE failed: "
+                 << ci_res;
+    CleanupVkImageMemory(vk_dev, p, dst_img, dst_mem);
+    return std::nullopt;
+  }
+
+  VkMemoryRequirements req{};
+  p.vkGetImageMemoryRequirements(vk_dev->act_dev, dst_img, &req);
+  uint32_t mem_idx = UINT32_MAX;
+  for (uint32_t m = 0; m < info.mem_props.memoryTypeCount; ++m) {
+    if ((req.memoryTypeBits & (1u << m)) &&
+        (info.mem_props.memoryTypes[m].propertyFlags &
+         VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+      mem_idx = m;
+      break;
+    }
+  }
+  if (mem_idx == UINT32_MAX) {
+    CleanupVkImageMemory(vk_dev, p, dst_img, dst_mem);
+    return std::nullopt;
+  }
+
+  VkExportMemoryAllocateInfo exp_ai{
+      .sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO,
+      .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+  };
+  VkMemoryDedicatedAllocateInfo ded_ai{
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .pNext = &exp_ai,
+      .image = dst_img,
+  };
+  VkMemoryAllocateInfo mai{
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &ded_ai,
+      .allocationSize = req.size,
+      .memoryTypeIndex = mem_idx,
+  };
+  if (p.vkAllocateMemory(vk_dev->act_dev, &mai, nullptr, &dst_mem) !=
+          VK_SUCCESS ||
+      p.vkBindImageMemory(vk_dev->act_dev, dst_img, dst_mem, 0) != VK_SUCCESS) {
+    CleanupVkImageMemory(vk_dev, p, dst_img, dst_mem);
+    return std::nullopt;
+  }
+
+  VkImageAspectFlags aspects[2] = {VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT,
+                                   VK_IMAGE_ASPECT_MEMORY_PLANE_1_BIT_EXT};
+  uint32_t strides[2]{};
+  uint64_t offsets[2]{};
+  uint64_t sizes[2]{};
+  for (int i = 0; i < 2; ++i) {
+    VkImageSubresource sub{.aspectMask = aspects[i]};
+    VkSubresourceLayout lay{};
+    p.vkGetImageSubresourceLayout(vk_dev->act_dev, dst_img, &sub, &lay);
+    strides[i] = lay.rowPitch > 0 ? static_cast<uint32_t>(lay.rowPitch)
+                                  : static_cast<uint32_t>(w);
+    offsets[i] = lay.offset;
+    sizes[i] = lay.size > 0 ? lay.size : req.size;
+  }
+
+  VkMemoryGetFdInfoKHR fd_info{
+      .sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR,
+      .memory = dst_mem,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+  };
+  int raw_fd = -1;
+  if (p.vkGetMemoryFdKHR(vk_dev->act_dev, &fd_info, &raw_fd) != VK_SUCCESS ||
+      raw_fd < 0) {
+    CleanupVkImageMemory(vk_dev, p, dst_img, dst_mem);
+    return std::nullopt;
+  }
+  base::ScopedFD dst_fd(raw_fd);
+  base::ScopedFD dst_fd_dup(HANDLE_EINTR(dup(dst_fd.get())));
+  if (!dst_fd_dup.is_valid()) {
+    CleanupVkImageMemory(vk_dev, p, dst_img, dst_mem);
+    return std::nullopt;
+  }
+
+  std::vector<ColorPlaneLayout> planes;
+  for (int i = 0; i < 2; ++i) {
+    planes.emplace_back(strides[i], offsets[i], sizes[i]);
+  }
+  std::vector<base::ScopedFD> fds;
+  fds.push_back(std::move(dst_fd));
+  fds.push_back(std::move(dst_fd_dup));
+
+  auto layout = VideoFrameLayout::CreateWithPlanes(
+      PIXEL_FORMAT_NV12, coded_size, std::move(planes),
+      VideoFrameLayout::kBufferAddressAlignment, linear_mod);
+  if (!layout) {
+    CleanupVkImageMemory(vk_dev, p, dst_img, dst_mem);
+    return std::nullopt;
+  }
+
+  auto vf = VideoFrame::WrapExternalDmabufs(
+      *layout, visible_rect, coded_size, std::move(fds), pts);
+  if (!vf) {
+    CleanupVkImageMemory(vk_dev, p, dst_img, dst_mem);
+    return std::nullopt;
+  }
+
+  base::UnguessableToken token = base::UnguessableToken::Create();
+  vf->metadata().tracking_token = token;
+  vf->metadata().power_efficient = true;
+
+  auto origin_frame = VideoFrameResource::Create(std::move(vf));
+  if (!origin_frame) {
+    CleanupVkImageMemory(vk_dev, p, dst_img, dst_mem);
+    return std::nullopt;
+  }
+
+  AVBufferRef* dev_ref = av_buffer_ref(dev_ctx_ref);
+  if (!dev_ref) {
+    CleanupVkImageMemory(vk_dev, p, dst_img, dst_mem);
+    return std::nullopt;
+  }
+
+  origin_frame->AddDestructionObserver(base::BindOnce(
+      &DestroyVkSlotAllocation,
+      VkSlotAllocation{dev_ref, dst_img, dst_mem, p.vkDestroyImage,
+                       p.vkFreeMemory}));
+
+  OutputSlot slot;
+  slot.img = dst_img;
+  slot.mem = dst_mem;
+  slot.token = token;
+  slot.origin_frame = std::move(origin_frame);
+  slot.in_use = false;
+  return slot;
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+bool CopyVkFrameToVkImage(AVVulkanDeviceContext* vk_dev,
+                          const VkCopyInfo& info,
+                          VkCommandPool cmd_pool,
+                          VkCommandBuffer cb,
+                          VkFence fence,
+                          AVFrame* hw_frame,
+                          VkImage dst_img) {
+  if (!vk_dev || !vk_dev->act_dev || !info.procs_ready ||
+      cmd_pool == VK_NULL_HANDLE || cb == VK_NULL_HANDLE ||
+      fence == VK_NULL_HANDLE || !hw_frame || !hw_frame->hw_frames_ctx ||
+      dst_img == VK_NULL_HANDLE) {
+    return false;
+  }
+
+  auto* frames_ctx =
+      reinterpret_cast<AVHWFramesContext*>(hw_frame->hw_frames_ctx->data);
+  if (!frames_ctx || !frames_ctx->device_ctx) {
+    return false;
+  }
+  auto* src_vk = reinterpret_cast<AVVkFrame*>(hw_frame->data[0]);
+  if (!src_vk || src_vk->img[0] == VK_NULL_HANDLE) {
+    return false;
+  }
+
+  const auto& p = info.procs;
+  const int w = hw_frame->width;
+  const int h = hw_frame->height;
+  if (w <= 0 || h <= 0) {
+    return false;
+  }
+
+  if (p.vkResetCommandPool(vk_dev->act_dev, cmd_pool, 0) != VK_SUCCESS ||
+      p.vkResetFences(vk_dev->act_dev, 1, &fence) != VK_SUCCESS) {
+    return false;
+  }
+
+  VkCommandBufferBeginInfo cbbi{
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+  };
+  if (p.vkBeginCommandBuffer(cb, &cbbi) != VK_SUCCESS) {
+    return false;
+  }
+
+  const bool two_imgs = (src_vk->img[1] != VK_NULL_HANDLE);
+  VkImageAspectFlags src_aspect =
+      two_imgs ? VK_IMAGE_ASPECT_COLOR_BIT
+               : (VK_IMAGE_ASPECT_PLANE_0_BIT | VK_IMAGE_ASPECT_PLANE_1_BIT);
+  VkImageMemoryBarrier pre[3]{
+      {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+       .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+       .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+       .oldLayout = src_vk->layout[0],
+       .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+       .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .image = src_vk->img[0],
+       .subresourceRange = {src_aspect, 0, 1, 0, 1}},
+      {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+       .srcAccessMask = VK_ACCESS_MEMORY_READ_BIT,
+       .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+       .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+       .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+       .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .image = dst_img,
+       .subresourceRange = {VK_IMAGE_ASPECT_PLANE_0_BIT |
+                                VK_IMAGE_ASPECT_PLANE_1_BIT,
+                            0, 1, 0, 1}},
+      {},
+  };
+  uint32_t pre_count = 2;
+  if (two_imgs) {
+    pre[2] = {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+              .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+              .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+              .oldLayout = src_vk->layout[1],
+              .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+              .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+              .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+              .image = src_vk->img[1],
+              .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+    pre_count = 3;
+  }
+  p.vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                         VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                         nullptr, pre_count, pre);
+
+  const uint32_t widths[2] = {static_cast<uint32_t>(w),
+                              static_cast<uint32_t>((w + 1) / 2)};
+  const uint32_t heights[2] = {static_cast<uint32_t>(h),
+                               static_cast<uint32_t>((h + 1) / 2)};
+  for (int i = 0; i < 2; ++i) {
+    VkImage src_img = two_imgs ? src_vk->img[i] : src_vk->img[0];
+    VkImageAspectFlags src_plane_aspect =
+        two_imgs ? VK_IMAGE_ASPECT_COLOR_BIT
+                 : (i == 0 ? VK_IMAGE_ASPECT_PLANE_0_BIT
+                           : VK_IMAGE_ASPECT_PLANE_1_BIT);
+    VkImageAspectFlags dst_plane_aspect =
+        (i == 0) ? VK_IMAGE_ASPECT_PLANE_0_BIT : VK_IMAGE_ASPECT_PLANE_1_BIT;
+    VkImageCopy region{
+        .srcSubresource = {src_plane_aspect, 0, 0, 1},
+        .dstSubresource = {dst_plane_aspect, 0, 0, 1},
+        .extent = {widths[i], heights[i], 1},
+    };
+    p.vkCmdCopyImage(cb, src_img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                     dst_img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+  }
+
+  VkImageMemoryBarrier post{
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+      .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = dst_img,
+      .subresourceRange = {VK_IMAGE_ASPECT_PLANE_0_BIT |
+                               VK_IMAGE_ASPECT_PLANE_1_BIT,
+                           0, 1, 0, 1}};
+  p.vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, nullptr, 0,
+                         nullptr, 1, &post);
+  if (p.vkEndCommandBuffer(cb) != VK_SUCCESS) {
+    return false;
+  }
+
+  const uint32_t qf = info.copy_queue_family;
+  VkQueue queue = VK_NULL_HANDLE;
+  p.vkGetDeviceQueue(vk_dev->act_dev, qf, 0, &queue);
+  VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+  uint64_t wait_val = src_vk->sem_value[0];
+  uint64_t sig_val = wait_val + 1;
+  VkTimelineSemaphoreSubmitInfo tl_info{
+      .sType = VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO,
+      .waitSemaphoreValueCount = 1,
+      .pWaitSemaphoreValues = &wait_val,
+      .signalSemaphoreValueCount = 1,
+      .pSignalSemaphoreValues = &sig_val,
+  };
+  const bool has_sem = (src_vk->sem[0] != VK_NULL_HANDLE);
+  VkSubmitInfo si{
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .pNext = has_sem ? &tl_info : nullptr,
+      .waitSemaphoreCount = has_sem ? 1u : 0u,
+      .pWaitSemaphores = has_sem ? &src_vk->sem[0] : nullptr,
+      .pWaitDstStageMask = has_sem ? &wait_stage : nullptr,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cb,
+      .signalSemaphoreCount = has_sem ? 1u : 0u,
+      .pSignalSemaphores = has_sem ? &src_vk->sem[0] : nullptr,
+  };
+  if (vk_dev->lock_queue) {
+    vk_dev->lock_queue(frames_ctx->device_ctx, qf, 0);
+  }
+  VkResult sr = p.vkQueueSubmit(queue, 1, &si, fence);
+  if (vk_dev->unlock_queue) {
+    vk_dev->unlock_queue(frames_ctx->device_ctx, qf, 0);
+  }
+  if (sr == VK_SUCCESS) {
+    src_vk->layout[0] = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    src_vk->access[0] = VK_ACCESS_2_TRANSFER_READ_BIT;
+    src_vk->queue_family[0] = qf;
+    if (two_imgs) {
+      src_vk->layout[1] = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+      src_vk->access[1] = VK_ACCESS_2_TRANSFER_READ_BIT;
+      src_vk->queue_family[1] = qf;
+    }
+    if (has_sem) {
+      src_vk->sem_value[0] = sig_val;
+    }
+  }
+  VkResult wr = VK_ERROR_UNKNOWN;
+  if (sr == VK_SUCCESS) {
+    wr = p.vkWaitForFences(vk_dev->act_dev, 1, &fence, VK_TRUE, 1000000000ULL);
+  }
+  if (sr != VK_SUCCESS || wr != VK_SUCCESS) {
+    LOG(WARNING) << "VulkanVideoDecoder: CopyVkFrameToVkImage failed sr=" << sr
+                 << " wr=" << wr << " qf=" << qf;
+    return false;
+  }
+  return true;
+}
+
+enum AVPixelFormat GetVulkanHwFormat(AVCodecContext* ctx,
+                                     const enum AVPixelFormat* pix_fmts) {
+  for (const enum AVPixelFormat* p = pix_fmts; *p != AV_PIX_FMT_NONE; ++p) {
+    if (*p == AV_PIX_FMT_VULKAN) {
+      return *p;
+    }
+  }
+  return AV_PIX_FMT_NONE;
+}
