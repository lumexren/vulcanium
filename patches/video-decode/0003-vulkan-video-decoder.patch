+NO_SANITIZE("cfi") __attribute__((noinline))
+void FreeVkSlotAllocation(AVBufferRef* dev_ctx_ref,
+                          VkImage img,
+                          VkDeviceMemory mem,
+                          PFN_vkDestroyImage pfn_destroy_image,
+                          PFN_vkFreeMemory pfn_free_memory) {
+  if (!dev_ctx_ref) {
+    return;
+  }
+  auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(dev_ctx_ref->data);
+  auto* vk_dev =
+      dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+  if (vk_dev && vk_dev->act_dev) {
+    if (img != VK_NULL_HANDLE && pfn_destroy_image) {
+      pfn_destroy_image(vk_dev->act_dev, img, nullptr);
+    }
+    if (mem != VK_NULL_HANDLE && pfn_free_memory) {
+      pfn_free_memory(vk_dev->act_dev, mem, nullptr);
+    }
+  }
+  av_buffer_unref(&dev_ctx_ref);
+}
+
+// Move-only RAII holder ensuring VkImage/VkDeviceMemory and AVBufferRef are
+// freed even if a pending sync/fence callback is dropped during shutdown.
+class VkSlotAllocation {
+ public:
+  VkSlotAllocation() = default;
+  VkSlotAllocation(AVBufferRef* dev_ctx_ref,
+                   VkImage img,
+                   VkDeviceMemory mem,
+                   PFN_vkDestroyImage pfn_destroy_image,
+                   PFN_vkFreeMemory pfn_free_memory)
+      : dev_ctx_ref_(dev_ctx_ref),
+        img_(img),
+        mem_(mem),
+        pfn_destroy_image_(pfn_destroy_image),
+        pfn_free_memory_(pfn_free_memory) {}
+
+  VkSlotAllocation(const VkSlotAllocation&) = delete;
+  VkSlotAllocation& operator=(const VkSlotAllocation&) = delete;
+
+  VkSlotAllocation(VkSlotAllocation&& other) noexcept
+      : dev_ctx_ref_(std::exchange(other.dev_ctx_ref_, nullptr)),
+        img_(std::exchange(other.img_, VK_NULL_HANDLE)),
+        mem_(std::exchange(other.mem_, VK_NULL_HANDLE)),
+        pfn_destroy_image_(std::exchange(other.pfn_destroy_image_, nullptr)),
+        pfn_free_memory_(std::exchange(other.pfn_free_memory_, nullptr)) {}
+
+  VkSlotAllocation& operator=(VkSlotAllocation&& other) noexcept {
+    if (this != &other) {
+      Reset();
+      dev_ctx_ref_ = std::exchange(other.dev_ctx_ref_, nullptr);
+      img_ = std::exchange(other.img_, VK_NULL_HANDLE);
+      mem_ = std::exchange(other.mem_, VK_NULL_HANDLE);
+      pfn_destroy_image_ = std::exchange(other.pfn_destroy_image_, nullptr);
+      pfn_free_memory_ = std::exchange(other.pfn_free_memory_, nullptr);
+    }
+    return *this;
+  }
+
+  ~VkSlotAllocation() { Reset(); }
+
+  void Reset() {
+    if (dev_ctx_ref_) {
+      AVBufferRef* ref = std::exchange(dev_ctx_ref_, nullptr);
+      VkImage img = std::exchange(img_, VK_NULL_HANDLE);
+      VkDeviceMemory mem = std::exchange(mem_, VK_NULL_HANDLE);
+      PFN_vkDestroyImage destroy_fn = std::exchange(pfn_destroy_image_, nullptr);
+      PFN_vkFreeMemory free_fn = std::exchange(pfn_free_memory_, nullptr);
+      FreeVkSlotAllocation(ref, img, mem, destroy_fn, free_fn);
+    }
+  }
+
+ private:
+  AVBufferRef* dev_ctx_ref_ = nullptr;
+  VkImage img_ = VK_NULL_HANDLE;
+  VkDeviceMemory mem_ = VK_NULL_HANDLE;
+  PFN_vkDestroyImage pfn_destroy_image_ = nullptr;
+  PFN_vkFreeMemory pfn_free_memory_ = nullptr;
+};
+
+void PostCleanupAfterGpuWork(scoped_refptr<GpuSlotSync> gpu_slot_sync,
+                             scoped_refptr<SlotSyncState> sync_state,
+                             bool for_backing_destruction,
+                             base::OnceClosure cleanup_cb) {
+  if (!cleanup_cb) {
+    return;
+  }
+  const bool converted =
+      sync_state && (for_backing_destruction
+                         ? sync_state->WasEverConverted()
+                         : sync_state->WasCurrentEmitConverted());
+  if (!gpu_slot_sync || !converted) {
+    std::move(cleanup_cb).Run();
+    return;
+  }
+  auto run_sync = base::BindOnce(
+      [](scoped_refptr<GpuSlotSync> sync,
+         scoped_refptr<SlotSyncState> state,
+         base::OnceClosure cb) {
+        sync->RunAfterGpuWork(state->GetReleaseSyncTokens(), std::move(cb));
+      },
+      std::move(gpu_slot_sync), std::move(sync_state),
+      std::move(cleanup_cb));
+  if (base::SequencedTaskRunner::HasCurrentDefault()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(run_sync));
+    return;
+  }
+  std::move(run_sync).Run();
+}
