+struct VkCopyProcs {
+  PFN_vkCreateImage vkCreateImage = nullptr;
+  PFN_vkDestroyImage vkDestroyImage = nullptr;
+  PFN_vkGetImageMemoryRequirements vkGetImageMemoryRequirements = nullptr;
+  PFN_vkGetImageMemoryRequirements2 vkGetImageMemoryRequirements2 = nullptr;
+  PFN_vkAllocateMemory vkAllocateMemory = nullptr;
+  PFN_vkFreeMemory vkFreeMemory = nullptr;
+  PFN_vkBindImageMemory vkBindImageMemory = nullptr;
+  PFN_vkBindImageMemory2 vkBindImageMemory2 = nullptr;
+  PFN_vkGetImageSubresourceLayout vkGetImageSubresourceLayout = nullptr;
+  PFN_vkGetMemoryFdKHR vkGetMemoryFdKHR = nullptr;
+  PFN_vkGetMemoryFdPropertiesKHR vkGetMemoryFdPropertiesKHR = nullptr;
+  PFN_vkCreateCommandPool vkCreateCommandPool = nullptr;
+  PFN_vkDestroyCommandPool vkDestroyCommandPool = nullptr;
+  PFN_vkResetCommandPool vkResetCommandPool = nullptr;
+  PFN_vkAllocateCommandBuffers vkAllocateCommandBuffers = nullptr;
+  PFN_vkBeginCommandBuffer vkBeginCommandBuffer = nullptr;
+  PFN_vkEndCommandBuffer vkEndCommandBuffer = nullptr;
+  PFN_vkCmdPipelineBarrier vkCmdPipelineBarrier = nullptr;
+  PFN_vkCmdCopyImage vkCmdCopyImage = nullptr;
+  PFN_vkCreateFence vkCreateFence = nullptr;
+  PFN_vkDestroyFence vkDestroyFence = nullptr;
+  PFN_vkResetFences vkResetFences = nullptr;
+  PFN_vkGetFenceStatus vkGetFenceStatus = nullptr;
+  PFN_vkWaitForFences vkWaitForFences = nullptr;
+  PFN_vkQueueSubmit vkQueueSubmit = nullptr;
+  PFN_vkGetDeviceQueue vkGetDeviceQueue = nullptr;
+  PFN_vkGetPhysicalDeviceMemoryProperties
+      vkGetPhysicalDeviceMemoryProperties = nullptr;
+  PFN_vkEnumerateDeviceExtensionProperties
+      vkEnumerateDeviceExtensionProperties = nullptr;
+  PFN_vkGetPhysicalDeviceVideoCapabilitiesKHR
+      vkGetPhysicalDeviceVideoCapabilitiesKHR = nullptr;
+  PFN_vkGetPhysicalDeviceFormatProperties2
+      vkGetPhysicalDeviceFormatProperties2 = nullptr;
+  PFN_vkGetPhysicalDeviceImageFormatProperties2
+      vkGetPhysicalDeviceImageFormatProperties2 = nullptr;
+  PFN_vkGetImageDrmFormatModifierPropertiesEXT
+      vkGetImageDrmFormatModifierPropertiesEXT = nullptr;
+};
+
+struct VkCopyInfo {
+  VkCopyProcs procs;
+  VkPhysicalDeviceMemoryProperties mem_props{};
+  std::vector<uint64_t> preferred_nv12_modifiers;
+  uint32_t copy_queue_family = 0;
+  bool copy_queue_is_dedicated_transfer = false;
+  bool procs_ready = false;
+};
+
+struct CodecCapability {
+  bool supported = false;
+  gfx::Size min_size{64, 64};
+  gfx::Size max_size{4096, 4096};
+};
+
+struct VulkanVideoCapabilities {
+  bool probed = false;
+  bool has_decode_queue = false;
+  bool has_encode_queue = false;
+  CodecCapability decode_h264;
+  CodecCapability decode_hevc;
+  CodecCapability decode_hevc_10bit;
+  CodecCapability decode_vp9;
+  CodecCapability decode_vp9_10bit;
+  CodecCapability decode_av1;
+  CodecCapability decode_av1_10bit;
+  CodecCapability encode_h264;
+  CodecCapability encode_hevc;
+  CodecCapability encode_av1;
+};
+
+// Holds a single GPU-process-wide FFmpeg AV_HWDEVICE_TYPE_VULKAN context,
+// resolved Vulkan function pointers, and cached hardware video capabilities so
+// decoders and encoders share one VkDevice and avoid repeated device creation.
+class MEDIA_GPU_EXPORT VulkanVideoDevice {
+ public:
+  static VulkanVideoDevice* GetInstance();
+
+  AVBufferRef* AcquireDevice();
+  const VkCopyInfo* GetCopyInfo() const { return &copy_info_; }
+  const VulkanVideoCapabilities& GetCapabilities();
+
+ private:
+  friend class base::NoDestructor<VulkanVideoDevice>;
+  VulkanVideoDevice() = default;
+  ~VulkanVideoDevice() = delete;
+
+  bool EnsureInitializedLocked();
+
+  base::Lock lock_;
+  AVBufferRef* device_ctx_ = nullptr;
+  VkCopyInfo copy_info_;
+  bool copy_info_attempted_ = false;
+  VulkanVideoCapabilities caps_;
+};
+
+MEDIA_GPU_EXPORT bool CreateCopyCmdResources(AVVulkanDeviceContext* vk_dev,
+                                             const VkCopyInfo& info,
+                                             VkCommandPool* pool_out,
+                                             VkCommandBuffer* buf_out,
+                                             VkFence* fence_out);
+
+MEDIA_GPU_EXPORT void DestroyCopyCmdResources(AVVulkanDeviceContext* vk_dev,
+                                              const VkCopyProcs& procs,
+                                              VkCommandPool pool,
+                                              VkFence fence);
+
+MEDIA_GPU_EXPORT VkResult GetFenceStatus(AVVulkanDeviceContext* vk_dev,
+                                         const VkCopyProcs& procs,
+                                         VkFence fence);
+
+MEDIA_GPU_EXPORT VkResult WaitForFence(AVVulkanDeviceContext* vk_dev,
+                                       const VkCopyProcs& procs,
+                                       VkFence fence,
+                                       uint64_t timeout_ns);
+
+MEDIA_GPU_EXPORT void CleanupVkImageMemory(AVVulkanDeviceContext* vk_dev,
+                                           const VkCopyProcs& procs,
+                                           VkImage img,
+                                           VkDeviceMemory mem);
+
+}  // namespace media
+
+#endif  // MEDIA_GPU_VULKAN_VULKAN_VIDEO_DEVICE_H_
