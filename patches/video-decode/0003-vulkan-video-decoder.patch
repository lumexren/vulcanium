+NO_SANITIZE("cfi") __attribute__((noinline))
+bool ResolveAngleVkFenceProcs(VkDevice* out_device,
+                              VkQueue* out_queue,
+                              void** out_display,
+                              PFN_vkCreateFence* out_create,
+                              PFN_vkQueueSubmit* out_submit,
+                              PFN_vkGetFenceStatus* out_status,
+                              PFN_vkDestroyFence* out_destroy) {
+  if (gl::GetGLImplementation() != gl::kGLImplementationEGLANGLE ||
+      gl::GetANGLEImplementation() != gl::ANGLEImplementation::kVulkan) {
+    return false;
+  }
+  PFN_vkGetInstanceProcAddr gipa = gl::QueryVkGetInstanceProcAddrFromANGLE();
+  VkInstance vk_instance = gl::QueryVkInstanceFromANGLE();
+  VkDevice vk_device = gl::QueryVkDeviceFromANGLE();
+  VkQueue vk_queue = gl::QueryVkQueueFromANGLE();
+  void* display = gl::QueryDisplayFromANGLE();
+  if (!gipa || vk_instance == VK_NULL_HANDLE || vk_device == VK_NULL_HANDLE ||
+      vk_queue == VK_NULL_HANDLE || !display) {
+    return false;
+  }
+  auto gdpa = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+      gipa(vk_instance, "vkGetDeviceProcAddr"));
+  if (!gdpa) {
+    return false;
+  }
+  auto pfn_create =
+      reinterpret_cast<PFN_vkCreateFence>(gdpa(vk_device, "vkCreateFence"));
+  auto pfn_submit =
+      reinterpret_cast<PFN_vkQueueSubmit>(gdpa(vk_device, "vkQueueSubmit"));
+  auto pfn_status = reinterpret_cast<PFN_vkGetFenceStatus>(
+      gdpa(vk_device, "vkGetFenceStatus"));
+  auto pfn_destroy =
+      reinterpret_cast<PFN_vkDestroyFence>(gdpa(vk_device, "vkDestroyFence"));
+  if (!pfn_create || !pfn_submit || !pfn_status || !pfn_destroy) {
+    return false;
+  }
+  *out_device = vk_device;
+  *out_queue = vk_queue;
+  *out_display = display;
+  *out_create = pfn_create;
+  *out_submit = pfn_submit;
+  *out_status = pfn_status;
+  *out_destroy = pfn_destroy;
+  return true;
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+VkFence SubmitAngleVkFence(VkDevice dev,
+                           VkQueue queue,
+                           void* display,
+                           PFN_vkCreateFence pfn_create,
+                           PFN_vkQueueSubmit pfn_submit,
+                           PFN_vkDestroyFence pfn_destroy) {
+  if (dev == VK_NULL_HANDLE || queue == VK_NULL_HANDLE || !display ||
+      !pfn_create || !pfn_submit || !pfn_destroy) {
+    return VK_NULL_HANDLE;
+  }
+  VkFenceCreateInfo fci{.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkFence fence = VK_NULL_HANDLE;
+  if (pfn_create(dev, &fci, nullptr, &fence) != VK_SUCCESS ||
+      fence == VK_NULL_HANDLE) {
+    return VK_NULL_HANDLE;
+  }
+  gl::LockVkQueueInANGLE(display);
+  VkResult sr = pfn_submit(queue, 0, nullptr, fence);
+  gl::UnlockVkQueueInANGLE(display);
+  if (sr != VK_SUCCESS) {
+    pfn_destroy(dev, fence, nullptr);
+    return VK_NULL_HANDLE;
+  }
+  return fence;
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+VkResult GetAngleVkFenceStatus(VkDevice dev,
+                               PFN_vkGetFenceStatus pfn_status,
+                               VkFence fence) {
+  if (dev == VK_NULL_HANDLE || !pfn_status || fence == VK_NULL_HANDLE) {
+    return VK_SUCCESS;
+  }
+  return pfn_status(dev, fence);
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+void DestroyAngleVkFence(VkDevice dev,
+                         PFN_vkDestroyFence pfn_destroy,
+                         VkFence fence) {
+  if (dev != VK_NULL_HANDLE && pfn_destroy && fence != VK_NULL_HANDLE) {
+    pfn_destroy(dev, fence, nullptr);
+  }
+}
