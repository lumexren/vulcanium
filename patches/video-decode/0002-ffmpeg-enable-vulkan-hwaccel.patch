--- a/third_party/ffmpeg/BUILD.gn
+++ b/third_party/ffmpeg/BUILD.gn
@@ -273,6 +273,9 @@
   deps = [
     ":ffmpeg_features",
     "//third_party/opus",
   ]
+  if (is_linux) {
+    deps += [ "//third_party/vulkan-headers/src:vulkan_headers" ]
+  }
 
   configs -= [ "//build/config/compiler:chromium_code" ]
--- a/third_party/ffmpeg/ffmpeg_generated.gni
+++ b/third_party/ffmpeg/ffmpeg_generated.gni
@@ -613,3 +613,16 @@
     (is_android && current_cpu == "x86")) {
   ffmpeg_c_sources += [ "compat/strtod.c" ]
 }
+
+if (is_linux && current_cpu == "x64" && ffmpeg_branding == "Chrome") {
+  ffmpeg_c_sources += [
+    "libavcodec/vulkan.c",
+    "libavcodec/vulkan_av1.c",
+    "libavcodec/vulkan_decode.c",
+    "libavcodec/vulkan_h264.c",
+    "libavcodec/vulkan_video.c",
+    "libavcodec/vulkan_vp9.c",
+    "libavutil/hwcontext_vulkan.c",
+    "libavutil/vulkan.c",
+  ]
+}
