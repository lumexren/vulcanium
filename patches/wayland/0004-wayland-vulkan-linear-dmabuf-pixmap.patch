+bool GbmPixmapWayland::InitializeVulkanLinearBuffer(
+    gfx::AcceleratedWidget widget,
+    gpu::VulkanDeviceQueue* device_queue,
+    gfx::Size size,
+    viz::SharedImageFormat format,
+    std::optional<gfx::Size> visible_area_size) {
+#if BUILDFLAG(ENABLE_VULKAN)
+  if (!device_queue) {
+    return false;
+  }
+  VkFormat vk_format = VK_FORMAT_UNDEFINED;
+  if (format == viz::SinglePlaneFormat::kRGBA_8888 ||
+      format == viz::SinglePlaneFormat::kRGBX_8888) {
+    vk_format = VK_FORMAT_R8G8B8A8_UNORM;
+  } else if (format == viz::SinglePlaneFormat::kBGRA_8888 ||
+             format == viz::SinglePlaneFormat::kBGRX_8888) {
+    vk_format = VK_FORMAT_B8G8R8A8_UNORM;
+  } else {
+    return false;
+  }
+
+  constexpr VkImageUsageFlags kUsage =
+      VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+      VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+  auto vk_image = gpu::VulkanImage::CreateWithExternalMemoryAndModifiers(
+      device_queue, size, vk_format, {DRM_FORMAT_MOD_LINEAR}, kUsage, 0);
+  if (!vk_image) {
+    return false;
+  }
+
+  base::ScopedFD fd =
+      vk_image->GetMemoryFd(VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT);
+  if (!fd.is_valid()) {
+    vk_image->Destroy();
+    return false;
+  }
+
+  gfx::NativePixmapHandle handle;
+  const auto& layout = vk_image->layouts()[0];
+  uint32_t stride = layout.rowPitch > 0 ? static_cast<uint32_t>(layout.rowPitch)
+                                        : static_cast<uint32_t>(size.width() * 4);
+  uint64_t plane_size = layout.size > 0
+                            ? static_cast<uint64_t>(layout.size)
+                            : static_cast<uint64_t>(stride) * size.height();
+  handle.planes.emplace_back(stride, static_cast<uint64_t>(layout.offset),
+                             plane_size, std::move(fd));
+  handle.modifier = vk_image->modifier();
+  vk_image->Destroy();
+
+  widget_ = widget;
+  vulkan_handle_ = std::move(handle);
+  vulkan_format_ = format;
+  vulkan_size_ = size;
+  visible_area_size_ = visible_area_size.value_or(size);
+  return true;
+#else
+  return false;
+#endif
+}
