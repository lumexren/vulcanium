+bool GbmPixmapWayland::InitializeVulkanBuffer(
+    gfx::AcceleratedWidget widget,
+    gpu::VulkanDeviceQueue* device_queue,
+    gfx::Size size,
+    viz::SharedImageFormat format,
+    NativePixmapUsageSet usage,
+    std::optional<gfx::Size> visible_area_size) {
+#if BUILDFLAG(ENABLE_VULKAN)
+  if (!device_queue) {
+    return false;
+  }
+  VkFormat vk_format = VK_FORMAT_UNDEFINED;
+  uint32_t bytes_per_pixel = 4;
+  if (format == viz::SinglePlaneFormat::kRGBA_8888 ||
+      format == viz::SinglePlaneFormat::kRGBX_8888) {
+    vk_format = VK_FORMAT_R8G8B8A8_UNORM;
+  } else if (format == viz::SinglePlaneFormat::kBGRA_8888 ||
+             format == viz::SinglePlaneFormat::kBGRX_8888) {
+    vk_format = VK_FORMAT_B8G8R8A8_UNORM;
+  } else if (format == viz::SinglePlaneFormat::kBGRA_1010102) {
+    vk_format = VK_FORMAT_A2R10G10B10_UNORM_PACK32;
+  } else if (format == viz::SinglePlaneFormat::kRGBA_1010102) {
+    vk_format = VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+  } else if (format == viz::SinglePlaneFormat::kRGBA_F16) {
+    vk_format = VK_FORMAT_R16G16B16A16_SFLOAT;
+    bytes_per_pixel = 8;
+  } else {
+    return false;
+  }
+
+  constexpr VkImageUsageFlags kUsage =
+      VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+      VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+
+  const auto try_allocate = [&](std::vector<uint64_t> mods)
+      -> std::optional<gfx::NativePixmapHandle> {
+    if (mods.empty()) {
+      return std::nullopt;
+    }
+    auto vk_image = gpu::VulkanImage::CreateWithExternalMemoryAndModifiers(
+        device_queue, size, vk_format, std::move(mods), kUsage, 0);
+    if (!vk_image) {
+      return std::nullopt;
+    }
+
+    const size_t plane_count = vk_image->plane_count();
+    const uint64_t chosen_mod = vk_image->modifier();
+    if (plane_count == 0 || plane_count > vk_image->layouts().size()) {
+      vk_image->Destroy();
+      return std::nullopt;
+    }
+    if (chosen_mod != DRM_FORMAT_MOD_LINEAR) {
+      for (size_t i = 0; i < plane_count; ++i) {
+        if (vk_image->layouts()[i].rowPitch == 0) {
+          vk_image->Destroy();
+          return std::nullopt;
+        }
+      }
+    }
+
+    base::ScopedFD fd =
+        vk_image->GetMemoryFd(VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT);
+    if (!fd.is_valid()) {
+      vk_image->Destroy();
+      return std::nullopt;
+    }
+
+    gfx::NativePixmapHandle handle;
+    handle.modifier = chosen_mod;
+    handle.planes.reserve(plane_count);
+    for (size_t i = 0; i < plane_count; ++i) {
+      base::ScopedFD plane_fd;
+      if (i + 1 < plane_count) {
+        plane_fd.reset(HANDLE_EINTR(dup(fd.get())));
+        if (!plane_fd.is_valid()) {
+          vk_image->Destroy();
+          return std::nullopt;
+        }
+      } else {
+        plane_fd = std::move(fd);
+      }
+
+      const auto& layout = vk_image->layouts()[i];
+      uint32_t stride =
+          layout.rowPitch > 0
+              ? static_cast<uint32_t>(layout.rowPitch)
+              : static_cast<uint32_t>(size.width() * bytes_per_pixel);
+      uint64_t plane_size =
+          layout.size > 0
+              ? static_cast<uint64_t>(layout.size)
+              : (chosen_mod == DRM_FORMAT_MOD_LINEAR
+                     ? static_cast<uint64_t>(stride) * size.height()
+                     : static_cast<uint64_t>(vk_image->device_size()));
+      handle.planes.emplace_back(stride, static_cast<uint64_t>(layout.offset),
+                                 plane_size, std::move(plane_fd));
+    }
+    vk_image->Destroy();
+    return handle;
+  };
+
+  const uint32_t gbm_flags = ui::NativePixmapUsageToGbmFlags(usage);
+  const bool require_linear =
+      (gbm_flags & (GBM_BO_USE_LINEAR | GBM_BO_USE_FRONT_RENDERING)) != 0;
+
+  std::optional<gfx::NativePixmapHandle> handle;
+  if (!require_linear) {
+    std::vector<uint64_t> tiled_modifiers;
+    for (uint64_t mod : buffer_manager_->GetModifiersForFormat(format)) {
+      if (mod != DRM_FORMAT_MOD_INVALID && mod != DRM_FORMAT_MOD_LINEAR) {
+        tiled_modifiers.push_back(mod);
+      }
+    }
+    if (!tiled_modifiers.empty()) {
+      handle = try_allocate(std::move(tiled_modifiers));
+    }
+  }
+  if (!handle) {
+    handle = try_allocate({DRM_FORMAT_MOD_LINEAR});
+  }
+  if (!handle) {
+    return false;
+  }
+
+  static bool logged_vk_pixmap = false;
+  if (!logged_vk_pixmap) {
+    logged_vk_pixmap = true;
+    VLOG(1) << "GbmPixmapWayland::InitializeVulkanBuffer selected modifier=0x"
+            << std::hex << handle->modifier << std::dec
+            << " planes=" << handle->planes.size();
+  }
+
+  widget_ = widget;
+  vulkan_handle_ = std::move(handle);
+  vulkan_format_ = format;
+  vulkan_size_ = size;
+  visible_area_size_ = visible_area_size.value_or(size);
+  return true;
+#else
+  return false;
+#endif
+}
+
 bool GbmPixmapWayland::AreDmaBufFdsValid() const {
+  if (vulkan_handle_) {
+    if (vulkan_handle_->planes.empty()) {
+      return false;
+    }
+    for (const auto& plane : vulkan_handle_->planes) {
+      if (!plane.fd.is_valid()) {
+        return false;
+      }
+    }
+    return true;
+  }
   return gbm_bo_->AreFdsValid();
 }
 
 int GbmPixmapWayland::GetDmaBufFd(size_t plane) const {
+  if (vulkan_handle_) {
+    return vulkan_handle_->planes[plane].fd.get();
+  }
   return gbm_bo_->GetPlaneFd(plane);
 }
 
