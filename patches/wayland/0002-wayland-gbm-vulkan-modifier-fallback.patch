+  if (!overlay_plane_data.enable_blend || overlay_plane_data.z_order == 0) {
+    if (wl_format == DRM_FORMAT_ABGR8888) {
+      wl_format = DRM_FORMAT_XBGR8888;
+    } else if (wl_format == DRM_FORMAT_ARGB8888) {
+      wl_format = DRM_FORMAT_XRGB8888;
+    }
+  }
+
   // Asks Wayland to create a wl_buffer based on the |file| fd.
   buffer_manager_->CreateDmabufBasedBuffer(
       std::move(fd), visible_area_size_, strides, offsets, modifiers,
