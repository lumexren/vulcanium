+bool HasNvidiaDrmRenderNode() {
+  static const bool has_nvidia = []() {
+    base::FileEnumerator enumerator(base::FilePath("/sys/class/drm"),
+                                    /*recursive=*/false,
+                                    base::FileEnumerator::NAMES_ONLY,
+                                    "renderD*");
+    for (base::FilePath dir = enumerator.Next(); !dir.empty();
+         dir = enumerator.Next()) {
+      std::string vendor;
+      if (base::ReadFileToString(dir.Append("device/vendor"), &vendor)) {
+        base::TrimWhitespaceASCII(vendor, base::TRIM_ALL, &vendor);
+        if (base::EqualsCaseInsensitiveASCII(vendor, "0x10de")) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }();
+  return has_nvidia;
+}
+
+bool IsVulkanRequested(const base::CommandLine* cmd) {
+  if (cmd && cmd->HasSwitch("disable-vulkan")) {
+    return false;
+  }
+  if (cmd && cmd->HasSwitch("use-vulkan")) {
+    const std::string val = cmd->GetSwitchValueASCII("use-vulkan");
+    if (val != "disabled" && val != "none") {
+      return true;
+    }
+  }
+  if (const auto* fl = base::FeatureList::GetInstance()) {
+    return fl->IsFeatureOverriddenFromCommandLine(
+               "Vulkan", base::FeatureList::OVERRIDE_ENABLE_FEATURE) ||
+           fl->IsFeatureOverriddenFromCommandLine(
+               "DefaultANGLEVulkan",
+               base::FeatureList::OVERRIDE_ENABLE_FEATURE);
+  }
+  if (cmd) {
+    for (std::string_view tok : base::SplitStringPiece(
+             cmd->GetSwitchValueASCII("enable-features"), ",",
+             base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      std::string_view feat_name = tok.substr(0, tok.find_first_of(":<"));
+      if (feat_name == "Vulkan" || feat_name == "DefaultANGLEVulkan") {
+        return true;
+      }
+    }
+  }
+  return false;
+}
