+  base::circular_deque<OutputBuffer> available_bitstream_buffers_;
+  base::circular_deque<PendingOutput> pending_outputs_;
+  base::circular_deque<base::TimeDelta> pending_timestamps_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
