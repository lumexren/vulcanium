+
+VideoEncodeAccelerator::SupportedProfiles
+VulkanVideoEncodeAccelerator::GetSupportedProfiles() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  SupportedProfiles profiles;
+  const auto& caps = VulkanVideoDevice::GetInstance()->GetCapabilities();
+  if (!caps.has_encode_queue) {
+    return profiles;
+  }
+
+  const auto add_profile = [&](VideoCodecProfile codec_profile,
+                               const CodecCapability& cap) {
+    SupportedProfile p;
+    p.profile = codec_profile;
+    p.min_resolution = cap.min_size;
+    p.max_resolution = cap.max_size;
+    p.max_framerate_numerator = 60;
+    p.max_framerate_denominator = 1;
+    p.rate_control_modes =
+        VideoEncodeAccelerator::kConstantMode |
+        VideoEncodeAccelerator::kVariableMode;
+    p.is_software_codec = false;
+    profiles.push_back(p);
+  };
+
+  if (caps.encode_h264.supported && avcodec_find_encoder_by_name("h264_vulkan")) {
+    add_profile(H264PROFILE_BASELINE, caps.encode_h264);
+    add_profile(H264PROFILE_MAIN, caps.encode_h264);
+    add_profile(H264PROFILE_HIGH, caps.encode_h264);
+  }
+  if (caps.encode_hevc.supported && avcodec_find_encoder_by_name("hevc_vulkan")) {
+    add_profile(HEVCPROFILE_MAIN, caps.encode_hevc);
+  }
+  if (caps.encode_av1.supported && avcodec_find_encoder_by_name("av1_vulkan")) {
+    add_profile(AV1PROFILE_PROFILE_MAIN, caps.encode_av1);
+  }
+
+  return profiles;
+}
+
+EncoderStatus VulkanVideoEncodeAccelerator::Initialize(
+    const Config& config,
+    Client* client,
+    std::unique_ptr<MediaLog> media_log) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  client_ = client;
+  media_log_ = std::move(media_log);
+
+  if (!client_) {
+    return EncoderStatus::Codes::kEncoderInitializationError;
+  }
+
+  if (config.input_format != PIXEL_FORMAT_NV12 &&
+      config.input_format != PIXEL_FORMAT_I420) {
+    return {EncoderStatus::Codes::kUnsupportedFrameFormat,
+            "VulkanVideoEncodeAccelerator only supports NV12 and I420 inputs"};
+  }
+
+  if (!EncoderNameForProfile(config.output_profile)) {
+    return {EncoderStatus::Codes::kEncoderUnsupportedProfile,
+            "Unsupported Vulkan encode profile"};
+  }
+
+  if (!ConfigureEncoder(config)) {
+    ReleaseResources();
+    return EncoderStatus::Codes::kEncoderInitializationError;
+  }
+
+  active_config_ = config;
+  input_visible_size_ = config.input_visible_size;
+  output_buffer_size_ =
+      std::max<size_t>(kMinOutputBufferSize, input_visible_size_.GetArea() * 2);
+  initialized_ = true;
+  has_error_ = false;
+  logged_zero_copy_ = false;
+
+  VideoEncoderInfo info;
+  info.implementation_name = "VulkanVideoEncodeAccelerator";
+  info.is_hardware_accelerated = true;
+  info.supports_native_handle = true;
+  info.supports_frame_size_change = true;
+  client_->NotifyEncoderInfoChange(info);
+
+  client_->RequireBitstreamBuffers(/*input_count=*/2, input_visible_size_,
+                                   output_buffer_size_);
+  return EncoderStatus::Codes::kOk;
+}
+
+bool VulkanVideoEncodeAccelerator::ConfigureEncoder(const Config& config) {
+  ReleaseResources();
+
+  const char* encoder_name = EncoderNameForProfile(config.output_profile);
+  const AVCodec* codec =
+      encoder_name ? avcodec_find_encoder_by_name(encoder_name) : nullptr;
+  if (!codec) {
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: encoder not found";
+    return false;
+  }
+
+  hw_device_ctx_ = VulkanVideoDevice::GetInstance()->AcquireDevice();
+  if (!hw_device_ctx_) {
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: failed to acquire Vulkan device";
+    return false;
+  }
+
+  AVBufferRef* frames_ref = av_hwframe_ctx_alloc(hw_device_ctx_);
+  if (!frames_ref) {
+    return false;
+  }
+  auto* frames_ctx = reinterpret_cast<AVHWFramesContext*>(frames_ref->data);
+  frames_ctx->format = AV_PIX_FMT_VULKAN;
+  frames_ctx->sw_format = AV_PIX_FMT_NV12;
+  frames_ctx->width = std::max(64, config.input_visible_size.width());
+  frames_ctx->height = std::max(64, config.input_visible_size.height());
+  frames_ctx->initial_pool_size = 4;
+
+  int err = av_hwframe_ctx_init(frames_ref);
+  if (err < 0) {
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: av_hwframe_ctx_init failed: "
+               << AVErrorToString(err);
+    av_buffer_unref(&frames_ref);
+    return false;
+  }
+  hw_frames_ctx_ = frames_ref;
+
+  codec_context_.reset(avcodec_alloc_context3(codec));
+  if (!codec_context_) {
+    return false;
+  }
+
+  uint32_t fps = config.framerate > 0 ? config.framerate : 30u;
+  codec_context_->width = config.input_visible_size.width();
+  codec_context_->height = config.input_visible_size.height();
+  codec_context_->time_base = AVRational{1, 1000000};
+  codec_context_->framerate = AVRational{static_cast<int>(fps), 1};
+  codec_context_->pix_fmt = AV_PIX_FMT_VULKAN;
+  codec_context_->hw_device_ctx = av_buffer_ref(hw_device_ctx_);
+  codec_context_->hw_frames_ctx = av_buffer_ref(hw_frames_ctx_);
+  codec_context_->gop_size = config.gop_length.value_or(kDefaultGopLength);
+  codec_context_->max_b_frames = 0;
+
+  int profile = AVProfileForVideoCodecProfile(config.output_profile);
+  if (profile != AV_PROFILE_UNKNOWN) {
+    codec_context_->profile = profile;
+  }
+
+  int64_t target_bps = config.bitrate.target_bps();
+  if (target_bps <= 0) {
+    target_bps = 2000000;
+  }
+  codec_context_->bit_rate = target_bps;
+  if (config.bitrate.mode() == Bitrate::Mode::kConstant) {
+    codec_context_->rc_min_rate = target_bps;
+    codec_context_->rc_max_rate = target_bps;
+    codec_context_->rc_buffer_size = static_cast<int>(target_bps);
+    SetOptionalAVOpt(codec_context_.get(), "rc_mode", "cbr");
+  } else {
+    codec_context_->rc_min_rate = 0;
+    codec_context_->rc_max_rate = config.bitrate.peak_bps() > 0
+                                      ? config.bitrate.peak_bps()
+                                      : target_bps;
+    codec_context_->rc_buffer_size =
+        static_cast<int>(codec_context_->rc_max_rate);
+    SetOptionalAVOpt(codec_context_.get(), "rc_mode", "vbr");
+  }
+
+  if (config.require_low_delay) {
+    SetOptionalAVOpt(codec_context_.get(), "tune", "ll");
+    SetOptionalAVOpt(codec_context_.get(), "usage", "stream");
+    SetOptionalAVOptInt(codec_context_.get(), "async_depth", 1);
+  } else {
+    SetOptionalAVOptInt(codec_context_.get(), "async_depth", 2);
+  }
+  SetOptionalAVOpt(
+      codec_context_.get(), "content",
+      config.content_type == Config::ContentType::kDisplay ? "desktop"
+                                                           : "camera");
+
+  err = avcodec_open2(codec_context_.get(), codec, nullptr);
+  if (err < 0) {
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: avcodec_open2 failed for "
+               << encoder_name << ": " << AVErrorToString(err);
+    return false;
+  }
+
+  VLOG(1) << "VulkanVideoEncodeAccelerator: initialized " << encoder_name
+          << " (" << codec_context_->width << "x"
+          << codec_context_->height << ", low_delay=" << config.require_low_delay
+          << ")";
+  return true;
+}
+
+bool VulkanVideoEncodeAccelerator::TryEncodeZeroCopyDmabuf(
+    scoped_refptr<VideoFrame> frame,
+    AVFrame* hw_frame) {
+  if (!frame || frame->format() != PIXEL_FORMAT_NV12 || !hw_device_ctx_ ||
+      !hw_frame) {
+    return false;
+  }
+
+  const auto* copy_info = VulkanVideoDevice::GetInstance()->GetCopyInfo();
+  if (!copy_info || !copy_info->procs_ready ||
+      !copy_info->procs.vkGetMemoryFdPropertiesKHR) {
+    return false;
+  }
+
+  auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(hw_device_ctx_->data);
+  auto* vk_dev =
+      dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+  if (!vk_dev || !vk_dev->act_dev) {
+    return false;
+  }
+
+  gfx::NativePixmapHandle pixmap_handle;
+  bool have_handle = false;
+
+  if (frame->HasMappableSharedImage()) {
+    gfx::GpuMemoryBufferHandle gmb_handle = frame->GetGpuMemoryBufferHandle();
+    if (gmb_handle.type == gfx::GpuMemoryBufferType::NATIVE_PIXMAP) {
+      pixmap_handle = std::move(gmb_handle).native_pixmap_handle();
+      have_handle = pixmap_handle.planes.size() >= 2;
+    }
+  } else if (frame->storage_type() == VideoFrame::STORAGE_DMABUFS &&
+             frame->layout().num_planes() >= 2 && frame->NumDmabufFds() >= 1) {
+    const size_t num_fds = frame->NumDmabufFds();
+    const auto& layout_planes = frame->layout().planes();
+    for (size_t i = 0; i < 2; ++i) {
+      const size_t fd_idx = (i < num_fds) ? i : 0;
+      base::ScopedFD dup_fd(HANDLE_EINTR(dup(frame->GetDmabufFd(fd_idx))));
+      if (!dup_fd.is_valid()) {
+        return false;
+      }
+      pixmap_handle.planes.emplace_back(layout_planes[i].stride,
+                                        layout_planes[i].offset,
+                                        layout_planes[i].size,
+                                        std::move(dup_fd));
+    }
+    pixmap_handle.modifier = frame->layout().modifier();
+    have_handle = true;
+  }
+
+  if (!have_handle) {
+    return false;
+  }
+
+  if (!copy_state_) {
+    copy_state_ = std::make_unique<VulkanEncodeCopyState>();
+  }
+  for (auto& s : copy_state_->slots) {
+    ReapEncodeCopySlot(vk_dev, copy_info->procs, s, /*wait=*/false);
+  }
+
+  EncodeCopySlot& slot = copy_state_->slots[copy_state_->next_slot];
+  copy_state_->next_slot = (copy_state_->next_slot + 1) % kEncodeCopyRingSize;
+  if (slot.cmd_pool == VK_NULL_HANDLE) {
+    if (!CreateCopyCmdResources(vk_dev, *copy_info, &slot.cmd_pool,
+                                &slot.cmd_buf, &slot.fence)) {
+      return false;
+    }
+  }
+  if (slot.in_flight) {
+    ReapEncodeCopySlot(vk_dev, copy_info->procs, slot, /*wait=*/true);
+  }
+
+  VkImage out_img = VK_NULL_HANDLE;
+  VkDeviceMemory out_mem[2] = {VK_NULL_HANDLE, VK_NULL_HANDLE};
+  if (!CopyDmabufToVkFrame(vk_dev, *copy_info, slot.cmd_pool, slot.cmd_buf,
+                           slot.fence, pixmap_handle, frame->coded_size(),
+                           frame->visible_rect(), codec_context_->width,
+                           codec_context_->height, hw_frame, &out_img,
+                           out_mem)) {
+    return false;
+  }
+
+  slot.src_img = out_img;
+  slot.src_mem[0] = out_mem[0];
+  slot.src_mem[1] = out_mem[1];
+  slot.input_frame = std::move(frame);
+  slot.in_flight = true;
+  return true;
+}
+
+void VulkanVideoEncodeAccelerator::Encode(scoped_refptr<VideoFrame> frame,
+                                          bool force_keyframe) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!initialized_ || has_error_ || !codec_context_ || !hw_frames_ctx_) {
+    return;
+  }
+
+  if (!frame) {
+    has_error_ = true;
+    client_->NotifyErrorStatus(
+        {EncoderStatus::Codes::kUnsupportedFrameFormat,
+         "VulkanVideoEncodeAccelerator received null frame"});
+    return;
+  }
+
+  if (!reusable_hw_frame_) {
+    reusable_hw_frame_ = av_frame_alloc();
+    if (!reusable_hw_frame_) {
+      has_error_ = true;
+      client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+      return;
+    }
+  } else {
+    av_frame_unref(reusable_hw_frame_);
+  }
+
+  int err = av_hwframe_get_buffer(hw_frames_ctx_, reusable_hw_frame_, 0);
+  if (err < 0) {
+    av_frame_unref(reusable_hw_frame_);
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: av_hwframe_get_buffer failed: "
+               << AVErrorToString(err);
+    has_error_ = true;
+    client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+    return;
+  }
+
+  bool uploaded = TryEncodeZeroCopyDmabuf(frame, reusable_hw_frame_);
+  if (uploaded) {
+    if (!logged_zero_copy_) {
+      logged_zero_copy_ = true;
+      VLOG(1) << "VulkanVideoEncodeAccelerator: async zero-copy DMA-BUF GPU "
+                 "copy active (ring=4)";
+    }
+  } else {
+    scoped_refptr<VideoFrame> cpu_frame = frame;
+    if (!cpu_frame->HasDirectCpuAccess() && cpu_frame->HasMappableSharedImage()) {
+      cpu_frame = ConvertToMemoryMappedFrame(std::move(cpu_frame));
+    }
+    if (!cpu_frame || !cpu_frame->HasDirectCpuAccess() ||
+        !cpu_frame->visible_data(VideoFrame::Plane::kY)) {
+      av_frame_unref(reusable_hw_frame_);
+      has_error_ = true;
+      client_->NotifyErrorStatus(
+          {EncoderStatus::Codes::kUnsupportedFrameFormat,
+           "VulkanVideoEncodeAccelerator requires mappable or CPU VideoFrame"});
+      return;
+    }
+
+    if (!reusable_sw_frame_) {
+      reusable_sw_frame_ = av_frame_alloc();
+      if (!reusable_sw_frame_) {
+        av_frame_unref(reusable_hw_frame_);
+        has_error_ = true;
+        client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+        return;
+      }
+    }
+
+    if (!reusable_sw_frame_->buf[0] ||
+        reusable_sw_frame_->format != AV_PIX_FMT_NV12 ||
+        reusable_sw_frame_->width != codec_context_->width ||
+        reusable_sw_frame_->height != codec_context_->height) {
+      av_frame_unref(reusable_sw_frame_);
+      reusable_sw_frame_->format = AV_PIX_FMT_NV12;
+      reusable_sw_frame_->width = codec_context_->width;
+      reusable_sw_frame_->height = codec_context_->height;
+      err = av_frame_get_buffer(reusable_sw_frame_, 32);
+    } else {
+      err = av_frame_make_writable(reusable_sw_frame_);
+    }
+    if (err < 0) {
+      av_frame_unref(reusable_sw_frame_);
+      av_frame_unref(reusable_hw_frame_);
+      has_error_ = true;
+      client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+      return;
+    }
+
+    const int copy_w =
+        std::min(codec_context_->width, cpu_frame->visible_rect().width());
+    const int copy_h =
+        std::min(codec_context_->height, cpu_frame->visible_rect().height());
+
+    if (cpu_frame->format() == PIXEL_FORMAT_NV12) {
+      libyuv::NV12Copy(
+          cpu_frame->visible_data(VideoFrame::Plane::kY),
+          cpu_frame->stride(VideoFrame::Plane::kY),
+          cpu_frame->visible_data(VideoFrame::Plane::kUV),
+          cpu_frame->stride(VideoFrame::Plane::kUV),
+          reusable_sw_frame_->data[0], reusable_sw_frame_->linesize[0],
+          reusable_sw_frame_->data[1], reusable_sw_frame_->linesize[1],
+          copy_w, copy_h);
+    } else if (cpu_frame->format() == PIXEL_FORMAT_I420) {
+      libyuv::I420ToNV12(
+          cpu_frame->visible_data(VideoFrame::Plane::kY),
+          cpu_frame->stride(VideoFrame::Plane::kY),
+          cpu_frame->visible_data(VideoFrame::Plane::kU),
+          cpu_frame->stride(VideoFrame::Plane::kU),
+          cpu_frame->visible_data(VideoFrame::Plane::kV),
+          cpu_frame->stride(VideoFrame::Plane::kV),
+          reusable_sw_frame_->data[0], reusable_sw_frame_->linesize[0],
+          reusable_sw_frame_->data[1], reusable_sw_frame_->linesize[1],
+          copy_w, copy_h);
+    } else {
+      av_frame_unref(reusable_hw_frame_);
+      has_error_ = true;
+      client_->NotifyErrorStatus(EncoderStatus::Codes::kUnsupportedFrameFormat);
+      return;
+    }
+
+    err = av_hwframe_transfer_data(reusable_hw_frame_, reusable_sw_frame_, 0);
+    if (err < 0) {
+      av_frame_unref(reusable_hw_frame_);
+      LOG(ERROR) << "VulkanVideoEncodeAccelerator: hwframe upload failed: "
+                 << AVErrorToString(err);
+      has_error_ = true;
+      client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+      return;
+    }
+  }
+
+  reusable_hw_frame_->pts = frame->timestamp().InMicroseconds();
+  reusable_hw_frame_->pict_type =
+      force_keyframe ? AV_PICTURE_TYPE_I : AV_PICTURE_TYPE_NONE;
+  pending_timestamps_.push_back(frame->timestamp());
+
+  err = avcodec_send_frame(codec_context_.get(), reusable_hw_frame_);
+  av_frame_unref(reusable_hw_frame_);
+
+  if (err < 0) {
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: avcodec_send_frame failed: "
+               << AVErrorToString(err);
+    has_error_ = true;
+    client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+    return;
+  }
+
+  DrainPackets();
+  DrainOutputs();
+}
+
+void VulkanVideoEncodeAccelerator::DrainPackets() {
+  if (!reusable_packet_) {
+    reusable_packet_ = av_packet_alloc();
+    if (!reusable_packet_) {
+      return;
+    }
+  } else {
+    av_packet_unref(reusable_packet_);
+  }
+
+  while (true) {
+    int err = avcodec_receive_packet(codec_context_.get(), reusable_packet_);
+    if (err == AVERROR(EAGAIN) || err == AVERROR_EOF) {
+      break;
+    }
+    if (err < 0) {
+      LOG(ERROR)
+          << "VulkanVideoEncodeAccelerator: avcodec_receive_packet failed: "
+          << AVErrorToString(err);
+      has_error_ = true;
+      client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+      break;
+    }
+
+    PendingOutput out;
+    out.data.assign(reusable_packet_->data,
+                    reusable_packet_->data + reusable_packet_->size);
+    out.key_frame = (reusable_packet_->flags & AV_PKT_FLAG_KEY) != 0;
+    if (!pending_timestamps_.empty()) {
+      out.timestamp = pending_timestamps_.front();
+      pending_timestamps_.pop_front();
+    } else {
+      out.timestamp = base::Microseconds(reusable_packet_->pts);
+    }
+    pending_outputs_.push_back(std::move(out));
+    av_packet_unref(reusable_packet_);
+  }
+}
+
+void VulkanVideoEncodeAccelerator::UseOutputBitstreamBuffer(
+    BitstreamBuffer buffer) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (has_error_) {
+    return;
+  }
+
+  base::UnsafeSharedMemoryRegion region = buffer.TakeRegion();
+  base::WritableSharedMemoryMapping mapping =
+      region.MapAt(buffer.offset(), buffer.size());
+  if (!mapping.IsValid()) {
+    has_error_ = true;
+    client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+    return;
+  }
+
+  available_bitstream_buffers_.emplace_back(buffer.id(), std::move(mapping),
+                                            buffer.size());
+  DrainOutputs();
+}
+
+void VulkanVideoEncodeAccelerator::DrainOutputs() {
+  while (!pending_outputs_.empty() && !available_bitstream_buffers_.empty()) {
+    PendingOutput out = std::move(pending_outputs_.front());
+    pending_outputs_.pop_front();
+
+    OutputBuffer dst = std::move(available_bitstream_buffers_.front());
+    available_bitstream_buffers_.pop_front();
+
+    if (out.data.size() > dst.size) {
+      LOG(ERROR) << "VulkanVideoEncodeAccelerator: encoded packet ("
+                 << out.data.size() << ") exceeds bitstream buffer ("
+                 << dst.size << ")";
+      has_error_ = true;
+      client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+      return;
+    }
+
+    std::memcpy(dst.mapping.memory(), out.data.data(), out.data.size());
+    BitstreamBufferMetadata metadata(out.data.size(), out.key_frame,
+                                     out.timestamp);
+    client_->BitstreamBufferReady(dst.id, metadata);
+  }
+}
+
+void VulkanVideoEncodeAccelerator::RequestEncodingParametersChange(
+    const Bitrate& bitrate,
+    uint32_t framerate,
+    const std::optional<gfx::Size>& size) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!initialized_ || has_error_ || !codec_context_) {
+    return;
+  }
+  if (bitrate.target_bps() > 0) {
+    active_config_.bitrate = bitrate;
+  }
+  if (framerate > 0) {
+    active_config_.framerate = framerate;
+  }
+  if (size.has_value()) {
+    if (size->IsEmpty() ||
+        !ValidateEncodeSize(active_config_.output_profile, *size)) {
+      has_error_ = true;
+      client_->NotifyErrorStatus({EncoderStatus::Codes::kEncoderUnsupportedConfig,
+                                  "Unsupported Vulkan encode frame size"});
+      return;
+    }
+    if (*size != input_visible_size_) {
+      int err = avcodec_send_frame(codec_context_.get(), nullptr);
+      if (err >= 0 || err == AVERROR_EOF) {
+        DrainPackets();
+        DrainOutputs();
+      }
+      if (has_error_) {
+        return;
+      }
+      active_config_.input_visible_size = *size;
+      if (!ConfigureEncoder(active_config_)) {
+        ReleaseResources();
+        has_error_ = true;
+        client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderInitializationError);
+        return;
+      }
+      input_visible_size_ = *size;
+      output_buffer_size_ = std::max<size_t>(
+          kMinOutputBufferSize, input_visible_size_.GetArea() * 2);
+      initialized_ = true;
+      has_error_ = false;
+      logged_zero_copy_ = false;
+      VLOG(1) << "VulkanVideoEncodeAccelerator: reconfigured frame size to "
+              << input_visible_size_.ToString();
+    } else {
+      ApplyDynamicRateAndFramerate(codec_context_.get(), bitrate, framerate);
+      available_bitstream_buffers_.clear();
+    }
+    client_->RequireBitstreamBuffers(/*input_count=*/2, input_visible_size_,
+                                     output_buffer_size_);
+    return;
+  }
+  ApplyDynamicRateAndFramerate(codec_context_.get(), bitrate, framerate);
+}
+
+void VulkanVideoEncodeAccelerator::Flush(FlushCallback flush_callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!initialized_ || has_error_ || !codec_context_) {
+    std::move(flush_callback).Run(false);
+    return;
+  }
+
+  int err = avcodec_send_frame(codec_context_.get(), nullptr);
+  if (err < 0 && err != AVERROR_EOF) {
+    std::move(flush_callback).Run(false);
+    return;
+  }
+  DrainPackets();
+  DrainOutputs();
+  if (copy_state_ && hw_device_ctx_) {
+    auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(hw_device_ctx_->data);
+    auto* vk_dev =
+        dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx) : nullptr;
+    const auto* copy_info = VulkanVideoDevice::GetInstance()->GetCopyInfo();
+    if (vk_dev && vk_dev->act_dev && copy_info && copy_info->procs_ready) {
+      for (auto& slot : copy_state_->slots) {
+        ReapEncodeCopySlot(vk_dev, copy_info->procs, slot, /*wait=*/true);
+      }
+    }
+  }
+  std::move(flush_callback).Run(!has_error_);
+}
+
+bool VulkanVideoEncodeAccelerator::IsFlushSupported() {
+  return true;
+}
+
+void VulkanVideoEncodeAccelerator::Destroy() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ReleaseResources();
+  delete this;
+}
+
+void VulkanVideoEncodeAccelerator::ReleaseResources() {
+  if (copy_state_) {
+    AVVulkanDeviceContext* vk_dev = nullptr;
+    if (hw_device_ctx_) {
+      auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(hw_device_ctx_->data);
+      vk_dev = dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx)
+                       : nullptr;
+    }
+    const auto* copy_info = VulkanVideoDevice::GetInstance()->GetCopyInfo();
+    const bool can_vk =
+        vk_dev && vk_dev->act_dev && copy_info && copy_info->procs_ready;
+    for (auto& slot : copy_state_->slots) {
+      if (can_vk) {
+        ReapEncodeCopySlot(vk_dev, copy_info->procs, slot, /*wait=*/true);
+      } else {
+        slot.input_frame.reset();
+        slot.in_flight = false;
+      }
+    }
+  }
+  codec_context_.reset();
+  av_packet_free(&reusable_packet_);
+  av_frame_free(&reusable_sw_frame_);
+  av_frame_free(&reusable_hw_frame_);
+  if (copy_state_) {
+    if (hw_device_ctx_) {
+      auto* dev_ctx = reinterpret_cast<AVHWDeviceContext*>(hw_device_ctx_->data);
+      auto* vk_dev =
+          dev_ctx ? static_cast<AVVulkanDeviceContext*>(dev_ctx->hwctx)
+                  : nullptr;
+      const auto* copy_info = VulkanVideoDevice::GetInstance()->GetCopyInfo();
+      if (vk_dev && copy_info && copy_info->procs_ready) {
+        for (auto& slot : copy_state_->slots) {
+          DestroyCopyCmdResources(vk_dev, copy_info->procs, slot.cmd_pool,
+                                  slot.fence);
+          slot.cmd_pool = VK_NULL_HANDLE;
+          slot.cmd_buf = VK_NULL_HANDLE;
+          slot.fence = VK_NULL_HANDLE;
+        }
+      }
+    }
+    copy_state_.reset();
+  }
+  if (hw_frames_ctx_) {
+    AVBufferRef* ref = hw_frames_ctx_.get();
+    hw_frames_ctx_ = nullptr;
+    av_buffer_unref(&ref);
+  }
+  if (hw_device_ctx_) {
+    AVBufferRef* ref = hw_device_ctx_.get();
+    hw_device_ctx_ = nullptr;
+    av_buffer_unref(&ref);
+  }
+  available_bitstream_buffers_.clear();
+  pending_outputs_.clear();
+  pending_timestamps_.clear();
+  initialized_ = false;
+  logged_zero_copy_ = false;
+}
