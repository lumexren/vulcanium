+class MEDIA_GPU_EXPORT VulkanVideoEncodeAccelerator
+    : public VideoEncodeAccelerator {
+ public:
+  VulkanVideoEncodeAccelerator();
+
+  VulkanVideoEncodeAccelerator(const VulkanVideoEncodeAccelerator&) = delete;
+  VulkanVideoEncodeAccelerator& operator=(const VulkanVideoEncodeAccelerator&) =
+      delete;
+
+  ~VulkanVideoEncodeAccelerator() override;
+
+  // VideoEncodeAccelerator implementation:
+  SupportedProfiles GetSupportedProfiles() override;
+  EncoderStatus Initialize(const Config& config,
+                           Client* client,
+                           std::unique_ptr<MediaLog> media_log) override;
+  void Encode(scoped_refptr<VideoFrame> frame, bool force_keyframe) override;
+  void UseOutputBitstreamBuffer(BitstreamBuffer buffer) override;
+  void RequestEncodingParametersChange(
+      const Bitrate& bitrate,
+      uint32_t framerate,
+      const std::optional<gfx::Size>& size) override;
+  void Destroy() override;
+  void Flush(FlushCallback flush_callback) override;
+  bool IsFlushSupported() override;
+
+ private:
+  struct OutputBuffer {
+    OutputBuffer(int32_t id,
+                 base::WritableSharedMemoryMapping mapping,
+                 size_t size);
+    OutputBuffer(OutputBuffer&&);
+    OutputBuffer& operator=(OutputBuffer&&);
+    ~OutputBuffer();
+
+    int32_t id;
+    base::WritableSharedMemoryMapping mapping;
+    size_t size;
+  };
+
+  struct PendingOutput {
+    PendingOutput();
+    PendingOutput(PendingOutput&&);
+    PendingOutput& operator=(PendingOutput&&);
+    ~PendingOutput();
+
+    std::vector<uint8_t> data;
+    bool key_frame = false;
+    base::TimeDelta timestamp;
+  };
+
+  bool ConfigureEncoder(const Config& config);
+  void DrainPackets();
+  void DrainOutputs();
+  void ReleaseResources();
+
+  std::unique_ptr<MediaLog> media_log_;
+  raw_ptr<Client> client_ = nullptr;
+
+  raw_ptr<AVBufferRef> hw_device_ctx_ = nullptr;
+  raw_ptr<AVBufferRef> hw_frames_ctx_ = nullptr;
+  std::unique_ptr<AVCodecContext, ScopedPtrAVFreeContext> codec_context_;
+
+  gfx::Size input_visible_size_;
+  size_t output_buffer_size_ = 0;
+  bool initialized_ = false;
+  bool has_error_ = false;
+
+  base::circular_deque<OutputBuffer> available_bitstream_buffers_;
+  base::circular_deque<PendingOutput> pending_outputs_;
+  base::circular_deque<base::TimeDelta> pending_timestamps_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
