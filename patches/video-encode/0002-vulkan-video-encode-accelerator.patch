+constexpr uint32_t kDefaultGopLength = 60;
+constexpr size_t kMinOutputBufferSize = 1024 * 1024;
+
+const char* EncoderNameForProfile(VideoCodecProfile profile) {
+  if (profile >= H264PROFILE_MIN && profile <= H264PROFILE_MAX) {
+    return "h264_vulkan";
+  }
+  if (profile >= HEVCPROFILE_MIN && profile <= HEVCPROFILE_MAX) {
+    return "hevc_vulkan";
+  }
+  if (profile >= AV1PROFILE_MIN && profile <= AV1PROFILE_MAX) {
+    return "av1_vulkan";
+  }
+  return nullptr;
+}
+
+int AVProfileForVideoCodecProfile(VideoCodecProfile profile) {
+  switch (profile) {
+    case H264PROFILE_BASELINE:
+      return AV_PROFILE_H264_BASELINE;
+    case H264PROFILE_MAIN:
+      return AV_PROFILE_H264_MAIN;
+    case H264PROFILE_HIGH:
+      return AV_PROFILE_H264_HIGH;
+    case HEVCPROFILE_MAIN:
+      return AV_PROFILE_HEVC_MAIN;
+    case AV1PROFILE_PROFILE_MAIN:
+      return AV_PROFILE_AV1_MAIN;
+    default:
+      return AV_PROFILE_UNKNOWN;
+  }
+}
+
+void SetOptionalAVOpt(AVCodecContext* ctx, const char* name, const char* val) {
+  int err = av_opt_set(ctx, name, val, AV_OPT_SEARCH_CHILDREN);
+  if (err < 0 && err != AVERROR_OPTION_NOT_FOUND) {
+    VLOG(1) << "VulkanVideoEncodeAccelerator: av_opt_set(" << name << "="
+            << val << ") failed: " << AVErrorToString(err);
+  }
+}
+
+void SetOptionalAVOptInt(AVCodecContext* ctx, const char* name, int64_t val) {
+  int err = av_opt_set_int(ctx, name, val, AV_OPT_SEARCH_CHILDREN);
+  if (err < 0 && err != AVERROR_OPTION_NOT_FOUND) {
+    VLOG(1) << "VulkanVideoEncodeAccelerator: av_opt_set_int(" << name << "="
+            << val << ") failed: " << AVErrorToString(err);
+  }
+}
+
+bool ValidateEncodeSize(VideoCodecProfile profile, const gfx::Size& size) {
+  if (size.IsEmpty()) {
+    return false;
+  }
+  const auto& caps = VulkanVideoDevice::GetInstance()->GetCapabilities();
+  const CodecCapability* cap = nullptr;
+  if (profile >= H264PROFILE_MIN && profile <= H264PROFILE_MAX) {
+    cap = &caps.encode_h264;
+  } else if (profile >= HEVCPROFILE_MIN && profile <= HEVCPROFILE_MAX) {
+    cap = &caps.encode_hevc;
+  } else if (profile >= AV1PROFILE_MIN && profile <= AV1PROFILE_MAX) {
+    cap = &caps.encode_av1;
+  }
+  if (!cap || !cap->supported) {
+    return false;
+  }
+  return size.width() >= cap->min_size.width() &&
+         size.height() >= cap->min_size.height() &&
+         size.width() <= cap->max_size.width() &&
+         size.height() <= cap->max_size.height();
+}
+
+void ApplyDynamicRateAndFramerate(AVCodecContext* ctx,
+                                  const Bitrate& bitrate,
+                                  uint32_t framerate) {
+  if (!ctx) {
+    return;
+  }
+  if (bitrate.target_bps() > 0) {
+    const int64_t target_bps = bitrate.target_bps();
+    ctx->bit_rate = target_bps;
+    if (bitrate.mode() == Bitrate::Mode::kConstant) {
+      ctx->rc_min_rate = target_bps;
+      ctx->rc_max_rate = target_bps;
+      ctx->rc_buffer_size = static_cast<int>(target_bps);
+    } else {
+      ctx->rc_min_rate = 0;
+      ctx->rc_max_rate =
+          bitrate.peak_bps() > 0 ? bitrate.peak_bps() : target_bps;
+      ctx->rc_buffer_size = static_cast<int>(ctx->rc_max_rate);
+    }
+  }
+  if (framerate > 0) {
+    ctx->framerate = AVRational{static_cast<int>(framerate), 1};
+  }
+}
+
+bool SameInodeFd(int fd0, int fd1) {
+  if (fd0 < 0 || fd1 < 0) {
+    return true;
+  }
+  if (fd0 == fd1) {
+    return true;
+  }
+  struct stat st0 {};
+  struct stat st1 {};
+  if (fstat(fd0, &st0) != 0 || fstat(fd1, &st1) != 0) {
+    return false;
+  }
+  return st0.st_dev == st1.st_dev && st0.st_ino == st1.st_ino;
+}
+
+uint32_t FindMemoryType(const VkPhysicalDeviceMemoryProperties& mem_props,
+                        uint32_t type_bits) {
+  for (uint32_t i = 0; i < mem_props.memoryTypeCount; ++i) {
+    if ((type_bits & (1u << i)) &&
+        (mem_props.memoryTypes[i].propertyFlags &
+         VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+      return i;
+    }
+  }
+  for (uint32_t i = 0; i < mem_props.memoryTypeCount; ++i) {
+    if (type_bits & (1u << i)) {
+      return i;
+    }
+  }
+  return UINT32_MAX;
+}
+
+int64_t GetDmabufSize(int fd) {
+  if (fd < 0) {
+    return -1;
+  }
+  struct stat st {};
+  if (fstat(fd, &st) == 0 && st.st_size > 0) {
+    return static_cast<int64_t>(st.st_size);
+  }
+  const off_t cur = lseek(fd, 0, SEEK_CUR);
+  const off_t end = lseek(fd, 0, SEEK_END);
+  if (cur >= 0) {
+    lseek(fd, cur, SEEK_SET);
+  }
+  return end > 0 ? static_cast<int64_t>(end) : -1;
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+void CleanupDmabufImport(VkDevice dev,
+                         const VkCopyProcs& p,
+                         VkImage* src_img,
+                         VkDeviceMemory src_mem[2]) {
+  if (*src_img != VK_NULL_HANDLE) {
+    p.vkDestroyImage(dev, *src_img, nullptr);
+    *src_img = VK_NULL_HANDLE;
+  }
+  for (int i = 0; i < 2; ++i) {
+    if (src_mem[i] != VK_NULL_HANDLE) {
+      p.vkFreeMemory(dev, src_mem[i], nullptr);
+      src_mem[i] = VK_NULL_HANDLE;
+    }
+  }
+}
+
+NO_SANITIZE("cfi") __attribute__((noinline))
+bool CopyDmabufToVkFrame(AVVulkanDeviceContext* vk_dev,
+                         const VkCopyInfo& info,
+                         VkCommandPool cmd_pool,
+                         VkCommandBuffer cb,
+                         VkFence fence,
+                         const gfx::NativePixmapHandle& handle,
+                         const gfx::Size& coded_size,
+                         const gfx::Rect& visible_rect,
+                         int enc_w,
+                         int enc_h,
+                         AVFrame* dst_hw_frame,
+                         VkImage* out_src_img,
+                         VkDeviceMemory out_src_mem[2]) {
+  *out_src_img = VK_NULL_HANDLE;
+  out_src_mem[0] = VK_NULL_HANDLE;
+  out_src_mem[1] = VK_NULL_HANDLE;
+  if (!vk_dev || !vk_dev->act_dev || !info.procs_ready ||
+      !info.procs.vkGetMemoryFdPropertiesKHR || cmd_pool == VK_NULL_HANDLE ||
+      cb == VK_NULL_HANDLE || fence == VK_NULL_HANDLE ||
+      handle.planes.size() != 2 || !handle.planes[0].fd.is_valid() ||
+      coded_size.IsEmpty() || enc_w <= 0 || enc_h <= 0 || !dst_hw_frame ||
+      !dst_hw_frame->hw_frames_ctx) {
+    return false;
+  }
+
+  auto* frames_ctx =
+      reinterpret_cast<AVHWFramesContext*>(dst_hw_frame->hw_frames_ctx->data);
+  if (!frames_ctx || !frames_ctx->device_ctx) {
+    return false;
+  }
+  auto* dst_vk = reinterpret_cast<AVVkFrame*>(dst_hw_frame->data[0]);
+  if (!dst_vk || dst_vk->img[0] == VK_NULL_HANDLE) {
+    return false;
+  }
+
+  if (handle.modifier == gfx::NativePixmapHandle::kNoModifier) {
+    static bool logged_no_mod = false;
+    if (!logged_no_mod) {
+      logged_no_mod = true;
+      VLOG(1) << "CopyDmabufToVkFrame: rejecting kNoModifier";
+    }
+    return false;
+  }
+
+  const auto& p = info.procs;
+  const bool has_plane1_fd = handle.planes[1].fd.is_valid();
+  const bool same_dmabuf =
+      !has_plane1_fd ||
+      SameInodeFd(handle.planes[0].fd.get(), handle.planes[1].fd.get());
+  const bool disjoint = !same_dmabuf;
+  if (disjoint &&
+      (!p.vkGetImageMemoryRequirements2 || !p.vkBindImageMemory2)) {
+    return false;
+  }
+
+  const VkImageCreateFlags img_flags =
+      disjoint ? VK_IMAGE_CREATE_DISJOINT_BIT : 0u;
+  if (p.vkGetPhysicalDeviceImageFormatProperties2 && vk_dev->phys_dev) {
+    VkPhysicalDeviceImageDrmFormatModifierInfoEXT mod_info{
+        .sType =
+            VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_DRM_FORMAT_MODIFIER_INFO_EXT,
+        .drmFormatModifier = handle.modifier,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+    };
+    VkPhysicalDeviceExternalImageFormatInfo ext_fmt_info{
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO,
+        .pNext = &mod_info,
+        .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+    };
+    VkPhysicalDeviceImageFormatInfo2 fmt_info{
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+        .pNext = &ext_fmt_info,
+        .format = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM,
+        .type = VK_IMAGE_TYPE_2D,
+        .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+        .usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+        .flags = img_flags,
+    };
+    VkExternalImageFormatProperties ext_props{
+        .sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
+    };
+    VkImageFormatProperties2 fmt_props{
+        .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2,
+        .pNext = &ext_props,
+    };
+    VkResult fmt_res = p.vkGetPhysicalDeviceImageFormatProperties2(
+        vk_dev->phys_dev, &fmt_info, &fmt_props);
+    if (fmt_res != VK_SUCCESS ||
+        (ext_props.externalMemoryProperties.externalMemoryFeatures &
+         VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT) == 0) {
+      static bool logged_fmt_reject = false;
+      if (!logged_fmt_reject) {
+        logged_fmt_reject = true;
+        VLOG(1) << "CopyDmabufToVkFrame: format/modifier rejected mod=0x"
+                << std::hex << handle.modifier << std::dec
+                << " res=" << fmt_res << " features=0x" << std::hex
+                << ext_props.externalMemoryProperties.externalMemoryFeatures
+                << std::dec << " disjoint=" << disjoint;
+      }
+      return false;
+    }
+  }
+
+  VkSubresourceLayout plane_layouts[2] = {
+      {.offset = handle.planes[0].offset,
+       .size = 0,
+       .rowPitch = handle.planes[0].stride,
+       .arrayPitch = 0,
+       .depthPitch = 0},
+      {.offset = handle.planes[1].offset,
+       .size = 0,
+       .rowPitch = handle.planes[1].stride,
+       .arrayPitch = 0,
+       .depthPitch = 0},
+  };
+  VkImageDrmFormatModifierExplicitCreateInfoEXT mod_ci{
+      .sType =
+          VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT,
+      .drmFormatModifier = handle.modifier,
+      .drmFormatModifierPlaneCount = 2,
+      .pPlaneLayouts = plane_layouts,
+  };
+  VkExternalMemoryImageCreateInfo ext_ci{
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+      .pNext = &mod_ci,
+      .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+  };
+  VkImageCreateInfo ici{
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .pNext = &ext_ci,
+      .flags = img_flags,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM,
+      .extent = {static_cast<uint32_t>(coded_size.width()),
+                 static_cast<uint32_t>(coded_size.height()), 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+      .usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+  };
+
+  VkImage src_img = VK_NULL_HANDLE;
+  VkDeviceMemory src_mem[2] = {VK_NULL_HANDLE, VK_NULL_HANDLE};
+
+  if (p.vkCreateImage(vk_dev->act_dev, &ici, nullptr, &src_img) != VK_SUCCESS) {
+    CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+    return false;
+  }
+
+  int64_t logged_dmabuf_size = -1;
+  uint64_t logged_req_size = 0;
+
+  if (same_dmabuf) {
+    VkMemoryRequirements req{};
+    bool use_dedicated = true;
+    if (p.vkGetImageMemoryRequirements2) {
+      VkImageMemoryRequirementsInfo2 req_info{
+          .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+          .image = src_img,
+      };
+      VkMemoryDedicatedRequirements ded_req{
+          .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_REQUIREMENTS,
+      };
+      VkMemoryRequirements2 req2{
+          .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+          .pNext = &ded_req,
+      };
+      p.vkGetImageMemoryRequirements2(vk_dev->act_dev, &req_info, &req2);
+      req = req2.memoryRequirements;
+      use_dedicated =
+          (ded_req.prefersDedicatedAllocation ||
+           ded_req.requiresDedicatedAllocation);
+    } else {
+      p.vkGetImageMemoryRequirements(vk_dev->act_dev, src_img, &req);
+    }
+
+    const int64_t dmabuf_size = GetDmabufSize(handle.planes[0].fd.get());
+    logged_dmabuf_size = dmabuf_size;
+    logged_req_size = req.size;
+    if (dmabuf_size <= 0 || static_cast<uint64_t>(dmabuf_size) < req.size ||
+        plane_layouts[1].offset >= static_cast<uint64_t>(dmabuf_size)) {
+      static bool logged_size_reject = false;
+      if (!logged_size_reject) {
+        logged_size_reject = true;
+        VLOG(1) << "CopyDmabufToVkFrame: dmabuf size mismatch dmabuf_size="
+                << dmabuf_size << " req.size=" << req.size
+                << " p0_off=" << plane_layouts[0].offset
+                << " p1_off=" << plane_layouts[1].offset
+                << " mod=0x" << std::hex << handle.modifier << std::dec;
+      }
+      CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+      return false;
+    }
+
+    VkMemoryFdPropertiesKHR fd_props{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+    };
+    if (p.vkGetMemoryFdPropertiesKHR(
+            vk_dev->act_dev, VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+            handle.planes[0].fd.get(), &fd_props) != VK_SUCCESS) {
+      CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+      return false;
+    }
+
+    uint32_t mem_idx =
+        FindMemoryType(info.mem_props, req.memoryTypeBits & fd_props.memoryTypeBits);
+    if (mem_idx == UINT32_MAX) {
+      CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+      return false;
+    }
+
+    int import_fd = HANDLE_EINTR(dup(handle.planes[0].fd.get()));
+    if (import_fd < 0) {
+      CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+      return false;
+    }
+
+    VkImportMemoryFdInfoKHR imp{
+        .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+        .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+        .fd = import_fd,
+    };
+    VkMemoryDedicatedAllocateInfo ded{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+        .pNext = &imp,
+        .image = src_img,
+    };
+    VkMemoryAllocateInfo mai{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .pNext = use_dedicated ? static_cast<const void*>(&ded)
+                               : static_cast<const void*>(&imp),
+        .allocationSize = req.size,
+        .memoryTypeIndex = mem_idx,
+    };
+    if (p.vkAllocateMemory(vk_dev->act_dev, &mai, nullptr, &src_mem[0]) !=
+        VK_SUCCESS) {
+      IGNORE_EINTR(close(import_fd));
+      CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+      return false;
+    }
+
+    if (p.vkBindImageMemory(vk_dev->act_dev, src_img, src_mem[0], 0) !=
+        VK_SUCCESS) {
+      CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+      return false;
+    }
+  } else {
+    static constexpr VkImageAspectFlagBits plane_aspects[2] = {
+        VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT,
+        VK_IMAGE_ASPECT_MEMORY_PLANE_1_BIT_EXT,
+    };
+    for (int i = 0; i < 2; ++i) {
+      VkImagePlaneMemoryRequirementsInfo plane_req{
+          .sType = VK_STRUCTURE_TYPE_IMAGE_PLANE_MEMORY_REQUIREMENTS_INFO,
+          .planeAspect = plane_aspects[i],
+      };
+      VkImageMemoryRequirementsInfo2 req_info{
+          .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+          .pNext = &plane_req,
+          .image = src_img,
+      };
+      VkMemoryRequirements2 req2{
+          .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+      };
+      p.vkGetImageMemoryRequirements2(vk_dev->act_dev, &req_info, &req2);
+
+      const int64_t dmabuf_size = GetDmabufSize(handle.planes[i].fd.get());
+      if (i == 0) {
+        logged_dmabuf_size = dmabuf_size;
+        logged_req_size = req2.memoryRequirements.size;
+      }
+      if (dmabuf_size <= 0 ||
+          static_cast<uint64_t>(dmabuf_size) < req2.memoryRequirements.size) {
+        static bool logged_disjoint_size = false;
+        if (!logged_disjoint_size) {
+          logged_disjoint_size = true;
+          VLOG(1) << "CopyDmabufToVkFrame: disjoint dmabuf size mismatch plane="
+                  << i << " dmabuf_size=" << dmabuf_size
+                  << " req.size=" << req2.memoryRequirements.size
+                  << " mod=0x" << std::hex << handle.modifier << std::dec;
+        }
+        CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+        return false;
+      }
+
+      VkMemoryFdPropertiesKHR fd_props{
+          .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+      };
+      if (p.vkGetMemoryFdPropertiesKHR(
+              vk_dev->act_dev, VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+              handle.planes[i].fd.get(), &fd_props) != VK_SUCCESS) {
+        CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+        return false;
+      }
+
+      uint32_t mem_idx = FindMemoryType(
+          info.mem_props,
+          req2.memoryRequirements.memoryTypeBits & fd_props.memoryTypeBits);
+      if (mem_idx == UINT32_MAX) {
+        CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+        return false;
+      }
+
+      int import_fd = HANDLE_EINTR(dup(handle.planes[i].fd.get()));
+      if (import_fd < 0) {
+        CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+        return false;
+      }
+
+      VkImportMemoryFdInfoKHR imp{
+          .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+          .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+          .fd = import_fd,
+      };
+      VkMemoryAllocateInfo mai{
+          .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+          .pNext = &imp,
+          .allocationSize = req2.memoryRequirements.size,
+          .memoryTypeIndex = mem_idx,
+      };
+      if (p.vkAllocateMemory(vk_dev->act_dev, &mai, nullptr, &src_mem[i]) !=
+          VK_SUCCESS) {
+        IGNORE_EINTR(close(import_fd));
+        CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+        return false;
+      }
+    }
+
+    VkBindImagePlaneMemoryInfo bind_planes[2] = {
+        {.sType = VK_STRUCTURE_TYPE_BIND_IMAGE_PLANE_MEMORY_INFO,
+         .planeAspect = plane_aspects[0]},
+        {.sType = VK_STRUCTURE_TYPE_BIND_IMAGE_PLANE_MEMORY_INFO,
+         .planeAspect = plane_aspects[1]},
+    };
+    VkBindImageMemoryInfo bind_infos[2] = {
+        {.sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO,
+         .pNext = &bind_planes[0],
+         .image = src_img,
+         .memory = src_mem[0],
+         .memoryOffset = 0},
+        {.sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO,
+         .pNext = &bind_planes[1],
+         .image = src_img,
+         .memory = src_mem[1],
+         .memoryOffset = 0},
+    };
+    if (p.vkBindImageMemory2(vk_dev->act_dev, 2, bind_infos) != VK_SUCCESS) {
+      CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+      return false;
+    }
+  }
+
+  if (p.vkResetCommandPool(vk_dev->act_dev, cmd_pool, 0) != VK_SUCCESS ||
+      p.vkResetFences(vk_dev->act_dev, 1, &fence) != VK_SUCCESS) {
+    CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+    return false;
+  }
+
+  VkCommandBufferBeginInfo cbbi{
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+  };
+  if (p.vkBeginCommandBuffer(cb, &cbbi) != VK_SUCCESS) {
+    CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+    return false;
+  }
+
+  const bool two_dst_imgs = (dst_vk->img[1] != VK_NULL_HANDLE);
+  VkSemaphore sems[2] = {};
+  uint64_t wait_vals[2] = {};
+  uint64_t sig_vals[2] = {};
+  VkPipelineStageFlags wait_stages[2] = {
+      VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,
+  };
+  uint32_t sem_count = 0;
+  if (dst_vk->sem[0] != VK_NULL_HANDLE) {
+    sems[sem_count] = dst_vk->sem[0];
+    wait_vals[sem_count] = dst_vk->sem_value[0];
+    sig_vals[sem_count] = dst_vk->sem_value[0] + 1;
+    ++sem_count;
+  }
+  if (two_dst_imgs && dst_vk->sem[1] != VK_NULL_HANDLE &&
+      dst_vk->sem[1] != dst_vk->sem[0]) {
+    sems[sem_count] = dst_vk->sem[1];
+    wait_vals[sem_count] = dst_vk->sem_value[1];
+    sig_vals[sem_count] = dst_vk->sem_value[1] + 1;
+    ++sem_count;
+  }
+  const VkPipelineStageFlags pre_src_stage =
+      (sem_count > 0) ? VK_PIPELINE_STAGE_TRANSFER_BIT
+                      : VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+  const VkAccessFlags dst_src_access =
+      (sem_count > 0) ? 0u : VK_ACCESS_MEMORY_READ_BIT;
+
+  const VkImageAspectFlags src_aspect_barrier =
+      disjoint ? (VK_IMAGE_ASPECT_PLANE_0_BIT | VK_IMAGE_ASPECT_PLANE_1_BIT)
+               : VK_IMAGE_ASPECT_COLOR_BIT;
+  const VkImageAspectFlags dst_aspect0 = VK_IMAGE_ASPECT_COLOR_BIT;
+  VkImageMemoryBarrier pre[3]{
+      {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+       .srcAccessMask = (sem_count > 0) ? 0u : VK_ACCESS_MEMORY_WRITE_BIT,
+       .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+       .oldLayout = VK_IMAGE_LAYOUT_GENERAL,
+       .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+       .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .image = src_img,
+       .subresourceRange = {src_aspect_barrier, 0, 1, 0, 1}},
+      {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+       .srcAccessMask = dst_src_access,
+       .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+       .oldLayout = dst_vk->layout[0],
+       .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+       .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+       .image = dst_vk->img[0],
+       .subresourceRange = {dst_aspect0, 0, 1, 0, 1}},
+      {},
+  };
+  uint32_t pre_count = 2;
+  if (two_dst_imgs) {
+    pre[2] = {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+              .srcAccessMask = dst_src_access,
+              .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+              .oldLayout = dst_vk->layout[1],
+              .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+              .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+              .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+              .image = dst_vk->img[1],
+              .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+    pre_count = 3;
+  }
+  p.vkCmdPipelineBarrier(cb, pre_src_stage, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+                         0, nullptr, 0, nullptr, pre_count, pre);
+
+  const int vis_x = std::max(0, visible_rect.x()) & ~1;
+  const int vis_y = std::max(0, visible_rect.y()) & ~1;
+  const int vis_w =
+      visible_rect.IsEmpty() ? coded_size.width() : visible_rect.width();
+  const int vis_h =
+      visible_rect.IsEmpty() ? coded_size.height() : visible_rect.height();
+  const uint32_t copy_w = static_cast<uint32_t>(
+      std::min({vis_w, enc_w, std::max(0, coded_size.width() - vis_x)}));
+  const uint32_t copy_h = static_cast<uint32_t>(
+      std::min({vis_h, enc_h, std::max(0, coded_size.height() - vis_y)}));
+  if (copy_w == 0 || copy_h == 0) {
+    CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+    return false;
+  }
+
+  const uint32_t plane_widths[2] = {copy_w, (copy_w + 1) / 2};
+  const uint32_t plane_heights[2] = {copy_h, (copy_h + 1) / 2};
+  const int32_t src_off_x[2] = {vis_x, vis_x / 2};
+  const int32_t src_off_y[2] = {vis_y, vis_y / 2};
+
+  for (int i = 0; i < 2; ++i) {
+    VkImage dst_img = two_dst_imgs ? dst_vk->img[i] : dst_vk->img[0];
+    VkImageAspectFlags src_plane_aspect =
+        (i == 0) ? VK_IMAGE_ASPECT_PLANE_0_BIT : VK_IMAGE_ASPECT_PLANE_1_BIT;
+    VkImageAspectFlags dst_plane_aspect =
+        two_dst_imgs
+            ? VK_IMAGE_ASPECT_COLOR_BIT
+            : (i == 0 ? VK_IMAGE_ASPECT_PLANE_0_BIT
+                      : VK_IMAGE_ASPECT_PLANE_1_BIT);
+    VkImageCopy region{
+        .srcSubresource = {src_plane_aspect, 0, 0, 1},
+        .srcOffset = {src_off_x[i], src_off_y[i], 0},
+        .dstSubresource = {dst_plane_aspect, 0, 0, 1},
+        .dstOffset = {0, 0, 0},
+        .extent = {plane_widths[i], plane_heights[i], 1},
+    };
+    p.vkCmdCopyImage(cb, src_img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                     dst_img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+  }
+
+  if (p.vkEndCommandBuffer(cb) != VK_SUCCESS) {
+    CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+    return false;
+  }
+
+  const uint32_t qf = info.copy_queue_family;
+  VkQueue queue = VK_NULL_HANDLE;
+  p.vkGetDeviceQueue(vk_dev->act_dev, qf, 0, &queue);
+  VkTimelineSemaphoreSubmitInfo tl_info{
+      .sType = VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO,
+      .waitSemaphoreValueCount = sem_count,
+      .pWaitSemaphoreValues = wait_vals,
+      .signalSemaphoreValueCount = sem_count,
+      .pSignalSemaphoreValues = sig_vals,
+  };
+  VkSubmitInfo si{
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .pNext = sem_count > 0 ? &tl_info : nullptr,
+      .waitSemaphoreCount = sem_count,
+      .pWaitSemaphores = sem_count > 0 ? sems : nullptr,
+      .pWaitDstStageMask = sem_count > 0 ? wait_stages : nullptr,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cb,
+      .signalSemaphoreCount = sem_count,
+      .pSignalSemaphores = sem_count > 0 ? sems : nullptr,
+  };
+  if (vk_dev->lock_queue) {
+    vk_dev->lock_queue(frames_ctx->device_ctx, qf, 0);
+  }
+  VkResult sr = p.vkQueueSubmit(queue, 1, &si, fence);
+  if (vk_dev->unlock_queue) {
+    vk_dev->unlock_queue(frames_ctx->device_ctx, qf, 0);
+  }
+
+  const VkImageLayout orig_dst_layout = dst_vk->layout[0];
+  const uint32_t orig_dst_qf = dst_vk->queue_family[0];
+  if (sr == VK_SUCCESS) {
+    dst_vk->layout[0] = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    dst_vk->access[0] = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    if (dst_vk->queue_family[0] != VK_QUEUE_FAMILY_IGNORED) {
+      dst_vk->queue_family[0] = qf;
+    }
+    if (two_dst_imgs) {
+      dst_vk->layout[1] = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+      dst_vk->access[1] = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+      if (dst_vk->queue_family[1] != VK_QUEUE_FAMILY_IGNORED) {
+        dst_vk->queue_family[1] = qf;
+      }
+    }
+    if (dst_vk->sem[0] != VK_NULL_HANDLE) {
+      dst_vk->sem_value[0] += 1;
+    }
+    if (two_dst_imgs && dst_vk->sem[1] != VK_NULL_HANDLE &&
+        dst_vk->sem[1] != dst_vk->sem[0]) {
+      dst_vk->sem_value[1] += 1;
+    }
+  }
+
+  static bool logged_diag = false;
+  if (!logged_diag) {
+    logged_diag = true;
+    VLOG(1) << "CopyDmabufToVkFrame diag: coded=" << coded_size.ToString()
+            << " vis=" << visible_rect.ToString() << " enc=" << enc_w << "x"
+            << enc_h << " mod=0x" << std::hex << handle.modifier << std::dec
+            << " same_dmabuf=" << same_dmabuf
+            << " p0=(" << handle.planes[0].stride << ","
+            << handle.planes[0].offset << "," << handle.planes[0].size << ")"
+            << " p1=(" << handle.planes[1].stride << ","
+            << handle.planes[1].offset << "," << handle.planes[1].size << ")"
+            << " dmabuf_size=" << logged_dmabuf_size
+            << " req_size=" << logged_req_size
+            << " two_dst=" << two_dst_imgs
+            << " orig_dst_layout=" << orig_dst_layout
+            << " orig_dst_qf=" << orig_dst_qf
+            << " sr=" << sr;
+  }
+
+  if (sr != VK_SUCCESS) {
+    CleanupDmabufImport(vk_dev->act_dev, p, &src_img, src_mem);
+    return false;
+  }
+
+  *out_src_img = src_img;
+  out_src_mem[0] = src_mem[0];
+  out_src_mem[1] = src_mem[1];
+  return true;
+}
+
+constexpr size_t kEncodeCopyRingSize = 4;
+
+struct EncodeCopySlot {
+  VkCommandPool cmd_pool = VK_NULL_HANDLE;
+  VkCommandBuffer cmd_buf = VK_NULL_HANDLE;
+  VkFence fence = VK_NULL_HANDLE;
+  VkImage src_img = VK_NULL_HANDLE;
+  VkDeviceMemory src_mem[2] = {VK_NULL_HANDLE, VK_NULL_HANDLE};
+  scoped_refptr<VideoFrame> input_frame;
+  bool in_flight = false;
+};
+
+bool ReapEncodeCopySlot(AVVulkanDeviceContext* vk_dev,
+                        const VkCopyProcs& p,
+                        EncodeCopySlot& slot,
+                        bool wait) {
+  if (!slot.in_flight) {
+    return true;
+  }
+  if (!wait && GetFenceStatus(vk_dev, p, slot.fence) == VK_NOT_READY) {
+    return false;
+  }
+  if (wait) {
+    WaitForFence(vk_dev, p, slot.fence, 1000000000ULL);
+  }
+  CleanupDmabufImport(vk_dev->act_dev, p, &slot.src_img, slot.src_mem);
+  slot.input_frame.reset();
+  slot.in_flight = false;
+  return true;
+}
+
+}  // namespace
+
+struct VulkanEncodeCopyState {
+  std::array<EncodeCopySlot, kEncodeCopyRingSize> slots;
+  size_t next_slot = 0;
+};
