+// found in the LICENSE file.
+
+#include "media/gpu/vulkan/vulkan_video_encode_accelerator.h"
+
+#include <algorithm>
+#include <cstring>
+#include <utility>
+
+#include "base/logging.h"
+#include "base/numerics/safe_conversions.h"
+#include "media/base/media_log.h"
+#include "media/base/video_frame.h"
+#include "media/ffmpeg/ffmpeg_common.h"
+#include "media/video/video_encoder_info.h"
+#include "third_party/libyuv/include/libyuv/convert.h"
+#include "third_party/libyuv/include/libyuv/planar_functions.h"
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/opt.h>
+#include <libavutil/pixfmt.h>
+}
+
+namespace media {
+
+namespace {
+
+constexpr uint32_t kDefaultFramerate = 30;
+constexpr uint32_t kDefaultGopLength = 60;
+constexpr size_t kMinOutputBufferSize = 1024 * 1024;
+
+const char* EncoderNameForProfile(VideoCodecProfile profile) {
+  if (profile >= H264PROFILE_MIN && profile <= H264PROFILE_MAX) {
+    return "h264_vulkan";
+  }
+  if (profile >= HEVCPROFILE_MIN && profile <= HEVCPROFILE_MAX) {
+    return "hevc_vulkan";
+  }
+  return nullptr;
+}
+
+int AVProfileForVideoCodecProfile(VideoCodecProfile profile) {
+  switch (profile) {
+    case H264PROFILE_BASELINE:
+      return AV_PROFILE_H264_BASELINE;
+    case H264PROFILE_MAIN:
+      return AV_PROFILE_H264_MAIN;
+    case H264PROFILE_HIGH:
+      return AV_PROFILE_H264_HIGH;
+    case HEVCPROFILE_MAIN:
+      return AV_PROFILE_HEVC_MAIN;
+    default:
+      return AV_PROFILE_UNKNOWN;
+  }
+}
+
+bool CanCreateVulkanEncoderDevice() {
+  static const bool supported = []() {
+    if (!avcodec_find_encoder_by_name("h264_vulkan") &&
+        !avcodec_find_encoder_by_name("hevc_vulkan")) {
+      return false;
+    }
+    AVBufferRef* dev = nullptr;
+    int err = av_hwdevice_ctx_create(&dev, AV_HWDEVICE_TYPE_VULKAN, nullptr,
+                                     nullptr, 0);
+    if (err < 0 || !dev) {
+      return false;
+    }
+    av_buffer_unref(&dev);
+    return true;
+  }();
+  return supported;
+}
+
+}  // namespace
+
+VulkanVideoEncodeAccelerator::OutputBuffer::OutputBuffer(
+    int32_t id,
+    base::WritableSharedMemoryMapping mapping,
+    size_t size)
+    : id(id), mapping(std::move(mapping)), size(size) {}
+
+VulkanVideoEncodeAccelerator::OutputBuffer::OutputBuffer(OutputBuffer&&) =
+    default;
+
+VulkanVideoEncodeAccelerator::OutputBuffer&
+VulkanVideoEncodeAccelerator::OutputBuffer::operator=(OutputBuffer&&) = default;
+
+VulkanVideoEncodeAccelerator::OutputBuffer::~OutputBuffer() = default;
+
+VulkanVideoEncodeAccelerator::PendingOutput::PendingOutput() = default;
+VulkanVideoEncodeAccelerator::PendingOutput::PendingOutput(PendingOutput&&) =
+    default;
+VulkanVideoEncodeAccelerator::PendingOutput&
+VulkanVideoEncodeAccelerator::PendingOutput::operator=(PendingOutput&&) =
+    default;
+VulkanVideoEncodeAccelerator::PendingOutput::~PendingOutput() = default;
+
+VulkanVideoEncodeAccelerator::VulkanVideoEncodeAccelerator() = default;
+
+VulkanVideoEncodeAccelerator::~VulkanVideoEncodeAccelerator() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ReleaseResources();
+}
+
+VideoEncodeAccelerator::SupportedProfiles
+VulkanVideoEncodeAccelerator::GetSupportedProfiles() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  SupportedProfiles profiles;
+  if (!CanCreateVulkanEncoderDevice()) {
+    return profiles;
+  }
+
+  const auto add_profile = [&](VideoCodecProfile codec_profile,
+                               const gfx::Size& max_res) {
+    SupportedProfile p;
+    p.profile = codec_profile;
+    p.min_resolution = gfx::Size(64, 64);
+    p.max_resolution = max_res;
+    p.max_framerate_numerator = 60;
+    p.max_framerate_denominator = 1;
+    p.rate_control_modes =
+        VideoEncodeAccelerator::kConstantMode |
+        VideoEncodeAccelerator::kVariableMode;
+    p.is_software_codec = false;
+    profiles.push_back(p);
+  };
+
+  if (avcodec_find_encoder_by_name("h264_vulkan")) {
+    add_profile(H264PROFILE_BASELINE, gfx::Size(4096, 4096));
+    add_profile(H264PROFILE_MAIN, gfx::Size(4096, 4096));
+    add_profile(H264PROFILE_HIGH, gfx::Size(4096, 4096));
+  }
+  if (avcodec_find_encoder_by_name("hevc_vulkan")) {
+    add_profile(HEVCPROFILE_MAIN, gfx::Size(8192, 8192));
+  }
+
+  return profiles;
+}
+
+EncoderStatus VulkanVideoEncodeAccelerator::Initialize(
+    const Config& config,
+    Client* client,
+    std::unique_ptr<MediaLog> media_log) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  client_ = client;
+  media_log_ = std::move(media_log);
+
+  if (!client_) {
+    return EncoderStatus::Codes::kEncoderInitializationError;
+  }
+
+  if (config.input_format != PIXEL_FORMAT_NV12 &&
+      config.input_format != PIXEL_FORMAT_I420) {
+    return {EncoderStatus::Codes::kUnsupportedFrameFormat,
+            "VulkanVideoEncodeAccelerator only supports NV12 and I420 inputs"};
+  }
+
+  if (!EncoderNameForProfile(config.output_profile)) {
+    return {EncoderStatus::Codes::kEncoderUnsupportedProfile,
+            "Unsupported Vulkan encode profile"};
+  }
+
+  if (!ConfigureEncoder(config)) {
+    ReleaseResources();
+    return EncoderStatus::Codes::kEncoderInitializationError;
+  }
+
+  input_visible_size_ = config.input_visible_size;
+  output_buffer_size_ =
+      std::max<size_t>(kMinOutputBufferSize, input_visible_size_.GetArea() * 2);
+  initialized_ = true;
+  has_error_ = false;
+
+  VideoEncoderInfo info;
+  info.implementation_name = "VulkanVideoEncodeAccelerator";
+  info.is_hardware_accelerated = true;
+  info.supports_native_handle = false;
+  info.supports_frame_size_change = false;
+  client_->NotifyEncoderInfoChange(info);
+
+  client_->RequireBitstreamBuffers(/*input_count=*/2, input_visible_size_,
+                                   output_buffer_size_);
+  return EncoderStatus::Codes::kOk;
+}
+
+bool VulkanVideoEncodeAccelerator::ConfigureEncoder(const Config& config) {
+  ReleaseResources();
+
+  const char* encoder_name = EncoderNameForProfile(config.output_profile);
+  const AVCodec* codec =
+      encoder_name ? avcodec_find_encoder_by_name(encoder_name) : nullptr;
+  if (!codec) {
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: encoder not found";
+    return false;
+  }
+
+  AVBufferRef* dev = nullptr;
+  int err = av_hwdevice_ctx_create(&dev, AV_HWDEVICE_TYPE_VULKAN, nullptr,
+                                   nullptr, 0);
+  if (err < 0 || !dev) {
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: av_hwdevice_ctx_create failed: "
+               << AVErrorToString(err);
+    return false;
+  }
+  hw_device_ctx_ = dev;
+
+  AVBufferRef* frames_ref = av_hwframe_ctx_alloc(hw_device_ctx_);
+  if (!frames_ref) {
+    return false;
+  }
+  auto* frames_ctx = reinterpret_cast<AVHWFramesContext*>(frames_ref->data);
+  frames_ctx->format = AV_PIX_FMT_VULKAN;
+  frames_ctx->sw_format = AV_PIX_FMT_NV12;
+  frames_ctx->width = std::max(64, config.input_visible_size.width());
+  frames_ctx->height = std::max(64, config.input_visible_size.height());
+  frames_ctx->initial_pool_size = 4;
+
+  err = av_hwframe_ctx_init(frames_ref);
+  if (err < 0) {
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: av_hwframe_ctx_init failed: "
+               << AVErrorToString(err);
+    av_buffer_unref(&frames_ref);
+    return false;
+  }
+  hw_frames_ctx_ = frames_ref;
+
+  codec_context_.reset(avcodec_alloc_context3(codec));
+  if (!codec_context_) {
+    return false;
+  }
+
+  uint32_t fps = config.framerate > 0 ? config.framerate : kDefaultFramerate;
+  codec_context_->width = config.input_visible_size.width();
+  codec_context_->height = config.input_visible_size.height();
+  codec_context_->time_base = AVRational{1, 1000000};
+  codec_context_->framerate = AVRational{static_cast<int>(fps), 1};
+  codec_context_->pix_fmt = AV_PIX_FMT_VULKAN;
+  codec_context_->hw_device_ctx = av_buffer_ref(hw_device_ctx_);
+  codec_context_->hw_frames_ctx = av_buffer_ref(hw_frames_ctx_);
+  codec_context_->gop_size = config.gop_length.value_or(kDefaultGopLength);
+  codec_context_->max_b_frames = 0;
+
+  int profile = AVProfileForVideoCodecProfile(config.output_profile);
+  if (profile != AV_PROFILE_UNKNOWN) {
+    codec_context_->profile = profile;
+  }
+
+  int64_t target_bps = config.bitrate.target_bps();
+  if (target_bps <= 0) {
+    target_bps = 2000000;
+  }
+  codec_context_->bit_rate = target_bps;
+  if (config.bitrate.mode() == Bitrate::Mode::kConstant) {
+    codec_context_->rc_min_rate = target_bps;
+    codec_context_->rc_max_rate = target_bps;
+    codec_context_->rc_buffer_size = static_cast<int>(target_bps);
+  } else if (config.bitrate.peak_bps() > 0) {
+    codec_context_->rc_max_rate = config.bitrate.peak_bps();
+  }
+
+  err = avcodec_open2(codec_context_.get(), codec, nullptr);
+  if (err < 0) {
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: avcodec_open2 failed for "
+               << encoder_name << ": " << AVErrorToString(err);
+    return false;
+  }
+
+  LOG(WARNING) << "VulkanVideoEncodeAccelerator: initialized " << encoder_name
+               << " (" << codec_context_->width << "x"
+               << codec_context_->height << ")";
+  return true;
+}
+
+void VulkanVideoEncodeAccelerator::Encode(scoped_refptr<VideoFrame> frame,
+                                          bool force_keyframe) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!initialized_ || has_error_ || !codec_context_ || !hw_frames_ctx_) {
+    return;
+  }
+
+  if (!frame || !frame->visible_data(VideoFrame::Plane::kY)) {
+    has_error_ = true;
+    client_->NotifyErrorStatus(
+        {EncoderStatus::Codes::kUnsupportedFrameFormat,
+         "VulkanVideoEncodeAccelerator requires mappable VideoFrame"});
+    return;
+  }
+
+  AVFrame* sw_frame = av_frame_alloc();
+  AVFrame* hw_frame = av_frame_alloc();
+  if (!sw_frame || !hw_frame) {
+    av_frame_free(&sw_frame);
+    av_frame_free(&hw_frame);
+    has_error_ = true;
+    client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+    return;
+  }
+
+  sw_frame->format = AV_PIX_FMT_NV12;
+  sw_frame->width = codec_context_->width;
+  sw_frame->height = codec_context_->height;
+  int err = av_frame_get_buffer(sw_frame, 32);
+  if (err < 0) {
+    av_frame_free(&sw_frame);
+    av_frame_free(&hw_frame);
+    has_error_ = true;
+    client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+    return;
+  }
+
+  if (frame->format() == PIXEL_FORMAT_NV12) {
+    libyuv::NV12Copy(
+        frame->visible_data(VideoFrame::Plane::kY),
+        frame->stride(VideoFrame::Plane::kY),
+        frame->visible_data(VideoFrame::Plane::kUV),
+        frame->stride(VideoFrame::Plane::kUV),
+        sw_frame->data[0], sw_frame->linesize[0],
+        sw_frame->data[1], sw_frame->linesize[1],
+        codec_context_->width, codec_context_->height);
+  } else if (frame->format() == PIXEL_FORMAT_I420) {
+    libyuv::I420ToNV12(
+        frame->visible_data(VideoFrame::Plane::kY),
+        frame->stride(VideoFrame::Plane::kY),
+        frame->visible_data(VideoFrame::Plane::kU),
+        frame->stride(VideoFrame::Plane::kU),
+        frame->visible_data(VideoFrame::Plane::kV),
+        frame->stride(VideoFrame::Plane::kV),
+        sw_frame->data[0], sw_frame->linesize[0],
+        sw_frame->data[1], sw_frame->linesize[1],
+        codec_context_->width, codec_context_->height);
+  } else {
+    av_frame_free(&sw_frame);
+    av_frame_free(&hw_frame);
+    has_error_ = true;
+    client_->NotifyErrorStatus(EncoderStatus::Codes::kUnsupportedFrameFormat);
+    return;
+  }
+
+  err = av_hwframe_get_buffer(hw_frames_ctx_, hw_frame, 0);
+  if (err >= 0) {
+    err = av_hwframe_transfer_data(hw_frame, sw_frame, 0);
+  }
+  av_frame_free(&sw_frame);
+
+  if (err < 0) {
+    av_frame_free(&hw_frame);
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: hwframe upload failed: "
+               << AVErrorToString(err);
+    has_error_ = true;
+    client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+    return;
+  }
+
+  hw_frame->pts = frame->timestamp().InMicroseconds();
+  if (force_keyframe) {
+    hw_frame->pict_type = AV_PICTURE_TYPE_I;
+  }
+  pending_timestamps_.push_back(frame->timestamp());
+
+  err = avcodec_send_frame(codec_context_.get(), hw_frame);
+  av_frame_free(&hw_frame);
+
+  if (err < 0) {
+    LOG(ERROR) << "VulkanVideoEncodeAccelerator: avcodec_send_frame failed: "
+               << AVErrorToString(err);
+    has_error_ = true;
+    client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+    return;
+  }
+
+  DrainPackets();
+  DrainOutputs();
+}
+
+void VulkanVideoEncodeAccelerator::DrainPackets() {
+  AVPacket* pkt = av_packet_alloc();
+  if (!pkt) {
+    return;
+  }
+
+  while (true) {
+    int err = avcodec_receive_packet(codec_context_.get(), pkt);
+    if (err == AVERROR(EAGAIN) || err == AVERROR_EOF) {
+      break;
+    }
+    if (err < 0) {
+      LOG(ERROR)
+          << "VulkanVideoEncodeAccelerator: avcodec_receive_packet failed: "
+          << AVErrorToString(err);
+      has_error_ = true;
+      client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+      break;
+    }
+
+    PendingOutput out;
+    out.data.assign(pkt->data, pkt->data + pkt->size);
+    out.key_frame = (pkt->flags & AV_PKT_FLAG_KEY) != 0;
+    if (!pending_timestamps_.empty()) {
+      out.timestamp = pending_timestamps_.front();
+      pending_timestamps_.pop_front();
+    } else {
+      out.timestamp = base::Microseconds(pkt->pts);
+    }
+    pending_outputs_.push_back(std::move(out));
+    av_packet_unref(pkt);
+  }
+
+  av_packet_free(&pkt);
+}
+
+void VulkanVideoEncodeAccelerator::UseOutputBitstreamBuffer(
+    BitstreamBuffer buffer) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (has_error_) {
+    return;
+  }
+
+  base::UnsafeSharedMemoryRegion region = buffer.TakeRegion();
+  base::WritableSharedMemoryMapping mapping =
+      region.MapAt(buffer.offset(), buffer.size());
+  if (!mapping.IsValid()) {
+    has_error_ = true;
+    client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+    return;
+  }
+
+  available_bitstream_buffers_.emplace_back(buffer.id(), std::move(mapping),
+                                            buffer.size());
+  DrainOutputs();
+}
+
+void VulkanVideoEncodeAccelerator::DrainOutputs() {
+  while (!pending_outputs_.empty() && !available_bitstream_buffers_.empty()) {
+    PendingOutput out = std::move(pending_outputs_.front());
+    pending_outputs_.pop_front();
+
+    OutputBuffer dst = std::move(available_bitstream_buffers_.front());
+    available_bitstream_buffers_.pop_front();
+
+    if (out.data.size() > dst.size) {
+      LOG(ERROR) << "VulkanVideoEncodeAccelerator: encoded packet ("
+                 << out.data.size() << ") exceeds bitstream buffer ("
+                 << dst.size << ")";
+      has_error_ = true;
+      client_->NotifyErrorStatus(EncoderStatus::Codes::kEncoderFailedEncode);
+      return;
+    }
+
+    std::memcpy(dst.mapping.memory(), out.data.data(), out.data.size());
+    BitstreamBufferMetadata metadata(out.data.size(), out.key_frame,
+                                     out.timestamp);
+    client_->BitstreamBufferReady(dst.id, metadata);
+  }
+}
+
+void VulkanVideoEncodeAccelerator::RequestEncodingParametersChange(
+    const Bitrate& bitrate,
+    uint32_t framerate,
+    const std::optional<gfx::Size>& size) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!codec_context_) {
+    return;
+  }
+  if (bitrate.target_bps() > 0) {
+    codec_context_->bit_rate = bitrate.target_bps();
+  }
+  if (framerate > 0) {
+    codec_context_->framerate =
+        AVRational{static_cast<int>(framerate), 1};
+  }
+}
+
+void VulkanVideoEncodeAccelerator::Flush(FlushCallback flush_callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!initialized_ || has_error_ || !codec_context_) {
+    std::move(flush_callback).Run(false);
+    return;
+  }
+
+  int err = avcodec_send_frame(codec_context_.get(), nullptr);
+  if (err < 0 && err != AVERROR_EOF) {
+    std::move(flush_callback).Run(false);
+    return;
+  }
+  DrainPackets();
+  DrainOutputs();
+  std::move(flush_callback).Run(!has_error_);
+}
+
+bool VulkanVideoEncodeAccelerator::IsFlushSupported() {
+  return true;
+}
+
+void VulkanVideoEncodeAccelerator::Destroy() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ReleaseResources();
+  delete this;
+}
+
+void VulkanVideoEncodeAccelerator::ReleaseResources() {
+  codec_context_.reset();
+  if (hw_frames_ctx_) {
+    AVBufferRef* ref = hw_frames_ctx_.get();
+    hw_frames_ctx_ = nullptr;
+    av_buffer_unref(&ref);
+  }
+  if (hw_device_ctx_) {
+    AVBufferRef* ref = hw_device_ctx_.get();
+    hw_device_ctx_ = nullptr;
+    av_buffer_unref(&ref);
+  }
+  available_bitstream_buffers_.clear();
+  pending_outputs_.clear();
+  pending_timestamps_.clear();
+  initialized_ = false;
+}
+
+}  // namespace media
